rnival\",\"shareBadgeLabel\":\"Pitch Carnival\",\"bannerLabel\":\"Pitch Carnival\",\"startTime\":\"2026-06-10T00:00:00Z\",\"endTime\":\"2026-07-20T23:59:59Z\",\"submissionStart\":\"2026-06-10T00:00:00Z\",\"submissionEnd\":\"2026-07-19T23:59:59Z\",\"generationChallengeImage\":\"https://cdn.meshy.ai/webapp-assets/community/generation-challenge/260610-PitchCarnival/icon-soccer-cup.webp\",\"coverImage\":\"https://cdn.meshy.ai/webapp-assets/community/generation-challenge/260610-PitchCarnival/tooltip-banner-stage2-bg.webp\",\"spotlightBg\":\"https://cdn.meshy.ai/webapp-assets/community/generation-challenge/260610-PitchCarnival/tooltip-banner-stage2-bg.webp\",\"content\":\"\",\"eventUrl\":\"/events/pitch-carnival\",\"entryDot\":true,\"enabledIn\":[\"panel-banner\",\"dashboard\",\"community-publish\"],\"stages\":[{\"title\":\"Stage 1: Nation's Pride\",\"description\":\"Design a landmark, famous dish, or cultural symbol that represents a country at the tournament. Show us the icons that define a nation.\",\"start\":\"2026-06-10T00:00:00Z\",\"end\":\"2026-06-27T00:00:00Z\",\"endFormatted\":\"Jun 26, 23:59 UTC\",\"bannerImage\":\"https://cdn.meshy.ai/webapp-assets/community/generation-challenge/260610-PitchCarnival/tooltip-banner-stage1-2.webp\"},{\"title\":\"Stage 2: Team Mascot\",\"description\":\"Design a mythical creature or fantasy mascot for the team you support. Let it embody their fighting spirit and culture.\",\"start\":\"2026-06-27T00:00:00Z\",\"end\":\"2026-07-05T00:00:00Z\",\"endFormatted\":\"Jul 4, 23:59 UTC\",\"bannerImage\":\"https://cdn.meshy.ai/webapp-assets/community/generation-challenge/260610-PitchCarnival/tooltip-banner-stage2-2.webp\"},{\"title\":\"Stage 3: Festive Props\",\"description\":\"Design a cheer prop you'd use at the biggest celebration of the year. Bouquets, glowing horns, cheering sticks — anything that fuels the hype.\",\"start\":\"2026-07-05T00:00:00Z\",\"end\":\"2026-07-13T00:00:00Z\",\"endFormatted\":\"Jul 12, 23:59 UTC\",\"bannerImage\":\