\":\"Poor 3D model quality\",\"ReportInappropriate\":\"Report inappropriate content\",\"TooManyCredits\":\"Too many credits used\"},\"CommentPlaceholder\":\"Tell us more (optional)\",\"Down\":\"Not helpful\",\"Edit\":\"Edit\",\"Error\":\"Something went wrong. Please try again.\",\"FormTitle\":\"What went wrong?\",\"SelectAllHint\":\"Select all that apply\",\"Skip\":\"Skip\",\"Submit\":\"Submit\",\"Thanks\":\"Thanks for your feedback\",\"Up\":\"Helpful\"},\"ModelPreviewDialog\":{\"Close\":\"Close\"},\"Project\":{\"Canvas\":{\"CreditCost\":{\"CreditsUnit\":\"{count} credits\",\"HeaderCost\":\"Cost\",\"HeaderType\":\"Tool type\",\"ImageTo3DNoTexture\":\"Image to 3D (without texture)\",\"ImageTo3DWithTexture\":\"Image to 3D (with texture)\",\"ImageToImage\":\"Image to Image\",\"PrintabilityRepair\":\"Printability Repair\",\"Retexture\":\"Retexture\",\"TextToImage\":\"Text to Image\",\"WebSearchImage\":\"Web Search Image\"},\"CreditCostDescription\":\"Each task's price is shown below. Agent may run one or more tasks per request.\",\"CreditCostTooltip\":\"Agent Credits Cost\",\"EmptyHelperText\":\"Describe your idea in the chat. Your 3D creation will appear here.\",\"QuickStartTitle\":\"Try these ideas...\",\"Usage\":{\"Description\":\"Track everything created and processed in this project.\",\"ImagesGenerated\":\"Images generated\",\"ModelsGenerated\":\"Models generated\",\"ModelsRefined\":\"Models edited\",\"PrintsPrepared\":\"Prints prepared\",\"Title\":\"Project Usage\"}},\"Card\":{\"Delete\":\"Delete\",\"Rename\":\"Rename\",\"Untitled\":\"Untitled\"},\"DeleteConfirm\":{\"Description\":\"All chats in this project will be permanently deleted. This cannot be undone.\",\"Title\":\"Delete project\"},\"Home\":{\"Composer\":{\"Placeholder\":\"Describe your idea, and start creating with agent.\",\"PreviewImageAriaLabel\":\"Preview image\",\"PromptRequired\":\"Please enter a prompt\",\"RemoveImageAriaLabel\":\"Remove image\",\"SendButtonLabel\":\"Send\",\"UploadButtonAriaLabel\":\"Upload image\"},\"HeadingPrefix\":\"Meshy can help you create\",\"HeadingWord1\":\"Miniatures\",\"HeadingWord2\":\"Figurines\",\"HeadingWord3\":\"Toys\",\"HeadingWord4\":\"3D Models\",\"MobileNotice\":\"Coming to mobile soon.\",\"MobileNoticeDesktop\":\"Try Agent on desktop.\",\"NewProject\":\"New Project\",\"ProjectsRemaining\":\"{count} projects left today\",\"QuickStart\":{\"Item1Name\":\"Create Collectible Print Parts\",\"Item1Prompt\":\"Select the most iconic items from this collection and generate 3D models for printing.\",\"Item2Name\":\"Turn a Drawing into 3D\",\"Item2Prompt\":\"Turn my son's little monster drawing into a cute 3D model and print it as a gift for him.\",\"Item3Name\":\"Create a Character Family\",\"Item3Prompt\":\"Create 6 variations of the same character family, same base robot design, different mushroom species and accessories, consistent style, consistent proportions, unified color palette.\",\"Item4Name\":\"See What Meshy Can Do\",\"Item4Prompt\":\"Hi Meshy, what can you do? Walk me through what you're good at.\",\"Title\":\"Quick Start\",\"TryExample\":\"Try example\"},\"RecentProjects\":\"Recents\",\"UpdatedAt\":\"Updated {date}\"},\"RenameDialog\":{\"InputPlaceholder\":\"Project name\",\"Title\":\"Rename project\"}},\"Share\":{\"CopyLink\":\"Copy link\",\"CreateFailed\":\"Couldn't generate share link\",\"Creating\":\"Generating link…\",\"DialogDescription\":\"Anyone with the link can view this conversation.\",\"DialogTitle\":\"Share Chat\",\"LinkCopied\":\"Link copied\",\"NotFound\":{\"BackToHome\":\"Go to Meshy Agent\",\"Description\":\"This shared conversation is unavailable or has been revoked.\",\"Title\":\"Share not found\"},\"PromoBanner\":\"Share your chat to show how ideas become 3D models. Help others learn, create, and explore what Meshy Agent can do.\",\"ReadOnlyHint\":\"Not available in shared view\",\"ShareButton\":\"Share Chat\",\"Sidebar\":{\"Description\":\"Describe what you want to create, and Meshy Agent will help generate, refine, and prepare your 3D models.\",\"Title1\":\"Start Creating with\",\"Title2\":\"3D Agent\",\"TryAgent\":\"Try Agent\"},\"StopSharing\":\"Stop sharing\",\"Stopped\":\"Sharing stopped\"}},\"App\":{\"AR\":{\"ARRequirements\":\"Requires iOS 12+ or Android 7+ with AR support\",\"ContinueWithoutAR\":\"Continue without AR\",\"DesktopHint\":\"AR is only available on iOS or Android. Open this page on your phone.\",\"ExpiresInOneDay\":\"Expires in 1 day\",\"HarmonyUnsupportedDescription\":\"Please open this AR link on an iOS or Android device instead.\",\"HarmonyUnsupportedLong\":\"AR preview is not yet supported on HarmonyOS. Please use an iOS or Android device.\",\"HarmonyUnsupportedTitle\":\"AR preview is not yet supported on HarmonyOS\",\"MetadataTitle\":\"View in AR | Meshy\",\"MobileHint\":\"Tap below to place this model in your room.\",\"ModelAlt\":\"3D model\",\"ModelUnavailable\":\"Model unavailable\",\"OpenInBrowserDescription\":\"AR isn't supported in this app. Please open this page in your browser to view in AR.\",\"OpenInBrowserTitle\":\"Open in your browser to use AR\",\"PreparingARLink\":\"Preparing AR link…\",\"PreviewButton\":\"AR Preview\",\"ReturnToDesktop\":\"Please return to your desktop and re-open this AR link.\",\"ScanToViewAR\":\"Scan to view in AR on your phone\",\"ViewInSpace\":\"View in your space\"},\"ClientError\":{\"Button\":\"Refresh\",\"Description\":\"Try refreshing this page, and if the issue persists, please report it so we can look into it promptly.\",\"ReportButton\":\"Report Issue\",\"ReportButtonShort\":\"Report\",\"ReportSuccess\":\"Thanks for reporting the issue, we will look into it promptly\",\"Title\":\"Oops, something went wrong.\"},\"CreativeLab\":{\"AssetPanel\":{\"AssetCreatedAgo\":\"Asset created {time}\",\"CardMenuLabel\":\"More actions\",\"CardMeta\":\"{product} · {time}\",\"CloseLabel\":\"Close\",\"DeleteConfirmConfirm\":\"Delete\",\"DeleteConfirmDescription\":\"This asset will be permanently removed.\",\"DeleteConfirmTitle\":\"Delete asset?\",\"DeleteFailed\":\"Couldn't delete this asset. Please try again.\",\"DeleteLabel\":\"Delete\",\"DemoBoyWithDogName\":\"Demo · Boy with Dog\",\"DemoDogName\":\"Demo · Dog\",\"DemoGirlName\":\"Demo · Girl\",\"DemoVinyl1Name\":\"Demo Vinyl · 1\",\"DemoVinyl2Name\":\"Demo Vinyl · 2\",\"EmptyCta\":\"Explore Creative Lab\",\"EmptyDescription\":\"Bring your ideas to life in Creative Lab — keychains, figurines, and more save here automatically.\",\"EmptyTitle\":\"No creations yet\",\"EntryButtonLabel\":\"Creative Lab Assets\",\"ErrorDescription\":\"Check your connection and try again.\",\"ErrorRetry\":\"Try again\",\"ErrorTitle\":\"Couldn't load your designs\",\"FilterAll\":\"All products\",\"Generating\":\"Generating…\",\"GroupCount\":\"{count, plural, =1 {1 asset} other {# assets}}\",\"HeroSection\":{\"Count\":\"{count, plural, =0 {} =1 {1 item} other {{count} items}}\",\"Title\":\"Creative Lab Assets\"},\"LoadingTitle\":\"Loading your designs…\",\"NewAssetTooltip\":\"{count, plural, =1 {+1 new design} other {+# new designs}}\",\"ResumeFailed\":\"Couldn't load this design. Please try again.\",\"ResumeLoading\":\"Loading design…\",\"ResumeUnsupported\":\"Switched to {productName}. Resume isn't available for this product yet — starting fresh.\",\"ResumeUnsupportedSameProduct\":\"Resume isn't available for this product yet.\",\"SortNewestFirst\":\"Newest first\",\"SortOldestFirst\":\"Oldest first\",\"TimeDaysAgo\":\"{count, plural, =1 {1d ago} other {#d ago}}\",\"TimeHoursAgo\":\"{count, plural, =1 {1h ago} other {#h ago}}\",\"TimeJustNow\":\"Just now\",\"TimeMinutesAgo\":\"{count, plural, =1 {1m ago} other {#m ago}}\",\"Title\":\"Creative Lab Assets\",\"ViewModeGrid\":\"Grid view\",\"ViewModeList\":\"List view\"},\"CheckoutRedirectDialog\":{\"Description\":\"We've opened the payment page in a new tab. Once you've completed payment, you can find your order in your orders list.\",\"StayHere\":\"Stay here\",\"Title\":\"Complete your payment in the new tab\",\"ViewOrders\":\"View my orders\"},\"DesignStage\":{\"Cancel\":\"Cancel\",\"ChangePhoto\":\"Change Photo\",\"Create3D\":\"Create 3D\",\"CreatingKeychain\":\"Creating your 3D keychain…\",\"DesignOption\":\"Design option {n}\",\"EmptyState\":\"Your badge designs will appear here\",\"FromPhoto\":\"From Photo\",\"FromText\":\"From Text\",\"GeneratingDesigns\":\"Generating keychain designs…\",\"Preview\":\"Preview\",\"Ready3D\":\"3D Ready\",\"Redesign\":\"Redesign\",\"UploadPhotoFirst\":\"Upload a photo first\",\"Uploading\":\"Uploading… {percent}%\",\"View3D\":\"View 3D\"},\"EggBuilder\":{\"Accordion\":{\"HollowMode\":{\"AutoLabel\":\"Auto\",\"Banner\":\"Off shows the solid model as generated. Pick Auto to follow the mesh, or Manual to size a parametric cavity.\",\"ManualLabel\":\"Manual\",\"OffLabel\":\"Off\",\"Title\":\"Set Hollow Mode\"},\"HollowParams\":{\"BannerAuto\":\"Inner cavity follows the mesh's minimum radius at each slice. Wall thickness stays uniform — bumps in the surface still make local walls thicker, never thinner.\",\"BannerManual\":\"Shape the parametric egg with the sliders, then drag the gizmo in the viewer to position it.\",\"BannerOff\":\"Choose Auto or Manual hollow mode to start carving the cavity.\",\"BvhStatsAvg\":\"avg {value}mm\",\"BvhStatsLabel\":\"Actual wall (BVH sample)\",\"BvhStatsMax\":\"max {value}mm\",\"BvhStatsMin\":\"min {value}mm\",\"Height\":\"Height\",\"Pointiness\":\"Pointiness\",\"Radius\":\"Radius\",\"Scale\":\"Scale\",\"Title\":\"Adjust Hollow\",\"WallThickness\":\"Thickness\"},\"Next\":\"Next →\",\"Observe\":{\"Banner\":\"Inspect the generated egg from every angle. When you're happy with it, continue to carve out the hollow interior.\",\"Title\":\"Prepare to Hollow\"},\"SplitCut\":{\"Banner\":\"Choose where to split the Twist Egg into two printable halves.\",\"RatioLabel\":\"Split height\",\"Title\":\"Split \u0026 Cut\"}},\"Common\":{\"Breadcrumb\":\"Creative Lab\",\"Cancel\":\"Cancel\",\"Canceled\":\"Task was canceled.\",\"GenerationFailed\":\"Generation failed — try a different photo or retry.\",\"GlbFetchFailed\":\"Failed to load generated model.\",\"InvalidRequest\":\"Invalid request. Please try again.\",\"NotAvailable\":\"This feature is not available for your account.\",\"SubmitFallback\":\"Failed to start generation. Please try again.\",\"TaskInProgress\":\"A task is already in progress. Please wait.\"},\"CreateStage\":{\"Recreate\":\"Recreate\",\"StartDesign\":\"Start Design\"},\"Errors\":{\"CutFailed\":\"Cut failed — the mesh may not be manifold or the inner egg is fully outside the shell.\"},\"ExampleGallery\":{\"ItemAlt\":\"Example {n}\",\"Subtitle\":\"Pick a sample egg to skip generation and jump straight to the workbench.\",\"Title\":\"Try an example to get started\"},\"Footer\":{\"Download\":\"Download STL\",\"Process\":\"Process\",\"Reset\":\"Reset\"},\"GenerateStage\":{\"Finalising\":\"Finalising…\",\"GeneratingImage\":\"Generating Twist Egg image…\",\"LoadingTitle\":\"Your Twist Egg is on the way\",\"ProgressHint\":\"{progress}% — typically takes 1–3 minutes\",\"Queued\":\"Queued…\",\"Sculpting\":\"Sculpting 3D model…\",\"WaitingHint\":\"Once your Twist Egg finishes generating, the workbench will load so you can hollow it, split it, and export STL halves.\",\"Working\":\"Working…\"},\"Metadata\":{\"Description\":\"Design a custom twist egg with AI, then hollow it, split it into two twist-open halves, and export print-ready STL files to 3D print at home.\",\"OGDescription\":\"Generate an egg with AI, hollow and split it into two twist-open halves, then export print-ready STL files — free to 3D print at home.\",\"OGImageAlt\":\"Custom 3D printable twist egg designed with Meshy AI\",\"OGTitle\":\"Design Your Own 3D Printable Twist Egg\",\"Title\":\"Custom 3D Printable Twist Egg Maker | Meshy\",\"TwitterDescription\":\"Idea to AI-generated egg to twist-open STL halves you can 3D print at home with Meshy.\",\"TwitterImageAlt\":\"Custom 3D printable tw