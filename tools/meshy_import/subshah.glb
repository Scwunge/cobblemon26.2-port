ssets/community/banner-v2/20260612-FIFA-pop-up-50-off.webm\",\"aspectRatio\":\"16 / 9\",\"poster\":\"\"},\"results\":{\"lottery_first\":{\"url\":\"https://cdn.meshy.ai/webapp-assets/community/banner-v2/20260612-FIFA-pop-up-66-off.webm\"},\"lottery_second\":{\"url\":\"https://cdn.meshy.ai/webapp-assets/community/banner-v2/20260612-FIFA-pop-up-70-off.webm\"}}},\"trigger\":\"lottery_draw\",\"primaryButton\":{\"text\":\"Claim Now\",\"action\":{\"type\":\"close\",\"url\":\"\"},\"resultCopy\":{\"lottery_first\":{\"variant\":\"buy_one_get_n\",\"plan\":\"pro_quarterly\",\"n\":2},\"lottery_second\":{\"variant\":\"percent_monthly\"}}},\"scheduling\":{\"startTime\":\"2026-05-20T00:00:00Z\",\"endTime\":\"2026-07-20T00:00:00Z\",\"activeTimes\":1,\"coolDownHours\":0},\"targeting\":{\"logic\":\"ALL\",\"conditions\":[{\"key\":\"tier\",\"op\":\"IN\",\"value\":[\"free\"]}]},\"experiment\":{\"mode\":\"statsig_experiment\",\"id\":\"lottery_popup_2026_06\",\"groupId\":\"show_popup\",\"groupValue\":true,\"defaultValue\":false},\"featureGateId\":\"\"}]},\"group\":\"3mKGJObX5xorYKTZk5posC-3mKGJMwUDfeXFlm3IXtL9A\",\"rule_id\":\"3mKGJObX5xorYKTZk5posC-3mKGJMwUDfeXFlm3IXtL9A\",\"is_device_based\":false,\"secondary_exposures\":[],\"id_type\":\"userID\",\"passed\":true},\"1461125211\":{\"name\":\"1461125211\",\"value\":{\"enabled\":true,\"lazyInit\":true,\"rootMarginRatio\":1,\"tiers\":[{\"maxWidth\":768,\"preload\":8,\"loadMore\":6},{\"maxWidth\":1600,\"preload\":12,\"loadMore\":8},{\"maxWidth\":2560,\"preload\":18,\"loadMore\":12},{\"maxWidth\":99999,\"preload\":32,\"loadMore\":24}]},\"group\":\"6tX9q2rAckywd3pMn0a765\",\"rule_id\":\"6tX9q2rAckywd3pMn0a765\",\"is_device_based\":false,\"secondary_exposures\":[],\"group_name\":\"Treatment\",\"id_type\":\"userID\",\"is_user_in_experiment\":true,\"is_experiment_active\":true},\"1463067446\":{\"name\":\"1463067446\",\"value\":{\"is_referral_v3_release_b\":true,\"new_referral_reward_pricing\":true},\"group\":\"launchedGroup\",\"rule_id\":\"launchedGroup\",\"is_device_based\":false,\"secondary_exposures\":[],\"group_name\":\"UI Change And New Price\",\"id_type\":\"referralID\",\"is_user_in_experiment\":false,\"is_experiment_active\":false},\"1479481592\":{\"name\":\"1479481592\",\"value\":{\"quotes\":[{\"name\":\"Josh Loveridge\",\"title\":\"Managing Director, Stratton Studios\",\"description\":\"Meshy has transformed how we create, turning what used to be weeks of modeling into hours of exploration and creative discovery. It’s not just a speed tool for us; it’s become a genuine creative partner that empowers every department, from art to design, to think, iterate, and build at the pace of imagination.\",\"profileImage\":\"https://cdn.meshy.ai/landing-assets/images/avatars/josh_loveridge.webp\",\"brandImage\":\"https://cdn.meshy.ai/landing-assets/blog/stratton-studios/stratton-studios.webp\",\"brandImage2\":\"https://cdn.meshy.ai/landing-assets/contact/quotes/stratton2.webp\",\"link\":\"\"},{\"name\":\"Wenchao Yang\",\"title\":\"CEO, Thorns Tavern\",\"description\":\"We first discovered Meshy while looking for AI tools to speed up our 3D model creation process. From idea to full-color custom miniature, we needed a way to quickly turn players’ character designs into printable models, and Meshy’s AI generation really blew us away. It was exactly what we were looking for.\",\"profileImage\":\"https://cdn.meshy.ai/landing-assets/images/avatars/wenchao_yang.webp\",\"brandImage\":\"https://cdn.meshy.ai/landing-assets/blog/thorns-tavern-enterprise-use-case/thorns-tavern2.webp\",\"brandImage2\":\"https://cdn.meshy.ai/landing-assets/contact/quotes/thornstavern2.webp\",\"link\":\"/customers/thorns-tavern-enterprise-use-case\"},{\"name\":\"Navi Wang\",\"title\":\"VP of Tech and Product, Jupiter\",\"description\":\"Meshy has completely transformed our 3D workflow. What used to take an entire week now takes just two hours, a remarkable 98% reduction in production time. Beyond speed, Meshy has become one of the most visionary and complementary partners in the 3D creation space.\",\"profileImage\":\"https://cdn.meshy.ai/landing-assets/images/avatars/navi_wang.webp\",\"brandImage\":\"https://cdn.meshy.ai/landing-assets/blog/jupiter-enterprise-use-case/jupiter-white.webp\",\"brandImage2\":\"https://cdn.meshy.ai/landing-assets/contact/quotes/jupiter2.webp\",\"link\":\"/customers/jupiter-enterprise-use-case\"},{\"name\":\"Jia Xu\",\"title\":\"CEO, Creatool\",\"description\":\"The game art industry is undergoing an exciting transformation — AI is redefining how we create. Tools like Meshy are at the forefront of this change, dramatically improving 3D asset creation efficiency while empowering artists to control visual expression through text and image. We see Meshy not just as a tool, but as a glimpse into the future of art production workflows.\",\"profileImage\":\"https://cdn.meshy.ai/landing-assets/images/avatars/jia_xu.webp\",\"brandImage\":\"https://cdn.meshy.ai/landing-assets/blog/creatool/creatool.webp\",\"brandImage2\":\"https://cdn.meshy.ai/landing-assets/contact/quotes/creatool2.webp\",\"link\":\"\"}]},\"group\":\"3Zs2iz16evuisnpePSWpOj:100.00:3-3Zs2ixm3MdkO8XRjeL0Mvh\",\"rule_id\":\"3Zs2iz16evuisnpePSWpOj:100.00:3-3Zs2ixm3MdkO8XRjeL0Mvh\",\"is_device_based\":false,\"secondary_exposures\":[],\"id_type\":\"userID\",\"passed\":true},\"1503011287\":{\"name\":\"1503011287\",\"value\":{},\"group\":\"prestart\",\"rule_id\":\"prestart\",\"is_device_based\":false,\"secondary_exposures\":[],\"id_type\":\"userID\",\"is_user_in_experiment\":false,\"is_experiment_active\":false},\"1516860669\":{\"name\":\"1516860669\",\"value\":{\"badge_colorize_prompt\":\"Extract the main subject of the reference image and transform it into a round, Bas-relief medal. Strictly and completely preserve the original pose, cropping, and all structural details of the main subject; simplification of details and structure is strictly prohibited. Every single element of the subject, down to the smallest detail (such as whiskers, collars, foliage veins, the specific color, shape, and structure of the eyes, and precise facial expressions), must be faithfully and precisely replicated without distortion or exaggeration in the Bas-relief form. There should be absolutely no deletion or modification of features, nor any addition of structure or elements not present in the reference image. Crucially, the original pose and cropping must be strictly preserved without any alteration. The medal's outer border features a simple engraved pattern. The main subject is smaller than the inner circle of the medal and is completely contained within the inner circle, not touching the edges. The subject must be colored to perfectly, exactly, and faithfully match the original colors, complex patterns, and precise color variations from the reference image. This specifically includes fur pattern and eye detail for animals, and all complex color variations for other subjects. The empty area around the main subject, within the inner circle, must contain only a small number of completely flat, two-dimensional (2D) decorative patterns (if the main subject is a landscape photo, no 2D decorative patterns will be generated), and the 2D decorative patterns must be related to the main subject. These patterns must be neat, orderly, and clearly defined, strictly avoiding fine, fragmented, or chaotic elements. The decorative patterns must have zero depth or relief, being purely 2D. Their colors must be different from the main subject. The background panel behind the central subject, within the inner circle, must be a single, solid color, strictly without any color gradient. The color of this panel and the medal's border must be different from the main subject's colors, and avoid dark fills. The border color must be beautiful, elegant, and thoughtfully matched to harmonize with the colors of the main subject. Under no circumstances should the medal's border, text, or background be gold. The entire composition uses a rich and harmonious Hayao Miyazaki color style. The scene is illuminated by bright, soft, and highly diffused ambient light with a very gentle sidelight from the left, ensuring the lighting on the main subject is bright and flat with extremely low contrast. Shadows throughout the entire medal structure must be kept to an absolute minimum, being minimal, extremely light, soft, and faint. Deep blacks, heavy shading in crevices, or deep internal shadows are strictly forbidden, ensuring all details remain bright and clearly visible. The medal is made of a matte, non-metallic material. The scene is an overhead shot, with the medal flat on a pure white background, casting a shadow onto the white background. The image has ultra-sharp focus, extremely clear detail, clean 3D render with a perfectly smooth surface for un-engraved areas, and tactile texture details (especially the fur texture for animal subjects), high definition, 8K resolution.\",\"badge_colorize_with_name_prompt\":\"Extract the main subject of the reference image and transform it into a round, Bas-relief medal. Strictly and completely preserve the original pose, cropping, and all structural details of the main subject; simplification of details and structure is strictly prohibited. Every single element of the subject, down to the smallest detail (such as whiskers, collars, foliage veins, the specific color, shape, and structure of the eyes, and precise facial expressions), must be faithfully and precisely replicated without distortion or exaggeration in the Bas-relief form. There should be absolutely no deletion or modification of features, nor any addition of structure or elements not present in the reference image. Crucially, the original pose and cropping must be strictly preserved without any alteration. The medal's outer border features a simple engraved pattern. Engraved into the [bottom arc] of the medal's border is the clean, legible text: {{name_text}}. The text is precisely curved to follow the arc of the circular border, sharing the exact same color as the border itself, with its shape defined entirely by the shallow engraved depth. The main subject is smaller than the inner circle of the medal and is completely contained within the inner circle, not touching the edges. The subject must be colored to perfectly, exactly, and faithfully match the original colors, complex patterns, and precise color variations from the reference image. This specifically includes fur pattern and eye detail for animals, and all complex color variations for other subjects. The empty area around the main subject, within the inner circle, must contain only a small number of completely flat, two-dimensional (2D) decorative patterns (if the main subject is a landscape photo, no 2D decorative patterns will be generated), and the 2D decorative patterns must be related to the main subject. These patterns must be neat, orderly, and clearly defined, strictly avoiding fine, fragmented, or chaotic elements. The decorative patterns must have zero depth or relief, being purely 2D. Their colors must be different from the main subject. The background panel behind the central subject, within the inner circle, must be a single, solid color, strictly without any color gradient. The color of this panel and the medal's border must be different from the main subject's colors, and avoid dark fills. The border color must be beautiful, elegant, and thoughtfully matched to harmonize with the colors of the main subject. Under no circumstances should the medal's border, text, or background be gold. The entire composition uses a rich and harmonious Hayao Miyazaki color style. The scene is illuminated by bright, soft, and highly diffused ambient light with a very gentle sidelight from the left, ensuring the lighting on the main subject is bright and flat with extremely low contrast. Shadows throughout the entire medal structure must be kept to an absolute minimum, being minimal, extremely light, soft, and faint. Deep blacks, heavy shading in crevices, or deep internal shadows are strictly forbidden, ensuring all details remain bright and clearly visible. The medal is made of a matte, non-metallic material. The scene is an overhead shot, with the medal flat on a pure white background, casting a shadow onto the white background. The image has ultra-sharp focus, extremely clear detail, clean 3D render with a perfectly smooth surface for un-engraved areas, and tactile texture details (especially the fur texture for animal subjects), high definition, 8K resolution.\",\"badge_depth_map_prompt\":\"Create a high-fidelity grayscale depth map based on the exact geometry and composition of the first image, treating the first image as the sole source of all structure, composition, border/frame design, scale, and positioning. Do not change any structure or detail of the first picture, and adding or deleting any structural elements of the badge design is strictly prohibited, except for any text characters which must be completely removed. Changing the border style of the badge is prohibited, and the badge border must come exclusively from the first image and must never be replaced, mixed, or substituted with the border of the second or third reference images; do not add, invent, duplicate, or wrap any additional border, outer ring, rim, bezel, frame, mat, or concentric circle around the badge that does not already exist in the first image — the badge's outermost edge and the exact number of border layers must match the first image precisely, and no second outer ring may appear outside the original one. Strictly maintain the exact scale, relative proportions, and spatial positioning of all elements as they appear in the first image, ensuring the primary subject does not change size relative to the outer frame, the size of the primary subject relative to the outer frame is prohibited from changing in any way, and do not enlarge, shrink, zoom, crop, pad, or recenter the badge — the output must align 1:1 with the first image, with the badge occupying the exact same area within the canvas as in the first image. If there is any text or lettering on the badge border, you must completely ignore, erase, and omit these characters during depth inference, you must completely ignore, erase, and omit these characters during depth inference, rendering the text area as a completely flat, blank, and smooth surface with absolutely no text-shaped protrusions, contours, or depressions. Map the entire scene onto a grayscale gradient: pure white represents the elements closest to the viewer (the absolute foreground), smoothly transitioning through varying shades of gray for mid-ground layers（note that the non-patterned parts around the subject must have no gradient gray values）, down to pure black for the furthest background plane, and do not invert this depth convention under any circumstances. Every single part of the background outside of the badges must be 100% solid, pure black without any gray artifacts, and must never be white, gray, or a half-white/half-black mixture; the area outside the badge is the farthest plane and is therefore pure black, never the foreground; the depth map must contain only the circular badge, so everything outside the badge's circular outline must be pure black with a hard, clean edge and no soft gray halo, glow, gradient, ambient occlusion, outline, or bleed; do not render the badge as a physical object resting on a base, stand, pedestal, platform, mount, or support, and no white or gray base, plinth, shadow, or added structure may appear beneath or around the badge. The effect of the depth map refers to the second and third reference maps, and only refers to the effect of their depth maps (their depth-encoding and tonal mapping only), do not refer to anything else, and never take their subject, composition, decorations, or border. Specifically, ensure that the defined structural and compositional details of the primary subject in the first image, such as small feature contours, are clearly rendered and distinct in depth, integrated into the overall volumetric form, rather than being smoothed away. Small, intricate features and structural definition on the primary subject should be distinguishable. The intricate details of the frame from the first image are rendered in appropriate gray gradients. Preserve all other geometric details, presenting them as clean, non-textured, purely geometric volumes without any original surface textures, cast shadows, or colored lighting artifacts. The background outside the badges must be a solid, deep black, prohibited for white or any non-black gray values.\",\"badge_depth_map_reference_image_urls\":[\"https://cdn.meshy.ai/webapp-assets/creative-lab/keychain/depth-map-reference/ref-1.png\",\"https://cdn.meshy.ai/webapp-assets/creative-lab/keychain/depth-map-reference/ref-2.png\"],\"badge_depth_map_with_name_prompt\":\"Create a high-fidelity grayscale depth map based on the exact geometry and composition of the first image, treating the first image as the sole source of all structure, composition, border/frame design, scale, and positioning. Do not change any structure or detail of the first picture, and adding or deleting any structural elements of the badge design is strictly prohibited, except for any text characters which must be completely removed. Changing the border style of the badge is prohibited, and the badge border must come exclusively from the first image and must never be replaced, mixed, or substituted with the border of the second or third reference images; do not add, invent, duplicate, or wrap any additional border, outer ring, rim, bezel, frame, mat, or concentric circle around the badge that does not already exist in the first image — the badge's outermost edge and the exact number of border layers must match the first image precisely, and no second outer ring may appear outside the original one. Strictly maintain the exact scale, relative proportions, and spatial positioning of all elements as they appear in the first image, ensuring the primary subject does not change size relative to the outer frame, the size of the primary subject relative to the outer frame is prohibited from changing in any way, and do not enlarge, shrink, zoom, crop, pad, or recenter the badge — the output must align 1:1 with the first image, with the badge occupying the exact same area within the canvas as in the first image. If there is any text or lettering on the badge border, such as the custom text {{name_text}}, you must completely ignore, erase, and omit these characters during depth inference, rendering the text area as a completely flat, blank, and smooth surface with absolutely no text-shaped protrusions, contours, or depressions. Map the entire scene onto a grayscale gradient: pure white represents the elements closest to the viewer (the absolute foreground), smoothly transitioning through varying shades of gray for mid-ground layers（note that the non-patterned parts around the subject must have no gradient gray values）, down to pure black for the furthest background plane, and do not invert this depth convention under any circumstances. Every single part of the background outside of the badges must be 100% solid, pure black without any gray artifacts, and must never be white, gray, or a half-white/half-black mixture; the area outside the badge is the farthest plane and is therefore pure black, never the foreground; the depth map must contain only the circular badge, so everything outside the badge's circular outline must be pure black with a hard, clean edge and no soft gray halo, glow, gradient, ambient occlusion, outline, or bleed; do not render the badge as a physical object resting on a base, stand, pedestal, platform, mount, or support, and no white or gray base, plinth, shadow, or added structure may appear beneath or around the badge. The effect of the depth map refers to the second and third reference maps, and only refers to the effect of their depth maps (their depth-encoding and tonal mapping only), do not refer to anything else, and never take their subject, composition, decorations, or border. Specifically, ensure that the defined structural and compositional details of the primary subject in the first image, such as small feature contours, are clearly rendered and distinct in depth, integrated into the overall volumetric form, rather than being smoothed away. Small, intricate features and structural definition on the primary subject should be distinguishable. The intricate details of the frame from the first image are rendered in appropriate gray gradients. Preserve all other geometric details, presenting them as clean, non-textured, purely geometric volumes without any original surface textures, cast shadows, or colored lighting artifacts. The background outside the badges must be a solid, deep black, prohibited for white or any non-black gray values.\",\"brick_figure_prototype_prompt\":\"Role: You are a professional 3D texture mapping engineer and stylistic color specialist.\\nTask: Generate an exploded parts display of a disassembled brick minifigure, strictly preserving the exact geometric structure, component shapes, and spatial layout of all floating parts seen in the template reference image. Use the source image only for the face, hair or headwear, skin tone, clothing colors, and clothing patterns.\\nStrict Skin Color Mapping (MANDATORY):\\n  * Analyze the subject's actual skin tone or body color from the source image. Apply that exact color as uniform solid glossy ABS plastic to the Head and Hand parts.\\n  * Do not use any preset color - match the character's actual color from the source image. No gradients.\\nExpression Capture (CRITICAL):\\n  * Analyze face in the source image. Re-draw as brick-toy-style printed decal on Cylinder Head.\\n  * Must be \\\"print on plastic\\\", not realistic human face.\\n  * If the subject in the source image has hair or headwear, render it as a plastic hair/hat piece attached to the top of the head. If the subject is bald or has no visible hair, keep the head smooth.\\nSubject Mapping (from source image):\\n  * Clothing colors/patterns -\u003e flat-printed designs on Torso and Legs.\\nStructural Fidelity (MOST CRITICAL - HIGHEST PRIORITY):\\n  * Retain all pins, joints, and connectors from the template reference image. Exactly five physically separated parts: head, torso, left arm, right arm, legs.\\n  * HEAD SEPARATION IS MANDATORY: The cylindrical head MUST float above the torso with a clearly visible gap of at least 5-10% of total figure height. There must be EMPTY SPACE (background visible) between the bottom of the head and the top of the torso. The head and torso are TWO COMPLETELY INDEPENDENT pieces - they must NEVER touch, merge, blend, or connect in any way. No neck, no skin bridge, no color continuation between head and torso.\\n  * ARM SEPARATION IS MANDATORY: Both arms must extend outward from the torso exactly as shown in Image 1. Each arm must be a completely independent piece with a clearly visible gap between the arm and the torso body. Arms must NEVER be pressed against or merged into the torso sides.\\nCamera Angle (MANDATORY):\\n  * Strictly front-facing view, perfectly centered, no tilt, no rotation, no 3/4 angle.\\nTechnical Aesthetics:\\n  * Glossy ABS plastic, subtle specular highlights, clean vector-like lines.\\n  * Plain white background, high-key studio lighting, no shadows.\\nDo not generate realistic human skin or realistic facial features. The face must look like a flat printed decal on plastic, not a real human face. Do not add fabric texture, messy background, text, or watermarks.\",\"brick_figure_prototype_reference_image_urls\":[\"https://cdn.meshy.ai/webapp-assets/creative-lab/brick-figure/reference-map/reference-map.webp\"],\"clover_fidget_silhouette_prompt\":\"A high-definition, professional photo-style graphic rendering of a smooth-contoured sticker. The main subject of the input image is identified and automatically scaled down to a centered, reduced size within the frame (e.g., to approx. 25% of the total area) to ensure sufficient spacing. This scaled subject is then converted into a solid black, featureless, highly simplified silhouette. This black silhouette is completely and perfectly enclosed by a single, thin, tight white offset outline, which provides a narrow but clearly visible gap. This outline shape closely hugs the silhouette, precisely tracing subject details (e.g., clothing folds, complex machine parts, or hair) to create a detailed profile, rather than being generalized or simplified into larger, rounded shapes. The entire white-outlined graphic is finished with a single, thin, clean black border around its outermost edge. The graphic is centered on a pure, solid white background, with no other elements, text, textures, or watermarks present. The perspective is a clean, head-on view.\",\"figure_prototype_prompt\":\"Generate an image with the \\\"chibi figurine\\\" theme. Follow these instructions: The first image is the subject: use it as the structural and shape reference. Apply the exact artistic style, color palette, materials, and lighting from the remaining 9 reference image(s) as the visual style. The final image must match the style references perfectly while preserving the subject's structure.\",\"figure_prototype_reference_image_urls\":[\"https://cdn.meshy.ai/webapp-assets/creative-lab/figurine/ref-image/1.webp\",\"https://cdn.meshy.ai/webapp-assets/creative-lab/figurine/ref-image/2.webp\",\"https://cdn.meshy.ai/webapp-assets/creative-lab/figurine/ref-image/3.webp\",\"https://cdn.meshy.ai/webapp-assets/creative-lab/figurine/ref-image/4.webp\",\"https://cdn.meshy.ai/webapp-assets/creative-lab/figurine/ref-image/5.webp\",\"https://cdn.meshy.ai/webapp-assets/creative-lab/figurine/ref-image/6.webp\",\"https://cdn.meshy.ai/webapp-assets/creative-lab/figurine/ref-image/7.webp\",\"https://cdn.meshy.ai/webapp-assets/creative-lab/figurine/ref-image/8.webp\",\"https://cdn.meshy.ai/webapp-assets/creative-lab/figurine/ref-image/9.webp\"],\"figure_prototype_v2_prompt\":\"Transform the character in the image into a 3D-rendered cute chibi-style miniature figurine in Pop Mart blind box style, made of high-quality resin material with a smooth matte finish and no glare, featuring exquisite details and adorable Q-version proportions. The figurine is shown in a front view facing the camera directly in a standing pose with feet naturally placed, displayed alone with no base, no hands holding it, and no props or support of any kind. The image uses a soft macaron color palette with clean translucent tones, normal white balance, realistic cinematic lighting with the key light from the upper side, casting a clear, soft, and natural realistic drop shadow directly onto the seamless pure white background ground (#FFFFFF), creating a premium and healing aesthetic. The background is a minimalist pure white backdrop with no environment, no table, no floor texture, and no blurred scenery, keeping the subject prominent. Commercial-grade product photography masterpiece with rich 3D details, realistic material reflections, delicate lighting, ultra HD quality, 1:1 aspect ratio.\",\"lamp_image_character_prompt\":\"Transform the input image into a compact and moderately rounded Q-version (Chibi) style. Dynamically detect the subject: if it is a human or an animal, isolate and generate ONLY the head; if it is an object or a landscape, isolate ONLY its absolute core component (strictly prohibiting the generation of any facial or human-like features on objects or landscapes). Sculpt smooth, highly simplified structural details (and facial features for characters only) onto the surface, ensuring the level of detail is drastically reduced into minimalist forms while still retaining key recognizable traits and basic structural shapes to avoid becoming excessively round. Avoid excessive complexity. Apply a uniform matte white material finish to all areas. Ensure all features and extensions are incredibly compact and highly integrated into the main body mass, without overly large gaps or excessively extended parts, to guarantee the ultimate compactness and smooth, block-like consistency of the overall structure. Render the isolated subject from a clear 3/4 (three-quarter) side angle. The final model must be a single, solid piece; for humans/animals, it must be head-only with absolutely no neck, no residual neck stumps, or separate pedestals/bases. The entire bottom boundary and structure must be sculpted into a perfectly flat, clean, and stable horizontal ground plane interface. The model must rest flush on a flat, pure white ground plane. The shape of the ground interface at the bottom should look directly similar to the clean, flat, and neckless block contact pattern seen in the second and third reference images, ensuring the subject makes direct and continuous contact with the ground. Residual neck geometry or separate platforms are absolutely prohibited. Isolate completely on a pure white background. If the image features a person with long hair, the hair must be cut short and fit tightly to the head without any overhanging gaps. Negative constraints: absolutely no necks, no residual neck stumps, no floating elements, no separate bases, absolutely no facial features on objects and landscapes.\",\"lamp_image_landscape_prompt\":\"Transform the input image into a compact, completely solid, hole-free (single, completely solid, hole-free), and moderately rounded minimalist style model. The entire model structure (including the main body and all details) must be completely solid, with absolutely no penetrative apertures, internal voids, or surface holes. Dynamically detect the subject and apply different style treatments: if the extracted subject is non-mountainous (e.g., buildings, objects), drastically simplify its structural details and transform it into a more Q-version (Chibi) style model; if the extracted subject is a mountain, make it into a miniature model (diorama). While maintaining the current minimalist level of detail complexity, you must strictly reproduce the true silhouette (Note: non-mountain subjects can have Q-version proportion adjustments but must retain iconic features), volume proportions, and iconic layout structure of the subject in the original image. Refuse to generate a generic model, ensuring the final model maintains an extremely high visual similarity and recognizability to the original photo. Dynamically detect the subject: isolate ONLY the single most core and prominent component of the object or landscape (strictly prohibiting the generation of any facial or biological features). If the subject is non-mountainous (e.g., buildings, objects), retain only that single core entity, strictly prohibit adding any base, and its bottom must be cut directly into a perfectly flat surface. If the subject is a mountain, you must absolutely discard all other elements except the mountain itself (including all attached buildings, structures, trees, roads, vegetation, etc., keeping only the pure mountain mass), but you must accurately reflect the specific silhouette features of that mountain from the original image, retaining the largest core mass and fundamental structural texture. Sculpt smooth, highly simplified structural details onto the surface, ensuring the level of detail is drastically reduced into minimalist forms while still retaining key basic structural shapes to avoid becoming excessively round. (Note: if the extracted subject is a mountain, while keeping it minimalist, retain the core mid-level terrain features necessary for recognition, and moderately reflect a hard-surface geometric cut style, but the rock transitions and edges must be slightly softer and more rounded, avoiding overly intense or sharp angular cuts, to reflect a gentler miniature diorama texture). Apply a uniform matte pure white material finish to all areas. Ensure all features are incredibly compact and highly integrated into the main core mass, without overly large gaps or excessively extended parts. Render the isolated subject from a clear 3/4 (three-quarter) side angle. If the isolated core component is a mountain, its bottom must not be a simple flat cut; it must feature an integrated, low cylindrical base section (Note: ONLY mountains get this base). The mountain must be a natural, organic upward extension of this base (as if carved from the exact same block of white stone), with absolutely no visible seams, fault lines, or stiff stacking artifacts, achieving a 100% seamless and unified fusion, forming a single, completely solid geometry, and the mountain's core mass must be precisely centered. The final model must be an absolutely single, completely solid, hole-free piece. The entire bottom boundary and structure must be sculpted into a perfectly flat, clean, and stable horizontal ground plane interface (non-mountain subjects must be directly flat on the ground; mountains use the flat bottom formed by the integrated cylindrical base). The model must rest completely flush on a flat, pure white ground plane. Separate, detached platforms are strictly prohibited. Isolate completely on a pure white background. Negative constraints: absolutely no facial features, no biological features, no floating elements, absolutely no base for non-mountain subjects, absolutely no buildings/plants or any other clutters on mountain subjects**, absolutely no internal voids, no surface holes, and no penetrative apertures.**\",\"lamp_image_reference_image_urls\":[\"https://cdn.meshy.ai/webapp-assets/creative-lab/lamp/ref-image/1.png\",\"https://cdn.meshy.ai/webapp-assets/creative-lab/lamp/ref-image/2.png\"],\"lamp_text_prompt\":\"Generate a compact, completely solid, hole-free, and moderately rounded stylized Q-version (Chibi) style model based on the concept: [YOUR SUBJECT HERE].\\nDynamically detect the subject category and strictly apply different structural treatments:\\nIf the subject is a human or an animal: Isolate and generate ONLY the head. Sculpt smooth, stylized facial and structural features. Balance complexity to define clear stylized forms without adding overwhelming or realistic texture. For hair or fur, define distinct but simplified, integrated, sculpted volumes rather than fine realistic strands or intricate patterns, ensuring details are clear but simplified into smooth planes. If the subject is female or described with long hair, the maximum hair length must strictly not exceed 3/4 (three-quarters) of the total head length. All hair (or fur) must be cut short, contoured tightly to the head, and layered seamlessly without any overhanging gaps, floating parts, or excessive volume that breaks the compact form. The final model must be head-only with absolutely no neck, no residual neck stumps, or separate pedestals/bases. The entire bottom boundary and structure (including hair ends) must be sculpted into a perfectly flat, clean, and stable horizontal ground plane interface. The shape of the ground interface at the bottom must directly form a clean, flat, and neckless block contact pattern, ensuring the subject makes direct and continuous flush contact with the ground.\\nIf the subject is a non-mountainous object (e.g., buildings, vehicles, items): Isolate ONLY its absolute core component (strictly prohibiting the generation of any facial or human-like features). Sculpt smooth, highly simplified structural details onto the surface. The bottom of the object must be cut directly into a perfectly flat surface, ensuring direct and continuous flush contact with the ground. Strictly prohibit adding any base or pedestal.\\nIf the subject is a mountain or landscape: Create a miniature diorama model. You must absolutely discard all other elements except the pure mountain mass itself (including all attached buildings, vegetation, etc.), retaining core mid-level terrain features necessary for recognition. Moderately reflect a hard-surface geometric cut style, but with slightly softer and rounded rock transitions. The bottom of the mountain must NOT be a simple flat cut; it must feature an integrated, low cylindrical base section. The mountain must be a natural, organic upward extension of this base (as if carved from the exact same block of white stone), achieving a 100% seamless and unified fusion.\\nGlobal rendering rules: Apply a uniform matte pure white material finish to all areas. Ensure all features and extensions are incredibly compact and highly integrated into the main body mass, without overly large gaps or excessively extended parts, to guarantee the ultimate compactness and smooth, block-like consistency of the overall structure. Avoid excessive complexity. Render the isolated subject from a clear 3/4 (three-quarter) side angle.\\nThe final model must be an absolutely single, completely solid, hole-free piece. The model must rest completely flush on a flat, pure white ground plane. Isolate completely on a pure white background.\\nNegative constraints: absolutely no necks, no residual neck stumps, no floating elements, no loose hair, no separate detached platforms/bases, absolutely no facial features on objects and landscapes, no internal voids, no surface holes, and no penetrative apertures.\",\"pixel_pixelize_other_prompt\":\"Subject colors must avoid the near-white range: every subject pixel must have at least one RGB channel ≤ 180. Render this object as pixel bead art / minimal pixel-style icon. Adaptive complexity: if the subject is naturally simple (fruit, heart, star, single small item, geometric shape), keep its core identifying features and use 4-6 highly saturated solid colors with optional 1-pixel highlight and 1-pixel shadow accents (still flat blocks, never real gradients). If complex (machinery, building, multi-part object, heavily textured), aggressively reduce to a bold silhouette or most recognizable outline with at most 3-4 flat color blocks, dropping all decorations, text, interior detail, and parts smaller than ~5% of the frame. Forbidden: gradients, shadows (except the optional 1-pixel accent), highlights (except the optional 1-pixel accent), reflections, textures, outline strokes, background elements, decorative details. Background must be pure white #FFFFFF with a crisp hard edge between subject and background — no feathering, no blurring, no semi-transparent pixels. Subject centered occupying 80% of the frame. Style: retro 8-bit pixel sprite, SVG flat vector, cartoon flat, pixel bead aesthetic, simplified minimal design with bold simple shapes.\",\"pixel_pixelize_person_prompt\":\"Subject colors must avoid the near-white range: every subject pixel must have at least one RGB channel ≤ 180. Convert this person into an extremely simplified pixel chibi / 8-bit sprite avatar resembling retro video game characters. Use 4-5 highly saturated solid flat colors total for skin, hair, top, and bottom — high contrast, no gradient, no shading, no highlights, no texture, no pattern. Eyes are 1-2 pixel dots, mouth is a 1-2 pixel horizontal line, nose omitted or a single dark pixel; no eyebrows, no individual fingers, no facial expression beyond the minimal eye and mouth pixels. Keep only the overall hair silhouette — no individual strands or internal detail. Clothing keeps main color plus at most one accent color; omit folds, patterns, logos, text, accessories, jewelry, glasses-frame details, buttons, zippers. Body simplified into bold geometric blocks adapted for a low-resolution pixel grid (16×16 or 32×32). Subject centered occupying 75% of the frame. Background must be pure white #FFFFFF with crisp hard pixelated edge — no feathering, no anti-aliasing, no semi-transparent edges, no outline strokes. Style: retro 8-bit pixel sprite, chibi pixel art, SVG flat vector, flat cartoon, pixel bead aesthetic. Forbidden: gradients, shadows, highlights, textures, patterns, anti-aliasing, outline strokes.\",\"soccer_keychain_colorize_general_prompt\":\"An overhead shot of a circular commemorative medal lying flat on pure white. The medal is matte and non-metallic, with a clean, smooth surface finish. At the center sits a sculpted bas-relief of the subject from the reference image, shown performing a football action—do not simply copy the subject's pose from the reference image, instead actively choose a football moment from this list and vary across generations: a powerful strike, a header, an overhead bicycle kick, a sliding tackle, a goalkeeper's diving save, dribbling past a defender, juggling the ball, a quiet moment of focus before a free kick, raising the trophy, sliding on the knees in celebration, pointing skyward after scoring, walking off the pitch with the ball under one arm, sitting catching breath, tying boots, or stretching pre-match. Vary the camera angle and body orientation as well—low angle, three-quarter view, side profile, front-facing—not always the same hero pose. The likeness to the reference must be strong and immediately recognizable: face, hairstyle, build, and expression should clearly read as the same person. Use natural adult proportions with foreshortening where the action calls for it. If the reference subject is an animal rather than a human, the single most important rule is this: the animal's limbs must remain the animal's own limbs and must never be replaced, reshaped, or redrawn as human arms, human hands, human fingers, human legs, or human feet. A dog keeps its four dog legs and paws. A cat keeps its four cat legs and paws. A horse keeps its four hooved legs. A bird keeps its wings and bird feet. Under no circumstances should an animal be given human arms reaching out, human hands gripping a ball, human fingers, human legs kicking, or human feet wearing boots in a human way. The animal also stays in its natural stance—quadrupeds remain on four legs in a natural quadrupedal posture, never standing upright on hind legs in a human stance, and never given a human torso, human shoulders, or human waist. Keep the species-accurate head, snout, ears, fur or feathers or scales, and tail fully intact, with no human facial features grafted on. The football action must be adapted to the animal's real body and natural biomechanics—for example, a dog nosing or paw-tapping the ball, a cat batting it with a paw, a horse nudging it with its muzzle, a bird balancing on it—rather than reinterpreted through human poses like bicycle kicks, knee slides, or boot-tying. No anthropomorphic hybrid, no mascot-style humanoid with an animal head, no cartoon furry character body. If the reference subject is a landscape or scenery photograph (no human, no animal—for example mountains, lakes, coastlines, forests, deserts, city skylines, architecture, streets, fields, starry skies, etc.), then the central subject of the relief must be that landscape itself, and under no circumstances may any kicking human figure or animal figure be invented or inserted into the scene. In this case, the bas-relief at the center of the medal is a faithful rendering of the landscape itself—preserving the signature landforms, contours, compositional layers, and atmospheric character of the reference (the shape of the mountains, the flow of water, the silhouette of the skyline, the form of the buildings, the distribution of vegetation, etc.) so that it reads at a glance as the same place or scene. Football-themed elements may be woven naturally into the landscape as low-relief, non-competing accents—a single football resting or rolling in the foreground, a faint suggestion of goalposts in the distance, pitch lines drawn into the edge of the scene, soft motion trails, or a patch of grass subtly hinting at pitch texture—but these elements must serve the landscape rather than replace it, and no kicking human or animal may appear anywhere. Vary the camera framing and viewpoint across generations as well—wide angle, close detail, top-down, eye-level, backlit silhouette—rather than a uniform postcard view. The colors of the landscape itself should follow the vivid saturated palette rules below. The entire figure is fully colored—no part of the subject is left as bare relief or uncolored sculpt. Skin and hair use natural human tones from the reference (where the subject is human). Use a bright, vivid, saturated color palette throughout—rich reds, blues, yellows, greens, oranges, and warm earthy tones—the kit should feel lively and visually striking. Every clothing piece (jersey, shorts, socks, boots) carries a clear distinct color, mixed and matched into a complete, intentionally designed outfit. (This clothing clause applies to human subjects; for animal and landscape subjects, apply the same vivid saturated palette principles to their own coloration instead.) Dress the human subject in a plain, generic football kit. The kit must not display any sponsor logos, team crests, brand marks, or jersey numbers, and must not resemble the iconic colorways or stripe patterns of well-known national teams or clubs (e.g., avoid the obvious Brazil yellow-and-green combo, Argentina's blue-white vertical stripes, England's red-on-white cross, Germany's black-white-red, or similar instantly recognizable national kits). The medal body, decorative motifs, and rim are also fully colored, drawing from the same vivid palette, with rim, background field, and subject colors all visually distinct from one another. Inside the inner ring, suggest a stylized football pitch and a few football-themed motifs—ball, grass, motion lines, sparkles—rendered as lower-relief supporting elements that don't compete with the subject, each in their own clear color. The outer rim carries a modern engraved geometric pattern inspired by contemporary sport graphic design, in a light contrasting tone—never gold, never dark. The relief retains its full three-dimensional surface modeling—gentle highlights along raised edges and soft self-shading along recessed areas give every form clear sculptural depth and tactile presence. However, the figure casts no shadow onto the medal background, and the medal itself casts no shadow onto the pure white surface beneath—the composition floats cleanly with no projected shadows anywhere. Clean smooth render, illustration clarity. No sponsor logos, brand marks, team crests, tournament logos, national flags, or text anywhere in the composition.\",\"soccer_keychain_colorize_signature_prompt\":\"An overhead shot of a circular commemorative medal lying flat on pure white. The medal is matte and non-metallic, with a clean, smooth surface finish. At the center of the medal sits a sculpted bas-relief of the subject from the reference image, performing a football action. The football action can be Messi's /both index fingers to the sky/ celebration, Cristiano Ronaldo's signature move (SIU), Mbappé's signature arms-crossed pose, Neymar's samba-dancer move, or Haaland's zen meditation. Vary the camera angle and body orientation as well—do not always use the same pose. The facial features in the output must NOT be those of the famous players listed above; the face, hairstyle, build, and expression of the figure in the output should resemble the reference image. Use natural adult proportions, with foreshortening where the action calls for it. If the reference subject is an animal rather than a human, the single most important rule is this: the animal's limbs must remain the animal's own limbs and must never be replaced, reshaped, or redrawn as human arms, human hands, human fingers, human legs, or human feet. A dog keeps its four dog legs and paws. A cat keeps its four cat legs and paws. A horse keeps its four hooved legs. A bird keeps its wings and bird feet. Under no circumstances should an animal be given human arms reaching out, human hands gripping a ball, human fingers, human legs kicking, or human feet wearing boots in a human way. The animal also stays in its natural stance—quadrupeds remain on four legs in a natural quadrupedal posture, never standing upright on hind legs in a human stance, and never given a human torso, human shoulders, or human waist. Keep the species-accurate head, snout, ears, fur or feathers or scales, and tail fully intact, with no human facial features grafted on. The football action must be adapted to the animal's real body and natural biomechanics—for example, a dog nosing or paw-tapping the ball, a cat batting it with a paw, a horse nudging it with its muzzle, a bird balancing on it—rather than reinterpreted through human poses like bicycle kicks, knee slides, or boot-tying. No anthropomorphic hybrid, no mascot-style humanoid with an animal head, no cartoon furry character body. If the reference subject is a landscape or scenery photograph (no human, no animal—for example mountains, lakes, coastlines, forests, deserts, city skylines, architecture, streets, fields, starry skies, etc.), then the central subject of the relief must be that landscape itself, and under no circumstances may any kicking human figure or animal figure be invented or inserted into the scene. In this case, the bas-relief at the center of the medal is a faithful rendering of the landscape itself—preserving the signature landforms, contours, compositional layers, and atmospheric character of the reference (the shape of the mountains, the flow of water, the silhouette of the skyline, the form of the buildings, the distribution of vegetation, etc.) so that it reads at a glance as the same place or scene. Football-themed elements may be woven naturally into the landscape as low-relief, non-competing accents—a single football resting or rolling in the foreground, a faint suggestion of goalposts in the distance, pitch lines drawn into the edge of the scene, soft motion trails, or a patch of grass subtly hinting at pitch texture—but these elements must serve the landscape rather than replace it, and no kicking human or animal may appear anywhere. Vary the camera framing and viewpoint across generations as well—wide angle, close detail, top-down, eye-level, backlit silhouette—rather than a uniform postcard view. The colors of the landscape itself should follow the vivid saturated palette rules below. The entire figure is fully colored—no part of the subject is left as bare relief or uncolored sculpt. Skin and hair use natural human tones from the reference (where the subject is human). Use a bright, vivid, saturated color palette throughout—rich reds, blues, yellows, greens, oranges, and warm earthy tones—the kit should feel lively and visually striking. Every clothing piece (jersey, shorts, socks, boots) carries a clear distinct color, mixed and matched into a complete, intentionally designed outfit. (This clothing clause applies to human subjects; for animal and landscape subjects, apply the same vivid saturated palette principles to their own coloration instead.) Dress the human subject in a plain, generic football kit. The kit must not display any sponsor logos, team crests, brand marks, or jersey numbers, and must not resemble the iconic colorways or stripe patterns of well-known national teams or clubs (e.g., avoid the obvious Brazil yellow-and-green combo, Argentina's blue-white vertical stripes, England's red-on-white cross, Germany's black-white-red, or similar instantly recognizable national kits). The medal body, decorative motifs, and rim are also fully colored, drawing from the same vivid palette, with rim, background field, and subject colors all visually distinct from one another. Inside the inner ring, suggest a stylized football pitch and a few football-themed motifs—ball, grass, motion lines, sparkles—rendered as lower-relief supporting elements that don't compete with the subject, each in their own clear color. The outer rim carries a modern engraved geometric pattern inspired by contemporary sport graphic design, in a light contrasting tone—never gold, never dark. The relief retains its full three-dimensional surface modeling—gentle highlights along raised edges and soft self-shading along recessed areas give every form clear sculptural depth and tactile presence. However, the figure casts no shadow onto the medal background, and the medal itself casts no shadow onto the pure white surface beneath—the composition floats cleanly with no projected shadows anywhere. Clean smooth render, illustration clarity. No sponsor logos, brand marks, team crests, tournament logos, national flags, or text anywhere in the composition.\",\"soccer_keychain_depth_map_prompt\":\"Create a high-fidelity grayscale depth map based on the exact geometry and composition of the first image, treating the first image as the sole source of all structure, composition, border/frame design, scale, and positioning. Do not change any structure or detail of the first picture, and adding or deleting any structural elements of the badge design is strictly prohibited, except for any text characters which must be completely removed. Changing the border style of the badge is prohibited, and the badge border must come exclusively from the first image and must never be replaced, mixed, or substituted with the border of the second or third reference images; do not add, invent, duplicate, or wrap any additional border, outer ring, rim, bezel, frame, mat, or concentric circle around the badge that does not already exist in the first image — the badge's outermost edge and the exact number of border layers must match the first image precisely, and no second outer ring may appear outside the original one. Strictly maintain the exact scale, relative proportions, and spatial positioning of all elements as they appear in the first image, ensuring the primary subject does not change size relative to the outer frame, the size of the primary subject relative to the outer frame is prohibited from changing in any way, and do not enlarge, shrink, zoom, crop, pad, or recenter the badge — the output must align 1:1 with the first image, with the badge occupying the exact same area within the canvas as in the first image. If there is any text or lettering on the badge border, you must completely ignore, erase, and omit these characters during depth inference, rendering the text area as a completely flat, blank, and smooth surface with absolutely no text-shaped protrusions, contours, or depressions. Map the entire scene onto a grayscale gradient: pure white represents the elements closest to the viewer (the absolute foreground), smoothly transitioning through varying shades of gray for mid-ground layers（note that the non-patterned parts around the subject must have no gradient gray values）, down to pure black for the furthest background plane, and do not invert this depth convention under any circumstances. Every single part of the background outside of the badges must be 100% solid, pure black without any gray artifacts, and must never be white, gray, or a half-white/half-black mixture; the area outside the badge is the farthest plane and is therefore pure black, never the foreground; the depth map must contain only the circular badge, so everything outside the badge's circular outline must be pure black with a hard, clean edge and no soft gray halo, glow, gradient, ambient occlusion, outline, or bleed; do not render the badge as a physical object resting on a base, stand, pedestal, platform, mount, or support, and no white or gray base, plinth, shadow, or added structure may appear beneath or around the badge. The effect of the depth map refers to the second and third reference maps, and only refers to the effect of their depth maps (their depth-encoding and tonal mapping only), do not refer to anything else, and never take their subject, composition, decorations, or border. Specifically, ensure that the defined structural and compositional details of the primary subject in the first image, such as small feature contours, are clearly rendered and distinct in depth, integrated into the overall volumetric form, rather than being smoothed away. Small, intricate features and structural definition on the primary subject should be distinguishable. The intricate details of the frame from the first image are rendered in appropriate gray gradients. Preserve all other geometric details, presenting them as clean, non-textured, purely geometric volumes without any original surface textures, cast shadows, or colored lighting artifacts. The background outside the badges must be a solid, deep black, prohibited for white or any non-black gray values.\",\"soccer_keychain_depth_map_reference_image_urls\":[\"https://cdn.meshy.ai/webapp-assets/creative-lab/soccer-keychain/depth-map-reference/ref-1.png\",\"https://cdn.meshy.ai/webapp-assets/creative-lab/soccer-keychain/depth-map-reference/ref-2.png\"],\"twist_egg_colorize_character_prompt\":\"Create one single centered cute chibi human-inspired roly-poly egg tumbler toy based on the provided reference images.\\n\\nUse case: stylized-concept\\nAsset type: polished collectible toy render, white background\\n\\nInput image roles:\\n- Image 1 is the only human identity reference. Use it only for visible head traits, hairstyle, simplified face cues, upper-body clothing, worn upper-body accessories, outfit colors, and empty upper-body hand placement.\\n- Any images after Image 1 are egg-form/style references only. Use them only for egg proportion, top hair wrap, lower outfit wrap, short rounded hands, glossy toy material, 1:1 product framing, relief thickness, and overall roly-poly construction.\\n- Do not copy identity, gender, face, hair color, beard, clothing color, watch, pose details, or personal traits from style-reference images unless they are also visible in Image 1.\\n\\nCanvas and framing:\\n- Exact 1:1 square image.\\n- Centered product composition.\\n- Full toy visible with even padding on all four sides.\\n- White background, no crop, no portrait canvas, no landscape canvas.\\n\\nCore object:\\n- Generate one object only: a continuous plump ovoid egg-shaped tumbler toy, taller than wide, with a heavy rounded base.\\n- The complete egg silhouette must stay dominant, intact, smooth, rounded, and unmistakably egg-like.\\n- The top of the egg body is the head region itself. Do not attach a separate head, mascot head, hood, collar ring, neck, doll torso, or full character body.\\n- The head and body must be one seamless continuous egg shell. Do not create any visible seam, split line, horizontal joint, neck ring, collar-divider band, or upper-shell/lower-shell separation.\\n\\nThree-zone wrap structure:\\n- Hair wraps the top dome of the egg like a sculpted cap bonded to the shell.\\n- The natural skin-tone face area is a smooth convex part of the upper-front egg surface.\\n- Clothing wraps the lower dome, lower sides, and visible bottom-most curve of the egg like a fitted outfit skin.\\n- These zones must follow one continuous ovoid surface.\\n\\nFace surface rule:\\n- The face area must be flush with the egg curvature or slightly convex, never sunken.\\n- Do not create a recessed face panel, inset face window, cutout cavity, concave mask area, raised border frame around the face, vertical side grooves beside the face, or a face sitting inside a hollow opening.\\n- Skin-tone face area must remain natural where visible. Do not flood the face with clothing color, even for high-neck garments.\\n\\nHair requirements:\\n- Hair must cover and protect the top silhouette of the egg.\\n- Do not make a small hair patch sitting on a human head.\\n- Make the hairstyle a large raised cap, shell, or cluster that hugs the top dome and upper side edges.\\n- Hair must follow the visible hairstyle volume and rhythm from Image 1.\\n- Convert hair into rounded sculpted panels, bead-like curls, wave plates, or chunky hair relief depending on Image 1.\\n\\nReference traits to preserve through abstraction:\\n[Describe Image 1 traits: gender / skin tone / hairstyle / hair volume / glasses / beard / expression / upper clothing / accessories / upper-body hand pose]\\n\\nHead, hair, and face-symbol priorities:\\n[Describe Image 1 head and hair details: bang direction, curl rhythm, short hair flow, glasses shape, beard, nose ring, earrings, etc.]\\n- Convert face details into tiny separated enamel symbols: small eye marks, tiny mouth mark, optional glasses frames only if visible, optional beard or mustache relief only if visible.\\n- Keep the expression cute and readable, but do not build a complete realistic face panel.\\n- No realistic portrait, realistic nose, realistic lips, or skin pores.\\n\\nClothing requirements:\\n- Clothing must wrap the bottom half, lower sides, lower dome, and visible bottom-most curve of the egg as a smooth garment layer.\\n- Do not leave any unrelated bare egg cap below the clothing.\\n- The lowest visible part of the egg, including the rounded weighted base and contact-side curve, must be covered by the outfit color or outfit texture.\\n- No exposed skin-tone or bare shell-colored strip below the clothing.\\n- No separate naked base cap under a shirt.\\n- If a base ring is visible, it must be the same garment color family and continue the garment texture or seam language.\\n\\nClothing priorities:\\n[Describe Image 1 clothing details: neckline, collar, lapels, buttons, cuffs, knit texture, T-shirt graphic, shirt layering, straps, accessories, colors]\\n- Clothing should wrap the egg like a tight toy outfit.\\n- Broad garment color fields are allowed, including ribbed shirts, sweaters, suit jackets, and T-shirts covering the egg body.\\n- Preserve clothing identity clearly through large wrapped color fields plus raised details: collars, necklines, lapels, buttons, cuffs, seams, ribbing, knit texture, shirt layering, straps, watches, bracelets, sleeve patches, and visible upper-garment color blocks.\\n- The garment lower surface should continue to the lowest visible curve, with ribbing, fabric grooves, jacket color, shirt color, knit texture, or garment-colored base shading reaching the bottom.\\n- Clothing must still read as the reference upper clothing, not pants, skirt, shorts, legs, or waist-down anatomy.\\n\\nSeamless transition requirement:\\n- The highlight, shadow, curvature, and material continuity of the egg must flow smoothly across the face-to-clothing transition.\\n- Do not draw a dark crack, recessed groove, cut line, shadow gap, black outline, capsule split, cup rim, bowl lip, or mechanical joint between the skin-tone face area and the wrapped outfit.\\n- The outfit edge may be visible only as a soft molded fabric lip fused to the shell, with rounded thickness and gentle color transition.\\n- It must never look like the top edge of a container holding the head.\\n- A collar, crew neck, high neck, lapel, or shirt rim may exist as clothing detail, but it must read as raised garment relief sitting on the egg surface, not as a structural joint in the egg shell.\\n\\nHand pose:\\n[Describe Image 1 hand pose: hand on cheek, crossed arms, raised hand, hands near chest, etc.]\\n- Hands must be short, rounded, puffy mitten-like toy forms attached to the shell.\\n- Hands must be empty. No object in the hands.\\n- Hands must not grip, pinch, pull, carry, touch, or lean on straps, handles, clothing accessories, cups, phones, rails, bags, laptops, books, or any other prop.\\n- If the reference hand touches a prop or background object, reinterpret it as an empty hand resting on the shell or hovering near the chest or cheek.\\n\\nRelief and surface:\\n- At least 80 percent of the visible shell must contain sculpted relief, raised panels, grooves, bands, shell plates, button stamps, stitching ridges, ribbed garment zones, hair chunks, and small rounded accents.\\n- Use clear relief hierarchy: large head / hair / clothing panels first, medium seam and band structure second, small beads / grooves / buttons / stamps last.\\n- Every decorative element must feel physically embossed or carved into the hard shell, with rounded edges, soft shadows, and visible thickness.\\n- Avoid flat painted stickers, blank shell zones, sparse markings, and thin fragile protrusions.\\n\\nStrict exclusions:\\n- No background extraction: no walls, sky, trees, shelves, books, laptop, table, railing, bottles, scenery, studio color backdrop, text, dates, watermark, photo border, or environmental objects.\\n- No lower-body extraction: no pants, shorts, skirts, belts, hips, thighs, legs, knees, feet, shoes, sandals, or full-body pose.\\n- No hard head-body split, no detachable lower cup, no doll torso, no structural capsule joint, no straight horizontal cut where the face ends and clothing begins.\\n- No dark crevice under the collar, no incised neckline groove, no black outline between skin and clothing, no cup mouth around the face, no \\\"head sitting inside clothes\\\" look.\\n- Avoid the bad P2-like style: no small human head protruding above a big shirt cup, no exposed separate head sitting inside clothing, no ordinary chubby mascot body, no doll-like torso with sleeves and arms dominating the egg.\\n- Do not leave hair as a tiny patch on top; do not leave clothing as only a mid-body shirt band.\\n- Hair must wrap the top dome, clothing must wrap the bottom dome.\\n- Do not leave clothing as a floating shirt band above a visible bare egg bottom. The bottom dome must be clothed.\\n- No handheld props and no items touching the hands.\\n- No realistic portrait, photorealism, plush, fabric, fur, wool, gemstones, jewels, crystals, pearls, baroque filigree, sharp spikes, scary style, or mascot costume.\\n\\nMaterial and render:\\n- Smooth hard collectible object made of glossy polished resin, enamel, ceramic, or toy-grade vinyl.\\n- Rounded toy lighting.\\n- Soft contact shadow directly underneath.\\n- White background.\\n- Centered product render.\\n- No text.\",\"twist_egg_colorize_character_reference_image_urls\":[\"https://cdn.meshy.ai/webapp-assets/creative-lab/twist-egg/ref-image/4.png\",\"https://cdn.meshy.ai/webapp-assets/creative-lab/twist-egg/ref-image/5.png\"],\"twist_egg_colorize_other_prompt\":\"Create the image only. Use the provided reference image as the only visual source for design inspiration. Generate ONE ornate fantasy dragon egg inspired by the reference image.\\n\\nThe output must be a dragon egg first:\\n- Exactly one upright dragon egg, centered in a square 1:1 image.\\n- Full egg visible with generous even white space around it.\\n- Continuous oval egg silhouette, taller than wide, slightly fuller at the bottom, stable and rounded.\\n- Seamless pure white studio background only, soft contact shadow.\\n- No scene, no table, no room, no cave, no nest, no packaging, no frame, no text, no watermark.\\n\\nReference extraction rule:\\n- Extract only visible design language from the reference image: main colors, color distribution, silhouette rhythm, contour language, material feeling, surface patterns, texture rhythm, structural divisions, iconic parts, holes, buttons, seams, grooves, panels, edges, highlights, wear marks, decorative details, and recognizable small components.\\n- Do not recreate the original subject as an object, product, character, face, animal, plant, statue, food item, vehicle, building, furniture, logo, or mascot.\\n- The reference-derived elements must be transformed into dragon egg decoration: raised plaques, thick relief motifs, scale panels, carved grooves, inset medallions, charm-like attached ornaments, rimmed badges, short bands, texture zones, repeated small symbols, dot rows, tabs, capsules, and rounded inlays.\\n- Some recognizable parts from the reference may appear as small decorative charms or thick relief ornaments attached to the egg surface, but they must remain secondary to the egg shape and conform to the egg curvature.\\n- No long protruding parts, no fragile rods, no wings, no limbs, no sharp spikes, no realistic attached object.\\n\\nDragon egg structure:\\n- The shell must include visible dragon-scale structure, but it must not be only plain scales.\\n- Dragon scales are a supporting base layer; reference-derived motifs are the main decorative language.\\n- Cover at least 80% of the visible shell with organized decoration.\\n- Avoid large empty smooth areas.\\n- Avoid one oversized reference element dominating the egg.\\n- Use a balanced mix of medium motifs, small repeated motifs, and tiny texture details.\\n- Keep the design rich, ornate, luxurious, and visually dense, but controlled and symmetrical enough to feel collectible.\\n\\nOrnament hierarchy:\\n- Large layer: reference-inspired color zones, curved armor panels, major scale bands, broad rimmed plaques.\\n- Medium layer: iconic reference-derived motifs, thick relief badges, inset panels, charm-like parts, nested rounded shapes, decorative bands.\\n- Small layer: fine grooves, dot rows, tiny studs, micro medallions, repeated short marks, texture clusters, raised seams, rim details.\\n- Every ornament should look molded, carved, embossed, inlaid, or attached as rounded enamel/resin/ceramic relief, not printed flat graphics.\\n\\nMaterial and finish:\\n- Premium hard collectible material: polished resin, enamel, ceramic glaze, or vinyl toy finish.\\n- Smooth pearlescent clearcoat over the whole egg, with nacre-like broad iridescent highlights following the curved surface.\\n- Thick high relief: chunky raised motifs, rounded bevels, visible sidewalls, deep shadowed gaps, double raised rims, inset grooves, layered shell plates.\\n- Use glossy and satin contrast to suggest material differences, but keep everything as a hard fantasy egg surface.\\n- Absolutely no glitter, no sparkles, no metallic flakes, no random star particles, no dust, no grainy speckles.\\n\\nAbstraction balance:\\n- Do not make the design too abstract or generic.\\n- Preserve enough reference identity through color rhythm, distinctive shapes, surface details, and small iconic components.\\n- Do not make it too literal: the egg must not turn into the reference subject.\\n- If the reference contains a face, person, animal, character, mask, or portrait, break those features into abstract decorative fragments; do not recreate eyes, mouth, nose, expression, body, limbs, or face layout.\\n- If the reference contains text, logo, label, brand, or watermark, ignore it completely and replace it with abstract unreadable marks, short lines, badges, or geometric inlays.\\n\\nStrict exclusions:\\nNo readable text, no letters, no numbers, no logo, no brand mark, no watermark, no realistic face, no eyes, no mouth, no person, no animal body, no mascot, no character body, no limbs, no original object replica, no product photography, no realistic scene, no jewelry setting, no glitter, no fragile protrusions.\\n\\nFinal look:\\nA single centered ornate fantasy dragon egg, richly decorated with reference-inspired elements, thick sculptural relief, layered dragon scales, pearl-glazed hard collectible surface, luxurious but cute, bright soft studio lighting, white background.\",\"twist_egg_colorize_pet_prompt\":\"Use the uploaded reference image only as inspiration for a cute pet egg design. Do not generate the full subject, portrait, full face, body, pose, or photo. Imagine an egg that belongs to the reference pet or animal. The result must be an egg first, not an animal head, mascot, or character.\\n\\nCreate one centered cute pet egg. The egg body must be plump, smooth, rounded, and clearly three-dimensional. The complete ovoid egg silhouette must stay dominant, intact, and unmistakable.\\n\\nExtract the species, breed, and individual pet traits strictly from the uploaded reference image. Do not invent unrelated features. Preserve the visible breed-level cues through abstraction: exact color distribution, face-mask shape, ear shape, eye color, nose color, mouth or tiny tooth cue if visible, body color contrast, distinctive markings, coat pattern rhythm, fur-length impression, and recognizable pet expression. If a trait is not visible in the reference, do not add it.\\n\\nConvert those traits into cute, simple, readable pet-egg features: broad color blocks, large markings, rounded patches, mask-shaped panels, small separated eye-color symbols, tiny nose-color emblems, cheek-color dots, tiny rounded tooth marks only if visible, small embossed stamps, shell bands, embossed icons, soft coat-flow relief, and chunky texture zones. The animal identity must be the primary visual subject. The design should clearly suggest the exact species, breed, and pet type at first glance, while remaining abstract and egg-like. Pet identity must come mainly from color distribution, markings, ear or wing silhouette, fur or feather texture, and species-specific pattern rhythm, not from a full facial expression. Avoid a generic cartoon cat, generic round animal face, or unrelated cute mascot look.\\n\\nFor Siamese or colorpoint cats, keep the breed-specific cream shell with warm gray-brown point markings, gray mask shape, gray ears, blue eye symbols, dark nose cue, and subtle pale body contrast. Do not shift the animal markings into saturated blue, fantasy colors, or unrelated palettes unless those colors are clearly present on the pet.\\n\\nUse the visible photo background only as low-priority support after the pet identity is clear. Extract at most a few simple background cues, such as accent colors, fabric or woven textures, soft geometric forms, repeated patterns, and material hints. Transform them into subtle attached shell bands, raised patches, stamps, grooves, or texture blocks that frame and support the pet-derived design. Do not recreate the actual room, furniture, scene, text, photo border, or background objects literally. Do not make a random collage or patchwork of unrelated decorations.\\n\\nAnimal ears may appear as small, rounded, sturdy three-dimensional protrusions attached to the upper shell. They must be short, thick, and integrated into the egg silhouette, not a full animal head. Whiskers, strands, and other thin structures must not protrude outward; convert them into shallow raised or engraved curved lines that cling tightly to the shell surface.\\n\\nDo not arrange two eyes, a nose, mouth, cheeks, whiskers, and teeth into a complete front-facing animal face. Avoid symmetrical full-face layouts, large central face masks with eyes and mouth, smiling animal faces, muzzle panels, animal head panels, or a pet head attached to the egg. Use facial cues only as small separated symbols or abstract markings distributed on the shell.\\n\\nThe egg shell must be densely covered with complex raised relief ornamentation; this is a hard requirement. Avoid a simple, plain, clean, or mostly smooth surface. At least 80 percent of the visible shell should contain sculpted relief, embossed forms, raised panels, grooves, bands, stamps, or chunky texture. The front, sides, top, and lower area must all have visible decoration, with no large blank zones. Use many organized chunky ornament families at the same time: large raised color panels, thick embossed breed symbols, mask panels, eye-color icons, nose marks, tiny tooth marks if visible, small embossed stamps, curved grooves, shell bands, nested rounded patches, soft fur-flow or feather-flow bands, repeated raised texture blocks, background-inspired texture zones, small secondary relief accents, border ridges, dotted raised beads, carved channels, and layered shell plates. Build clear relief hierarchy: large pet-derived shapes first, medium decorative bands second, then many smaller rounded relief accents filling the remaining spaces. Every decorative element must be physically sculpted or embossed into the shell, with visible height, rounded edges, soft shadows, and a tactile toy-like surface. The result should feel ornate, busy, and richly carved while still coherent and pet-led. Avoid empty shell areas, sparse markings, flat painted patterns, minimalist designs, simple toy surfaces, mostly smooth surfaces, random assembly, visual clutter without hierarchy, unrelated mixed motifs, full animal heads, or large face panels replacing the egg form.\\n\\nAvoid designs where the egg becomes a squat round mascot, a chubby animal figurine, or a full animal head inside a thick hood or collar. Do not let a giant circular face, head ring, scarf-like rim, large limbs, tail, muzzle, mouth, or body parts dominate the front. Keep the ovoid egg body taller than it is wide, with pet features integrated as markings and small relief accents rather than a complete animal face or body.\\n\\nThe design should feel charming, toy-like, collectible, and pet-inspired. The material must feel like a smooth hard collectible object, such as polished resin, enamel, ceramic, or toy-grade vinyl. Avoid plush, fuzzy, furry, fabric, stuffed-toy, wool, soft-pile material, realistic portrait, full body, actual face, animal head, human figure, complex luxury ornament, baroque patterns, filigree, sharp spikes, fragile parts, flat sticker look, scary monster style, photorealism, overly realistic sculpture, gemstones, jewels, crystals, faceted stones, cabochons, and pearl material. White background.\\n\\nUse only image 1 as the subject reference for pet identity, breed traits, colors, and markings. Images 2, 3, and 4 are style references only. Use them only for egg proportion, hard toy material, relief thickness, ornament density, rounded sculpted surface, and overall egg-design language. Do not extract or transfer any pet identity from images 2, 3, or 4: ignore their species, breed, face, eyes, nose, mouth, beak, ears, wings, limbs, tail, fur color, feather color, body color, markings, expression, and animal-specific details. All pet features, colors, markings, species, and breed cues must come only from image 1. If style-reference images conflict with image 1, image 1 always wins.\",\"twist_egg_colorize_pet_reference_image_urls\":[\"https://cdn.meshy.ai/webapp-assets/creative-lab/twist-egg/ref-image/1.png\",\"https://cdn.meshy.ai/webapp-assets/creative-lab/twist-egg/ref-image/2.jpg\",\"https://cdn.meshy.ai/webapp-assets/creative-lab/twist-egg/ref-image/3.jpg\"],\"vinyl_figure_prototype_prompt\":\"Generate an image with the \\\"vinyl collectible figure\\\" theme. Follow these instructions: The first image is the subject: use it as the structural and shape reference. Apply the exact artistic style, color palette, materials, and lighting from the remaining 4 reference image(s) as the visual style. The final image must match the style references perfectly while preserving the subject's structure.\\n\\nSTYLE SPECIFICATION (must be satisfied):\\n\\nCHARACTER PROPORTIONS:\\n- Head height equals body height (1:1 ratio)\\n- Square head with rounded edges (NOT spherical, NOT cubic)\\n- Short stubby body with minimal articulation\\n- Standing upright in neutral, frontal pose\\n\\nFACE (CRITICAL):\\n- Keep the face simple, cute, and toy-like. Prefer minimal mouth, nose, and eyebrow detail.\\n- Prefer large dot eyes or similarly minimal vinyl-style eyes.\\n- A mostly blank face with two simple dark eyes is preferred, unless a small detail is needed to preserve the subject identity.\\n\\nOUTFIT \u0026 ACCESSORIES:\\n- Preserve the subject's clothing, hair, and key accessories from the input photo\\n- Simplify hair into smooth solid color blocks (no individual strands)\\n- Simplify clothing patterns into flat color blocks (no fine prints, no gradients)\\n\\nFULL-BODY COMPLETION:\\n- Always create a complete head-to-toe figurine with torso, hips, legs, feet, and shoes visible\\n- If the input is cropped, bust-only, waist-up, or missing legs, infer a simple coordinated lower-body outfit that matches the visible clothing.\\n- Add appropriate pants, shorts, skirt, socks, and shoes as needed; never leave the lower body missing, blank, skin-colored, or undressed.\\n\\nMATERIAL \u0026 FINISH:\\n- Prefer a matte vinyl plastic surface; avoid glossy reflections and skin texture.\\n- Prefer solid color blocks, high contrast, and minimal soft shading.\\n- Use studio product lighting with a soft shadow under the figure.\\n\\nCOMPOSITION:\\n- Three-quarter front view, full figure visible\\n- Isolated on plain white background\\n- Centered, ample whitespace around the figure\\n- Allow each generation to explore a slightly different pose, silhouette, outfit simplification, or accessory emphasis while preserving the subject identity.\\n\\nNEGATIVE / AVOID:\\n- Realistic anatomy, detailed facial features\\n- Glossy reflections, photorealistic skin\\n- Chibi anime style, big sparkling eyes with pupils\\n- Mouth, nose, eyebrows, ears with detail\\n- Missing, cropped, blank, skin-colored, or undressed lower body\\n- Brand markings, logos, text on the figure\\n- Cluttered background, props, scenery\",\"vinyl_figure_prototype_reference_image_urls\":[\"https://cdn.meshy.ai/webapp-assets/creative-lab/vinyl-figure/ref-image/1.png\",\"https://cdn.meshy.ai/webapp-assets/creative-lab/vinyl-figure/ref-image/2.png\",\"https://cdn.meshy.ai/webapp-assets/creative-lab/vinyl-figure/ref-image/3.png\",\"https://cdn.meshy.ai/webapp-assets/creative-lab/vinyl-figure/ref-image/4.png\"],\"keycap_head_prototype_prompt\":\"Transform the subject in the reference image into a 3D-rendered ultra-cute chibi sculpture in Pop Mart blind box / Nendoroid style — a HEAD-AND-SHOULDERS bust cropped cleanly at the shoulder line. Render the oversized chibi head (including ears, hair or fur, muzzle or beard, and any headwear) together with the neck, the collar / neckline, and the tops of the shoulders, then crop straight across at shoulder level. Do NOT include the chest below the shoulders, the arms, hands, waist, legs, props, or any base or stand.\\n\\nIDENTITY — HIGHEST PRIORITY: faithfully preserve the reference subject's distinctive identity so the result is instantly recognizable as the SAME individual, whether a person or an animal, just rendered as a chibi toy. Keep its exact skin or fur coloring, patterns and markings, its characteristic hair or ear shape, length and placement, its real eye color, its nose, muzzle, mouth and beard shape, and its overall facial structure and the proportions between features. Stylize the material and roundness, NOT the identity — do not replace the subject's features with generic doll features.\\n\\nKawaii styling (applied lightly, on top of the preserved identity): large expressive round eyes with bright catchlights and glossy pupils that KEEP the subject's own eye color, tiny button nose, small soft smile, plump rounded baby cheeks with a gentle pink blush, smooth clean surfaces. Cute Q-version proportions with a slightly enlarged head, clean bold shapes, high-quality vinyl toy material with a smooth semi-matte finish.\\n\\nNECK AND SHOULDERS: keep the subject's own neckline down to the top of the shoulders, derived faithfully from the reference — for a clothed person, include the visible collar, tie or garment neckline and the upper shoulders of that garment in its own colors and fabric; for an animal, include the neck-and-chest fur and the shoulder fur in the animal's own colors and markings; if nothing usable is visible, a simple neckline in the subject's dominant color. Keep this portion compact and clearly SUBORDINATE to the head: the oversized head stays the dominant visual subject and the cropped shoulders are only a small hint that stays narrower than the head's widest point — the head must NOT sit on broad realistic shoulders.\\n\\nPROPORTION: the oversized chibi head is the dominant mass; the shoulders are a small cropped hint beneath it, so the silhouette reads as a big head with just a suggestion of shoulders — not a realistic wide-shouldered bust, not an elongated or egg-shaped lower body.\\n\\nVIEW AND HEAD TILT: front view, camera facing the subject directly with no left/right rotation. The HEAD is tilted upward about 30 degrees — chin lifted, face angled slightly up toward the viewer for a cute looking-up expression — while everything BELOW the neck (neck, collar, shoulders) stays vertical and upright, squarely facing the camera. Only the head tilts up on the neck; the shoulders do NOT lean back. Keep the NECK SHORT — the chin sits close to the collar with minimal neck length showing, so the lifted head reads as a compact chibi, not a long-necked figure.\\n\\nBOTTOM: the bust is cropped cleanly and FLATLY straight across the shoulder line, and that flat shoulder-level cut is the LOWEST part of the sculpture, forming a clean base-less flat bottom. Absolutely NOTHING beneath it and nothing grown below it: no keycap, no keyboard key, no trapezoid stand, no bust stand, no display block, no pedestal block, no disc, no plate, no platform, no plinth, no pedestal, no rim, no ring, no ball, no sphere, no rounded lower body, no egg-shaped mass, no flared skirt and no widened base of any kind. The shoulders are simply sliced off flat and the sculpture rests directly on that flat cut. No dangling parts, no floating pieces.\\n\\nBACKGROUND — IMPORTANT: completely REPLACE the reference image's background. Regardless of the reference's original background color, the background MUST be a seamless, pure white (#FFFFFF) studio backdrop with normal white balance — no colored, teal, green, blue, dark, gradient or textured background, no environment, no table and no floor texture.\\n\\nColor treatment: base the subject's colors faithfully on the reference image, then enrich them slightly — a vivid palette with clean crisp color separation and no muddy blending, colors that pop against the white background, while NEVER overriding the subject's real colors and markings.\\n\\nRealistic cinematic lighting with the key light from the upper side, casting a soft natural drop shadow directly onto the pure white ground (#FFFFFF). Commercial-grade product photography masterpiece, ultra HD quality, 1:1 aspect ratio.\\n\\nNegative prompt: full figure, chest below shoulders, torso, waist, arms, hands, elbows, legs, feet, props, broad realistic shoulders, wide-shouldered bust, lower body, egg shape, oval body, elongated body, rounded lower half, belly, ball, sphere, spherical body, second rounded lobe, base, round disc base, circular platform, plinth, coin-shaped pad, flared skirt base, pedestal, stand, socket, colored background, teal background, green background, blue background, dark background, gradient background, textured wall, environment, table, floor, text, generic doll face, altered skin or fur color, changed markings, wrong hair or ear shape, realistic adult facial proportions, washed-out colors, dull muted palette, keycap, keyboard key, keyboard keycap under the bust, trapezoid stand, trapezoid block, bust stand, display stand, display block, pedestal block, riser, mounting block\",\"keycap_head_composite_prompt\":\"Take the chibi head-and-shoulders bust sculpture from the reference image and keep its DESIGN exactly — the same character with identical facial features, identical colors, identical proportions and identical expression; do not redraw, restyle, resize or recolor it; the only permitted change is viewing it from the new camera angle described below. Mount it on top of a single 1u mechanical-keyboard artisan keycap base: a compact square base with a 1:1 footprint and gently tapered flat sides (slightly narrower at the top than at the bottom), Cherry-profile height — the base is clearly shorter than the head, roughly half of the head's height. The bust sits sunk slightly INTO the base's top surface, its width close to the base's width and flush with or slightly overhanging the base's top edge, so the two merge seamlessly into ONE solid sculpted artisan keycap: a smooth continuous transition at the junction, no visible seam, no gap, no ledge, no floating parts. Base color: paint the base's body in ONE clean color taken from the head's DOMINANT color family — the head's main color or a shade very close to it (slightly lighter or darker is fine); NEVER a contrasting or complementary color, so the whole keycap reads as a single cohesive collectible piece. Base decoration: the bust in the reference image already ends in its own neckline and cropped shoulders (a collar, garment neckline or neck-and-chest fur in the subject's own colors) with a flat cut at the shoulder line; keep that lower portion EXACTLY as designed — same shape, same colors — and seat the flat shoulder-line cut into the base's top surface so the neckline meets the base's top edge and the two interlock, fusing bust and base into one piece; do NOT add any new or second motif to the base. Keep the junction minimal and clean: the bust's existing neckline is the ONLY decoration, with large simple shapes that stay readable on an 18mm keycap, concentrated near the junction with the head, so the base still reads as mostly one solid color; no busy patterns, no fine fragmented details, no text. The base keeps the same smooth semi-matte vinyl toy finish as the head. Camera: a precise, FIXED macro product shot from a three-quarter top-down-side view — the camera raised approximately 45 degrees above the keycap's eye level, positioned in front of the keycap and rotated just slightly to one side, looking down at it (the classic artisan-keycap product-photo angle), so the top of the head, the face, and two tapered side faces of the base are all visible; the face remains fully visible, recognizable and looking toward the camera; the keycap is centered and fills most of the frame with a shallow, comfortable margin. Use EXACTLY this same fixed camera for the render — no other angle. Lighting and background: realistic cinematic key light from the upper side, a soft natural drop shadow cast onto the seamless pure white background ground (#FFFFFF), minimalist pure white backdrop with no environment, no keyboard and no table texture. The finished keycap rests flat on the ground plane. Commercial-grade product photography masterpiece, ultra HD quality, 1:1 aspect ratio. Negative prompt: altered face, changed facial features, different character, redrawn or restyled head, changed head colors, missing neckline, duplicated collar, second collar, chest below the shoulders, arms, legs, full figure, keyboard, other keycaps, key switch, switch stem, cross mount, fingers, hands, text, logo, letters, contrasting base color, complementary base color, busy cluttered base decoration, multiple motifs, background scenery, props, eye-level flat front view, straight-on front view, extreme top-down view, bottom-up view, side profile view, back view.\",\"keycap_head_texture_prompt\":\"Color this chibi head sculpture to match the HEAD in the reference image exactly. The reference image shows the head mounted on a decorated keycap base — that base is NOT part of this model: reproduce only the head's own colors, patterns and features, and do not paint the base's body color or the base's decoration (collar, tie, necklace or similar) onto the head. Ultra-cute chibi vinyl toy paint: vivid, generous palette with bold saturated hues and strong contrast between adjacent color regions, crisp clean color separation, glossy sparkling eyes with bright catchlights, gentle pink blush on the cheeks, smooth toy-grade finish.\",\"keycap_head_texture_fused_prompt\":\"Paint this keycap — a cute chibi head mounted on a mechanical-keyboard keycap base, fused into one solid piece — to match the reference image exactly. Reproduce the head's own colors, patterns and facial features faithfully, and paint the keycap base in the coordinated color the reference shows (the head's dominant color family), so the whole piece reads as one cohesive collectible. Keep the head↔base junction a smooth continuous transition with no seam or color break. Ultra-cute chibi vinyl toy paint: vivid, generous palette with bold saturated hues and strong contrast between adjacent color regions, crisp clean color separation, glossy sparkling eyes with bright catchlights, gentle pink blush on the cheeks, smooth toy-grade finish across the entire model.\"},\"group\":\"default\",\"rule_id\":\"default\",\"is_device_based\":false,\"secondary_exposures\":[],\"id_type\":\"userID\",\"passed\":false},\"1575368771\":{\"name\":\"1575368771\",\"value\":{},\"group\":\"targetingGate\",\"rule_id\":\"targetingGate\",\"is_device_based\":false,\"secondary_exposures\":[{\"gate\":\"2108358495\",\"gateValue\":\"false\",\"ruleID\":\"default\"}],\"id_type\":\"userID\",\"is_user_in_experiment\":false,\"is_experiment_active\":true},\"1587738927\":{\"name\":\"1587738927\",\"value\":{},\"group\":\"prestart\",\"rule_id\":\"prestart\",\"is_device_based\":false,\"secondary_exposures\":[],\"id_type\":\"userID\",\"is_user_in_experiment\":false,\"is_experiment_active\":false},\"1609565474\":{\"name\":\"1609565474\",\"value\":{\"general_nsfw\":0.9,\"yes_realistic_nsfw\":0.9,\"yes_sexual_intent\":0.9,\"general_suggestive\":2,\"yes_nazi\":0.9,\"yes_terrorist\":0.9,\"yes_kkk\":0.9,\"very_bloody\":0.9,\"yes_self_harm\":0.9},\"group\":\"1Eg3kTCvGJPzwYmpRO7D3d:0.00:1-1Eg3kRXterG5dyOugGbZKb\",\"rule_id\":\"1Eg3kTCvGJPzwYmpRO7D3d:0.00:1-1Eg3kRXterG5dyOugGbZKb\",\"is_device_based\":false,\"secondary_exposures\":[],\"id_type\":\"userID\",\"passed\":false},\"1628287975\":{\"name\":\"1628287975\",\"value\":{},\"group\":\"prestart\",\"rule_id\":\"prestart\",\"is_device_based\":false,\"secondary_exposures\":[],\"id_type\":\"userID\",\"is_user_in_experiment\":false,\"is_experiment_active\":false},\"1650230606\":{\"name\":\"1650230606\",\"value\":{},\"group\":\"prestart\",\"rule_id\":\"prestart\",\"is_device_based\":false,\"secondary_exposures\":[{\"gate\":\"3468227902\",\"gateValue\":\"false\",\"ruleID\":\"default\"}],\"id_type\":\"userID\",\"is_user_in_experiment\":false,\"is_experiment_active\":false},\"1655212282\":{\"name\":\"1655212282\",\"value\":{\"enabled\":true},\"group\":\"launchedGroup\",\"rule_id\":\"launchedGroup\",\"is_device_based\":false,\"secondary_exposures\":[],\"group_name\":\"Test\",\"id_type\":\"userID\",\"is_user_in_experiment\":false,\"is_experiment_active\":false},\"1706828797\":{\"name\":\"1706828797\",\"value\":{\"domains\":[\"gmail.com\",\"googlemail.com\",\"outlook.com\",\"hotmail.com\",\"hotmail.fr\",\"hotmail.co.uk\",\"hotmail.it\",\"live.com\",\"msn.com\",\"outlook.jp\",\"yahoo.com\",\"ymail.com\",\"rocketmail.com\",\"yahoo.co.jp\",\"yahoo.co.uk\",\"icloud.com\",\"me.com\",\"mac.com\",\"privaterelay.appleid.com\",\"protonmail.com\",\"proton.me\",\"pm.me\",\"zoho.com\",\"zohomail.com\",\"aol.com\",\"mail.com\",\"email.com\",\"usa.com\",\"mail.org\",\"gmx.com\",\"gmx.net\",\"gmx.us\",\"gmx.fr\",\"gmx.de\",\"yandex.com\",\"yandex.ru\",\"comcast.net\",\"verizon.net\",\"att.net\",\"cox.net\",\"charter.net\",\"earthlink.net\",\"juno.com\",\"sbcglobal.net\",\"bellsouth.net\",\"t-online.de\",\"web.de\",\"free.fr\",\"orange.fr\",\"wanadoo.fr\",\"laposte.net\",\"sfr.fr\",\"libero.it\",\"tiscali.it\",\"virgilio.it\",\"btinternet.com\",\"sky.com\",\"virginmedia.com\",\"ntlworld.com\",\"126.com\",\"163.com\",\"sina.com\",\"sohu.com\",\"139.com\",\"yeah.net\",\"naver.com\",\"daum.net\",\"nate.com\",\"189.cn\",\"qq.com\",\"foxmail.com\",\"mail.ru\",\"rambler.ru\",\"fastmail.com\",\"rediffmail.com\",\"inbox.com\",\"wp.pl\",\"prodex.top\"]},\"group\":\"default\",\"rule_id\":\"default\",\"is_device_based\":false,\"secondary_exposures\":[],\"id_type\":\"userID\",\"passed\":false},\"1741425849\":{\"name\":\"1741425849\",\"value\":{},\"group\":\"layerAssignment\",\"rule_id\":\"layerAssignment\",\"is_device_based\":false,\"secondary_exposures\":[],\"id_type\":\"userID\",\"is_user_in_experiment\":false,\"is_experiment_active\":true},\"1763776624\":{\"name\":\"1763776624\",\"value\":{},\"group\":\"prestart\",\"rule_id\":\"prestart\",\"is_device_based\":false,\"secondary_exposures\":[],\"id_type\":\"userID\",\"is_user_in_experiment\":false,\"is_experiment_active\":false},\"17908