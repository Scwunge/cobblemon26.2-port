nel\":{\"MultiView\":{\"ExampleNo\":{\"Title\":\"Please avoid including multiple views or multiple objects in the same image\"},\"ExampleYes\":{\"Description\":\"Order of images does not affect the generation result\",\"Title\":\"Please upload up to 3 additional images (1-4 images in total)\"},\"Tips\":{\"MainImage\":\"The image uploaded above has the biggest impact on generation.\",\"Reference\":\"Multi-view images are used for reference only.\"}},\"Pose\":{\"GenerationFailed\":\"Pose model generation failed, please upload the image again to re-try\",\"ImageGenerationFailed\":\"Pose image generation failed, please try again \"},\"ProTooltip\":{\"Title\":\"Unlock Batch Images to 3D with our premium plan\"}},\"GeneratePanel\":{\"AutoSplit\":{\"Title\":\"Auto Split\",\"Tooltip\":\"Automatically splits your model into parts after generation. Adds +10 credits.\"},\"Confirm\":\"Confirm\",\"MultiView\":{\"Meshy4\":\"Multi-image to 3D is available only in Meshy 5.\",\"NoPrimaryImage\":\"Upload an image above to enable multi-view\",\"Title\":\"Multi-view\"},\"Submitting\":\"Creating task\",\"Title\":\"New Model\"},\"ImagePanel\":{\"AspectRatio\":\"Aspect Ratio\",\"GenerateMultiView\":{\"Disabled\":{\"Tooltip\":\"Multi-view is not available in Nano Banana\"},\"Title\":\"Generate Multi-view\"},\"ImagePromptStrength\":\"Image Strength\",\"NanoBanana\":{\"Description\":\"Nano Banana Pro is live now! Try it out for your next generation.\"},\"Prompt\":{\"Placeholder\":\"Describe the image you want to generate. You can use your native language, e.g., a cute dog/ein süßer Hund/un chien mignon/一只可爱的小狗/かわいい犬/귀여운 개.\"},\"ReferenceImage\":\"Reference Image \u003cspan\u003e(optional)\u003c/span\u003e\",\"RefinePromptDescription\":\"Automatically optimizes your prompt for 3D model generation — with clearer structure, defined angles, and simpler backgrounds. Note: it may also make the style more cartoonish or simplified.\",\"RefinePromptOff\":\"Refine Prompt - Off\",\"RefinePromptOn\":\"Refine Prompt - On\",\"TabLabel\":\"Image\",\"Title\":\"New Image\"},\"Inspiration\":{\"OverlayTitle\":\"Get More Inspiration from Community\",\"Title\":\"Inspiration\"},\"PanelWrapper\":{\"Expanded\":\"Expanded\"},\"Pricing\":{\"DiscountTooltip\":{\"Description\":\"Experience the significant leap in mesh quality with our latest AI model. Get 50% off your generation tasks. This special offer is only valid until \u003cstrong\u003eSeptember 30, 2025\u003c/strong\u003e.\",\"Discount\":\"50% OFF\",\"Title\":\"Meshy 6: 50% Off Launch Offer!\"}},\"PrintPanel\":{\"Model\":\"Print\"},\"RemeshPanel\":{\"DisabledReason\":\"Please select a model to remesh.\",\"SupportedModels\":\"Please select a \u003ci\u003emodel\u003c/i\u003e or \u003ci\u003etextured model\u003c/i\u003e to \u003cb\u003eRemesh\u003c/b\u003e\",\"Title\":\"Remesh\"},\"StylizePanel\":{\"SupportedModels\":\"Please select a \u003ci\u003etextured model\u003c/i\u003e to \u003cb\u003eStylize\u003c/b\u003e\",\"Title\":\"Stylize\"},\"TexturePanel\":{\"DeLightingStrength\":{\"Medium\":\"Medium\",\"None\":\"None\",\"Strong\":\"Strong\"},\"ImageInput\":\"Image Input\",\"Model\":\"Model\",\"Resolution2KTip\":\"Generate base color at 2K (2048×2048) resolution for faster generation.\",\"Resolution4KTip\":\"Generate base color at 4K (4096×4096) resolution for higher detail.\",\"Resolution8KTip\":\"Generate base color at 8K (8192×8192) resolution for next-level detail with exceptionally rich textures.\",\"SupportedModels\":\"Please select a \u003ci\u003emodel\u003c/i\u003e or \u003ci\u003etextured model\u003c/i\u003e to \u003cb\u003eTexture\u003c/b\u003e\",\"TextInput\":\"Text Input\",\"Texture\":\"Texture\",\"TextureResolution\":\"Texture Resolution\",\"Title\":\"Texture\"},\"UploadPanel\":{\"Cancel\":\"Cancel\",\"Confirm\":\"Continue\",\"Instructions\":{\"Alignment\":\"Alignment \u0026 Positioning\",\"AlignmentContent\":\"\u003cul\u003e\u003cli\u003eMake sure that the model is facing the correct front axis in your modeling software.\u003c/li\u003e\\n\u003cli\u003eFor best results, the model needs to be centered at world origin.\u003c/li\u003e\u003c/ul\u003e\",\"Content\":\"\u003cul\u003e\\n\u003cli\u003eRemove any non-mesh elements, such as cameras and lights, from the model file.\u003c/li\u003e\\n\u003cli\u003eRemove any animations and shape keys from the model file.\u003c/li\u003e\\n\u003cli\u003eMake sure that the model is facing the correct front axis in your modeling software.\u003c/li\u003e\\n\u003cli\u003eWe recommend to only include 1 mesh in the model file. If the file contains multiple meshes, they will be merged after uploading.\u003c/li\u003e\\n\u003cli\u003eFor best results, the model needs to be centered at world origin.\u003c/li\u003e\\n\u003cli\u003eWhen Keep Original Texture and UV is turned on, please make sure that the model only contains 1 material and 1 UV map after merging the objects. UV islands cannot overlap or shared among multiple parts of the model.\u003c/li\u003e\\n\u003c/ul\u003e\",\"Structure\":\"Structure \u0026 Content\",\"StructureContent\":\"\u003cul\u003e\u003cli\u003eRemove any non-mesh elements, such as cameras and lights, from the model file.\u003c/li\u003e\\n\u003cli\u003eRemove any animations and shape keys from the model file.\u003c/li\u003e\\n\u003cli\u003eWe recommend to only include one mesh in the model file. If the file contains multiple meshes, they will be merged after uploading.\u003c/li\u003e\u003c/ul\u003e\",\"Texture\":\"Texture \u0026 UV Requirements\",\"TextureContent\":\"\u003cul\u003e\u003cli\u003eWhen Keep Original Texture and UV is turned on, please make sure that the model only contains 1 material and 1 UV map after merging the objects.\u003c/li\u003e\\n\u003cli\u003eUV islands cannot overlap or be shared among multiple parts of the model.\u003c/li\u003e\u003c/ul\u003e\",\"Title\":\"Upload instructions:\"},\"KeepOriginalTexture\":\"Keep Original Texture and UV\",\"ModelName\":\"Model Name\",\"ModelNamePlaceholder\":\"Give your model a name\",\"ModelUploadGuideContent\":\"\u003cp\u003eWe recommend to only include 1 mesh in the model file. If the file contains multiple meshes, they will be merged after uploading.\u003c/p\u003e\u003cp\u003eFor best results, the model needs to be centered at world origin.\u003c/p\u003e\u003cp\u003eAny materials or textures in the uploaded model will be ignored.\u003c/p\u003e\u003cp\u003eBefore uploading, please make sure that the model is facing the correct front axis in your modeling software.\u003c/p\u003e\u003cp\u003eTo use existing UV maps in your model:\u003c/p\u003e\u003cul\u003e\u003cli\u003eTurn on the \\\"Use Original UV\\\" switch.\u003c/li\u003e\u003cli\u003ePlease make sure that the model only contains 1 material and 1 UV map.\u003c/li\u003e\u003cli\u003ePlease also make sure that UV islands do not overlap and is not shared among multiple parts of the model.\u003c/li\u003e\u003c/ul\u003e\",\"ModelUploadGuideTitle\":\"Model Upload Guide\",\"Title\":\"Upload\",\"Tooltip\":\"Upload your own model\"},\"VoteModel\":{\"Title\":\"Vote Model\",\"Tooltip\":\"Vote Models and Earn up to {credits} Credits Every Day!\"}},\"PrintPanel\":{\"AddBase\":\"Add Base\",\"AutoSplit\":\"Auto Split\",\"AutoSplitDisabledHint\":\"Select a Meshy-generated clay model to split.\",\"AutoSplitDisabledHintTopology\":\"Smart Topology models aren't supported yet.\",\"Cost\":\"Cost\",\"FormNowPrintAndShip\":\"Form Now Print \u0026 Ship\",\"MultiColorPrint\":\"Multi-Color Print\",\"MultiColorPrintDisabledHint\":\"Please select a textured model to proceed\",\"PostProcessing\":\"Post-Processing\",\"SelectModel\":\"Select Model / Textured Model to Print\",\"SendToPrinter\":\"Send to Printer\"},\"Publish\":{\"Action\":\"Publish\",\"AutoDetectedFromTags\":\"Auto-detected from tags\",\"Categories\":{\"Default\":\"Category\",\"Error\":\"Please select at least 1 categories\"},\"ContentRestrictions\":{\"Title\":\"Content restrictions\",\"Tooltip\":\"If the model contains age-restricted content, please enable this option before publishing. If not enabled and the model is later classified as age-restricted by a moderator, it will be removed.\"},\"Description\":\"Description\",\"ErrorMsg\":{\"DescriptionTooLong\":\"Please enter a description with less than 1024 characters\",\"TitleTooLong\":\"Please enter a title with less than 48 characters\"},\"Guidelines\":{\"AgreeTips\":\"Agree to \u003clinks\u003e\u003c/links\u003e\",\"Link\":\"Community Guidelines\",\"Tips\":\"By publishing you  agree to the \u003ctermsOfUseLink\u003e\u003c/termsOfUseLink\u003e, \u003clicenseLink\u003e\u003c/licenseLink\u003e and \u003ccommunityGuidelinesLink\u003e\u003c/communityGuidelinesLink\u003e.\"},\"License\":{\"Default\":\"License\",\"Description\":\"Your project becomes open source, allowing others to copy, modify, and distribute it as they see fit.\",\"Link\":\"License\"},\"NSFW\":\"Age Restricted Content\",\"Subcategories\":{\"Default\":\"Subcategory\"},\"SuccessMessage\":\"Published successfully. You can now view your model in the community.\",\"Tags\":{\"Add\":\"Add tags\",\"AddAll\":\"Add All\",\"AutoSelected\":\"Auto-selected\",\"Default\":\"Tags\",\"Error\":\"Please select at least 1 tag\",\"MaxCountError\":\"The maximum number of tags that can be added is 30\",\"SeoHint\":\"Well-chosen tags help your model appear on the right pages and reach more viewers.\",\"Suggested\":\"Suggested tags (\u003ctag\u003e{addAll}\u003c/tag\u003e):\",\"ValidError\":\"Only lowercase characters and numbers are supported\",\"ValidSketchfabError\":\"Only letters and numbers are supported\"},\"TermsOfUse\":{\"Link\":\"Terms of Use\"},\"Tips\":{\"BeforePublishing\":\"Better thumbnails increase the chances of your work being featured!\"},\"Title\":\"Title\",\"Toast\":{\"Error\":\"Fail to publish\",\"Forbidden\":\"You don't have permission to publish this model.\",\"ModelVersionTooOld\":\"This model version is too old for draft publishing. Please regenerate with a newer model.\",\"NotSupporte