\":{\"Title\":\"Invite New Members\",\"Tooltip\":\"Input email to invite new users not yet in the organization\"},\"SelectMembersFromOrganization\":\"Select Members From Organization\",\"SubmitText\":\"Create Workspace\",\"Title\":\"Create a New Workspace\",\"WorkspaceName\":\"Workspace Name\"},\"CreatedOn\":\"Created on\",\"DataRetention\":{\"CancelButton\":\"Cancel\",\"ConfirmButton\":\"Continue\",\"ConfirmMessage\":\"Please confirm you'd like to update data retention period. Please note that assets that are deleted can never be recovered. Click Confirm to continue.\",\"ConfirmTitle\":\"Confirm Data Retention\",\"Description\":\"Automatically delete data after a specified number of days. When disabled, data will be retained indefinitely.\",\"DisableConfirmMessage\":\"When data retention is turned off, your data will be kept indefinitely unless manually deleted. You can change this setting at any time.\",\"DisableConfirmTitle\":\"Turn Off Data Retention\",\"RetentionPeriod\":\"Retention period (days)\",\"RetentionPeriodHint\":\"Enter a value between 1 and 30 days.\",\"Title\":\"Data Retention\",\"ValidationError\":\"You may only set a whole number between 1 and 30 days inclusive\"},\"Expired\":{\"Desc\":{\"Description1\":\"Please renew and upgrade to keep the team benefits.\"},\"GotIt\":\"Got it\",\"Renew\":\"Renew Studio Plan\",\"Title\":\"Your Studio Plan is about to expire in {days} {days, plural, one {day} other {days}}.\"},\"IPFiltering\":{\"Description\":\"Block prompts or images that contain known third-party IP.\",\"Title\":\"Enable IP Filtering\"},\"IntentIntro\":{\"Feature1\":\"Streamline your creative workflow and increase team productivity.\",\"Feature3\":\"Manage your team with user access control and centralized billing.\",\"Feature4\":\"Shared member benefits, better pricing, and priority customer support.\",\"Title\":\"Empower Your Business with Teams\",\"UpgradeToStudio\":\"Upgrade to Studio\",\"UpgradeToStudioTooltip\":\"You’re currently using a {payMethod} subscription, which doesn’t support the Studio plan. If you’d like to upgrade to the Studio plan, please contact support@meshy.ai.\"},\"Invitation\":{\"Pending\":\"Pending\"},\"InvitationError\":\"This user cannot be added, please try again later.\",\"InvitationHandler\":{\"Error\":\"Fail to join team\",\"Success\":\"Joined team successfully\"},\"InviteByEmail\":\"Email\",\"InviteByEmailDescription\":\"Each new seat adds \u003cstrong\u003e{monthlyPrice} per month\u003c/strong\u003e (or \u003cstrong\u003e{yearlyPrice} per year\u003c/strong\u003e if billed annually). Billing starts once the member accepts the invitation. If the invitation is accepted mid-billing cycle, the charge will be prorated based on the remaining days.\",\"InviteFailed\":\"Invitation sending failed.\",\"InviteLimitReached\":\"You've reached the invite limit. Please contact sales for an upgrade.\",\"InviteMembers\":\"Invite Members\",\"InviteResendFailed\":\"Invitation sending failed.\",\"InviteResent\":\"Invitation sent successfully.\",\"InviteSuccess\":\"Invitation sent successfully.\",\"JoinDialog\":{\"Close\":\"Close\",\"Description\":\"Joining a team will cancel your personal subscription (no charges for the next billing cycle). Are you sure you want to continue?\",\"LeaveTeamTips\":{\"Description\":\"You’re already part of another team. Please leave your current team before joining a new one.\",\"Title\":\"Unable to Join Team\"},\"Submit\":\"Confirm to join\",\"Title\":\"Your personal plan will be canceled\"},\"ManageMembersDialog\":{\"Action\":{\"Error\":\"Failed to update workspace members. Please try again later.\",\"NotChanged\":\"Please modify the role of at least one member.\",\"Success\":\"Successfully updated workspace members.\"}},\"MemberAlreadyInTeam\":\"This user is already in the team.\",\"MemberAlreadyInvited\":\"The user has been invited and does not need to be added again.\",\"MemberIsSuspended\":\"This user is already in the team, please activate.\",\"MemberLimitExceeded\":\"You've reached the invite limit. Please contact sales for an upgrade.\",\"MemberList\":{\"Email\":\"Email\",\"Joined\":\"Joined\",\"Me\":\"Me\",\"Name\":\"Nickname\",\"Role\":\"Role\",\"SearchMembers\":\"Search Members\"},\"MemberMenu\":{\"Activate\":\"Activate user\",\"CopyInviteLink\":\"Copy invite link\",\"DowngradeToMember\":\"Downgrade to member\",\"Leave\":\"Leave\",\"LeaveDialog\":{\"Submit\":\"Leave\",\"Title\":\"Leave {name}\"},\"ResendInvite\":\"Resend Invite\",\"Suspend\":\"Suspend user\",\"SuspendDialog\":{\"Description\":\"Are you sure you want to continue?\",\"Title\":\"Suspend \\\"{username}\\\"\"},\"SwitchOwner\":\"Switch owner\",\"UpgradeToAdmin\":\"Upgrade to admin\"},\"Members\":{\"Suspended\":\"Suspended\",\"Title\":\"Team Members\"},\"NSFWFiltering\":{\"Description\":\"Block prompts or images that contain NSFW (not safe for work) content.\",\"Title\":\"Enable NSFW Filtering\"},\"OtherOrgSettings\":{\"Title\":\"Other Org Settings\"},\"OtherTeamSettings\":{\"Title\":\"Other Team Settings\"},\"Overview\":{\"Member\":\"{count, plural, =0 {No members yet} =1 {# Member} other {# Members}}\"},\"PlanEnded\":\"Plan expired\",\"PlanEnds\":\"Plan ends on\",\"RenameDialog\":{\"Description\":\"Please input 4-32 valid characters (English letters, hyphen, underscore, or numbers)\",\"DescriptionHelper\":\"{n} / {max} characters\",\"DescriptionLabel\":\"Description\",\"EditOrgInfo\":\"Edit Organization\",\"EditTeamInfo\":\"Edit Team Info\",\"EditWorkspaceInfo\":\"Edit Workspace\",\"Fail\":\"Fail to rename team\",\"NameHelper\":\"Supported characters (4–32)\",\"OrgName\":\"Organization Name\",\"Save\":\"Save\",\"SaveFail\":\"Failed to save changes\",\"SaveSuccess\":\"Changes saved\",\"Submit\":\"Rename\",\"Success\":\"Team renamed successfully\",\"TeamName\":\"Team Name\",\"Title\":\"Rename Team\",\"Trigger\":\"Rename Team\"},\"Role\":{\"Admin\":\"Admin\",\"Member\":\"Member\",\"Owner\":\"Owner\"},\"RoleFull\":{\"Admin\":\"Team Admin\",\"Member\":\"Team Member\",\"OrgAdmin\":\"Org Admin\",\"OrgMember\":\"Org Member\",\"OrgOwner\":\"Org Owner\",\"Owner\":\"Team Owner\"},\"SeatsUsed\":\"Seats Used\",\"SendInvites\":\"Send Invitation\",\"SwitchOwnerDialog\":{\"Failed\":\"Switch owner failed, Please try again later.\",\"Success\":\"Switch owner successfully!\",\"title\":\"Switch Owner\"},\"WorkspaceList\":{\"Admins\":\"Admins\",\"Archive\":\"Archive\",\"ArchiveDialog\":{\"Description\":\"Are you sure you want to continue?\",\"Title\":\"Archive {name}\"},\"Archived\":\"archived\",\"Description\":\"Description\",\"ManageMembers\":\"Manage members\",\"Members\":\"Members\",\"Name\":\"Name\",\"Restore\":\"Restore\"}},\"Workspace\":{\"AssetPublishing\":{\"Description\":\"Enable publishing of assets for your workspace to the Meshy community. Disabling will not allow any public sharing of your assets.\"},\"InviteMembers\":{\"Error\":\"Failed to invite members. Please try again later.\",\"NotChanged\":\"Please select at least one member to update.\",\"Submit\":\"Save\",\"Success\":\"Members invited successfully.\"},\"LeaveFailed\":\"Fail to leave\",\"MemberMenu\":{\"Leave\":\"Leave workspace\"},\"Members\":{\"Title\":\"Workspace Members\"},\"Placeholder\":{\"Title\":\"You haven’t created a workspace yet.\"},\"RoleFull\":{\"WorkspaceAdmin\":\"Workspace Admin\",\"WorkspaceMember\":\"Workspace Member\"}}},\"Showcase\":{\"Tag\":{\"AdultContent\":\"Adult Content\",\"All\":\"All\",\"AllCategories\":\"All Categories\",\"Animals\":\"Animals\",\"AnimeManga\":\"Anime \u0026 Manga\",\"Architecture\":\"Architecture\",\"ArtAbstract\":\"Art \u0026 Abstract\",\"Characters\":\"Characters\",\"CultureHistory\":\"Culture \u0026 History\",\"Electronics\":\"Electronics\",\"FantasyMythology\":\"Fantasy \u0026 Mythology\",\"FashionStyle\":\"Fashion \u0026 Style\",\"FoodDrink\":\"Food \u0026 Drink\",\"FurnitureHome\":\"Furniture \u0026 Home\",\"Gaming\":\"Gaming\",\"Music\":\"Music\",\"NaturePlants\":\"Nature \u0026 Plants\",\"PlacesTravel\":\"Places \u0026 Travel\",\"SciFi\":\"Sci-Fi\",\"ScienceTechnology\":\"Science \u0026 Technology\",\"SportsFitness\":\"Sports \u0026 Fitness\",\"Vehicles\":\"Vehicles\",\"WeaponsMilitary\":\"Weapons \u0026 Military\"}},\"SimplifiedPaywall\":{\"Actions\":{\"SeeAllPlans\":\"See all plans\"},\"Benefits\":{\"CreditsResetTooltip\":\"Plan credits reset monthly and do not accumulate\",\"Premium\":{\"ConcurrentTasks\":\"\u003cb\u003e30\u003c/b\u003e concurrent tasks\",\"CreativeLabDesign\":\"Creative Lab \u003cb\u003e4 free\u003c/b\u003e design / day\",\"CreativeLabDesignTooltip\":\"The first 4 Creative Lab designs each day do not require credits, saving up to 720 credits per month.\",\"Credits\":\"\u003cb\u003e3,000\u003c/b\u003e monthly credits (up to 300 assets)\",\"EarlyAccess\":\"Early access to new features\",\"QueuePriority\":\"\u003cb\u003eHigher\u003c/b\u003e queue priority\",\"Retries\":\"\u003cb\u003e12\u003c/b\u003e free retries per task\",\"ShippingCoupon\":\"Creative Lab \u003cb\u003e$30\u003c/b\u003e free shipping coupon\",\"ShippingCouponTooltip\":\"Free shipping on orders for customized products: 2 × $15 off shipping fees, available in select countries and region: United States, United Kingdom, Germany, South Korea, France, Türkiye, Brazil, Canada, Italy, Japan, Spain, Australia, Poland, Mexico, China, Netherlands, Switzerland, Ukraine, Israel, Sweden, Hong Kong, Belgium, Czechia, Austria.\",\"Speed\":\"\u003cb\u003e80% faster\u003c/b\u003e generation speed\"},\"PremiumHeading\":\"What's included in Premium\",\"Pro\":{\"AdvancedTools\":\"\u003cb\u003eAdvanced generation tools\u003c/b\u003e\",\"AdvancedToolsTooltip\":\"Batch generation, multi-view image to 3D, Text to Image, Remesh, Rig, AI texture editing\",\"ConcurrentTasks\":\"\u003cb\u003e10\u003c/b\u003e concurrent tasks\",\"Credits\":\"\u003cb\u003e1,000\u003c/b\u003e monthly credits\",\"DccBridge\":\"\u003cb\u003eFull DCC bridge\u003c/b\u003e\",\"ImageGeneration\":\"\u003cb\u003eUnlimited\u003c/b\u003e image generation with Nano Banana Pro\",\"ImageGenerationTooltip\":\"Pro and above users can enjoy unlimited daily access by using credits. Free users can generate 4 images daily.\",\"LowPoly\":\"\u003cb\u003eLow Poly\u003c/b\u003e (early access)\",\"McpSkill\":\"\u003cb\u003eMCP \u0026 Skill\u003c/b\u003e for AI agents\",\"ModelDownloads\":\"\u003cb\u003eUnlimited\u003c/b\u003e 3D model downloads\",\"PrivateLicense\":\"\u003cb\u003ePrivate license\u003c/b\u003e for all assets\",\"Retries\":\"\u003cb\u003e4 free retries\u003c/b\u003e per task\",\"Speed\":\"\u003cb\u003e60% faster\u003c/b\u003e generation speed\"},\"ProHeading\":\"Pro includes the following advanced features:\",\"Studio\":{\"ApiPlayground\":\"Limited \u003cb\u003eAPI Playground\u003c/b\u003e access\",\"ApiRetention\":\"\u003cb\u003eAPI\u003c/b\u003e asset retention\",\"CentralizedBilling\":\"\u003cb\u003eCentralized billing\u003c/b\u003e across team\",\"ConcurrentTasks\":\"\u003cb\u003e20\u003c/b\u003e concurrent tasks\",\"Credits\":\"\u003cb\u003e4,000\u003c/b\u003e monthly credits (up to 400 assets)\",\"EverythingInPro\":\"Everything in Pro, plus:\",\"QueuePriority\":\"\u003cb\u003eHigher\u003c/b\u003e queue priority\",\"Retries\":\"\u003cb\u003e8 free retries\u003c/b\u003e per task\",\"Speed\":\"\u003cb\u003e60% faster\u003c/b\u003e generation speed\",\"TeamManagement\":\"\u003cb\u003eTeam management\u003c/b\u003e \u0026 shared team credits\"},\"StudioHeading\":\"Studio includes the following advanced features:\",\"Ultra\":{\"CreativeLabDesign\":\"Creative Lab \u003cb\u003e12 free\u003c/b\u003e design / day\",\"CreativeLabDesignTooltip\":\"The first 12 Creative Lab designs each day do not require credits, saving up to 2,160 credits per month.\",\"QueuePriority\":\"\u003cb\u003eHighest\u003c/b\u003e queue priority\"}},\"Copy\":{\"Agent\":{\"Title\":\"3D Creation is just one chat. Subscribe {plan} to unlock the \u003cb\u003eWorld's First 3D AI Agent\u003c/b\u003e\"},\"Ar\":{\"Title\":\"See your model in your space — subscribe {plan} for \u003cb\u003eAR Preview\u003c/b\u003e\"},\"AutoRepair\":{\"Title\":\"Make your model 3D-printable — subscribe {plan} for \u003cb\u003eAI Auto-Repair\u003c/b\u003e\"},\"AutoSplit\":{\"Title\":\"Break models into separate parts — subscribe {plan} for \u003cb\u003eSplit 3D Model\u003c/b\u003e\"},\"BatchImageTo3d\":{\"Title\":\"Turn multiple images into 3D models at once — subscribe {plan} for \u003cb\u003e{count}+ concurrent tasks\u003c/b\u003e\"},\"CommunityDownload\":{\"Title\":\"Any community model anytime — subscribe {plan} for \u003cb\u003eUnlimited downloads\u003c/b\u003e\"},\"ConcurrentTask\":{\"Title\":\"Generate in parallel — subscribe {plan} for \u003cb\u003e{count}+ concurrent tasks\u003c/b\u003e\"},\"DccBridge\":{\"PluginTitle\":\"Send to Blender, Unity, Maya \u0026 more — subscribe {plan} for \u003cb\u003eFull DCC Bridge\u003c/b\u003e\",\"PrintTitle\":\"Export to Bambu, Cura, OrcaSlicer \u0026 Creality — subscribe {plan} for \u003cb\u003eFull DCC Bridge\u003c/b\u003e\",\"Title\":\"Export to Blender, Unity, Bambu Studio \u0026 more — subscribe Pro for \u003cb\u003eFull DCC Bridge\u003c/b\u003e\"},\"Download\":{\"Title\":\"Your 3D model is ready — subscribe {plan} for \u003cb\u003eUnlimited model downloads\u003c/b\u003e\"},\"Fallback\":{\"Title\":\"Your model deserves more — subscribe {plan} to unlock everything.\"},\"FileConverterBatch\":{\"Title\":\"Convert dozens of files at once — subscribe {plan} for \u003cb\u003ebatch conversion\u003c/b\u003e\"},\"HdTexture\":{\"Title\":\"Sharp 4K textures — subscribe {plan} for \u003cb\u003eHD Texture quality\u003c/b\u003e\"},\"ImageToVideo\":{\"Title\":\"Animate images into videos — subscribe {plan} for \u003cb\u003ecinematic AI video generation\u003c/b\u003e\"},\"License\":{\"Title\":\"Protect your creations — subscribe {plan} for \u003cb\u003ePrivate license \u0026 exclusive ownership\u003c/b\u003e\"},\"MeshResize\":{\"Title\":\"Scale your model to any custom size — subscribe {plan} for \u003cb\u003eresizing\u003c/b\u003e\"},\"MultiView\":{\"Title\":\"Get more accurate 3D models — subscribe {plan} for \u003cb\u003eMulti-View generation\u003c/b\u003e\"},\"Pose\":{\"Title\":\"Generate characters in any pose — subscribe {plan} for \u003cb\u003eA / T / Custom Pose\u003c/b\u003e\"},\"Remesh\":{\"Title\":\"Optimize any mesh — subscribe {plan} for \u003cb\u003eRemesh with custom polycounts\u003c/b\u003e\"},\"RemoveBackground\":{\"Title\":\"Clean background, better 3D — subscribe {plan} for instant \u003cb\u003eBackground Removal\u003c/b\u003e\"},\"Retry\":{\"Title\":\"Not happy with the result? Subscribe {plan} for \u003cb\u003e{count}+ free retries\u003c/b\u003e per task\"},\"Rig\":{\"Title\":\"Bring your model to life — subscribe {plan} for \u003cb\u003eAuto-Rigging\u003c/b\u003e\"},\"TextToImage\":{\"Title\":\"Subscribe {plan} for \u003cb\u003eUnlimited AI image generation\u003c/b\u003e with Nano Banana Pro, GPT Image 2 \u0026 more\"}},\"Dialog\":{\"A11yDescription\":\"Subscribe to unlock this feature.\"},\"Plan\":{\"BillingCycleGroup\":\"Billing cycle\",\"Monthly\":\"Monthly\",\"Savings\":\"Save {amount}\",\"ThenPerMonth\":\"then {price} / month\",\"UnitFirstMonth\":\"/ first month\",\"Yearly\":\"Yearly\",\"YearlyBillingSubtext\":\"Billed yearly - {price} today\"},\"Promo\":{\"EndsIn\":\"Ends in\",\"SeeDetails\":\"See details\"},\"TierToggle\":{\"MostPopular\":\"Most Popular\"},\"Visual\":{\"AfterAlt\":\"{featureName} after\",\"Agent\":{\"FeatureName\":\"AI Agent\"},\"Ar\":{\"FeatureName\":\"AR Preview\"},\"AutoRepair\":{\"FeatureName\":\"AI Auto-Repair\"},\"AutoSplit\":{\"FeatureName\":\"Split 3D Model\"},\"BatchImageTo3d\":{\"FeatureName\":\"Batch image to 3D\"},\"BeforeAlt\":\"{featureName} before\",\"CommunityDownload\":{\"FeatureName\":\"Community downloads\"},\"ConcurrentTask\":{\"FeatureName\":\"Concurrent tasks\"},\"DccBridge\":{\"FeatureName\":\"DCC Bridge\"},\"Download\":{\"FeatureName\":\"HD downloads\"},\"FileConverterBatch\":{\"FeatureName\":\"Batch conversion\"},\"Free\":\"Free\",\"HdTexture\":{\"FeatureName\":\"HD Texture\",\"HdLabel\":\"4K HD Texture\",\"NormalLabel\":\"Normal Texture\"},\"ImageToVideo\":{\"FeatureName\":\"Image to video\"},\"License\":{\"FeatureName\":\"Private license\"},\"MeshResize\":{\"FeatureName\":\"Real-world scale\"},\"MultiView\":{\"FeatureName\":\"Multi-View input\"},\"Pose\":{\"FeatureName\":\"Game-ready poses\"},\"ProFeatureBadge\":\"Pro · {featureName}\",\"ProFeatureFallback\":\"Pro feature\",\"Remesh\":{\"FeatureName\":\"Adaptive Remesh\",\"OriginalLabel\":\"Original — 100K Faces\",\"RemeshedLabel\":\"Remeshed — 10K Faces\"},\"RemoveBackground\":{\"FeatureName\":\"AI background removal\"},\"Retry\":{\"FeatureName\":\"Free retries\"},\"Rig\":{\"FeatureName\":\"Auto-Rigging\"},\"TextToImage\":{\"FeatureName\":\"AI image generation\"}}},\"SketchfabShare\":{\"CreditTooltip\":\"Earn 100 credits per post (max 200/day); up to 1,000 credits lifetime limit.\",\"Hint\":{\"UploadSuccessful\":\"Published successfully. You can now view your model on Sketchfab and share the link with people.\",\"UploadSuccessfulWithCredits\":\"Publish Successfully! Thank you! {credits} credits has been added into your account. You can now view your model on Sketchfab and share the link with people.\"},\"ReferralTips\":\"Earn $20! Get a free month of Pro for anyone who joins Meshy through your posted link. \u003clink\u003eLearn More\u003c/link\u003e\",\"ShareToSketchfab\":\"Publish to Sketchfab\",\"UploadFailed\":\"Failed to publish model to Sketchfab\",\"UploadSuccessful\":\"Successfully published to Sketchfab\",\"ViewModelOnSketchfab\":\"View Model on Sketchfab\"},\"Task\":{\"AddButtonText\":\"Add\",\"AddLabelPlaceholder\":\"Label Name\",\"Card\":{\"ExampleTag\":\"EXAMPLE\",\"GenerateFailedMessage\":\"Generate failed.\",\"TemplateTag\":\"TEMPLATE\",\"ThreeDToImageFailedMessage\":\"Failed\",\"ThreeDToImageInProgressMessage\":\"Generating\"},\"DefaultFailText\":\"Task failed\",\"DeleteLastImageConfirmDesc\":\"This is the last image in this generation. Deleting it will remove all related generation info.\",\"DeleteTask\":{\"ConfirmDescription\":\"Are you sure you want to delete this asset?\",\"ConfirmText\":\"Delete\",\"ConfirmTitle\":\"Confirm deletion?\"},\"Discount\":\"{rate} OFF\",\"DraftAiModelTip\":\"\u003cb\u003eMeshy 6:\u003c/b\u003e Our latest model, offering the most accurate geometry, highest level of detail, and artist-friendly stylization.\\n\\n\u003cb\u003eMeshy 5:\u003c/b\u003e Great input-to-output alignment, solid PBR material quality, and our best version in terms of watertightness.\",\"Filter\":{\"AllLabel\":\"All\",\"ModelLabel\":\"Model\",\"TexturedLabel\":\"Textured\"},\"Form\":{\"AspectRatioLabel\":\"Aspect Ratio\",\"DeprecateMeshy4Tip\":\"Meshy 4 will stop service on March 20, 2026. We recommend using Meshy 6 for the best results.\",\"DurationLabel\":\"Duration\",\"FreeCredits\":\"Remaining free credits: {amount}\",\"FreeCreditsTips\":\"Limited-time free credits for 3D to Image and Image to Video generation.\",\"Generate\":\"Generate\",\"GenerateAudioLabel\":\"Audio Generation\",\"ImageEmptyError\":\"Please select an image to generate\",\"ImageLabel\":\"Image\",\"ImageToVideo\":{\"ModelTip\":\"\u003cb\u003eVeo 3:\u003c/b\u003e Cinematic realism with natural motion, expressive detail, and high-quality audio — perfect for immersive storytelling and polished productions.\\n\\n\u003cb\u003eKling 2.5 Turbo:\u003c/b\u003e Premium video generation with cinematic visuals, ultra-fluid motion, and precise prompt alignment — delivering top-tier results at a more budget-friendly cost.\\n\\n\u003cb\u003eKling 2.1:\u003c/b\u003e Fast, stable, and consistent output — ideal for scalable content creation, rapid iteration, and efficient production workflows.\",\"PromptPlaceholder\":\"Enter text to describe the scene you want to create, the way it moves, eg: a little boy skateboarding in a park.\",\"QualityTip\":\"\u003cb\u003eStandard:\u003c/b\u003e Cost-efficient endpoint offering reliable, high-quality image-to-video generation. \\n\\n\u003cb\u003ePro:\u003c/b\u003e Professional-grade endpoint delivering high-fidelity videos, refined camera movements, and dynamic motion control—ideal for cinematic storytelling.\\n\\n\u003cb\u003eMaster:\u003c/b\u003e Premium endpoint for top-tier image-to-video generation with cinematic visuals, smooth motion, and precise prompt control.\",\"SeedanceModelTip\":\"\u003cb\u003eSeedance 2.0:\u003c/b\u003e Director-level cinematic video with multi-shot editing, real-world physics, synchronized native audio, and multimodal input support — up to 15 seconds.\\n\\n\u003cb\u003eSeedance 2.0 Fast:\u003c/b\u003e A faster, cost-efficient variant optimized for rapid iteration and high-volume production — same audio and camera control at lower latency.\\n\\n\"},\"ImageUploadInProgress\":\"Image upload in progress.\",\"InputFidelityLabel\":\"Input Fidelity\",\"ModelLabel\":\"Model\",\"PromptLabel\":\"Prompt\",\"QualityLabel\":\"Quality\",\"ReferenceLabel\":\"3D Reference\",\"ReferencesLabel\":\"Image References\",\"ResolutionLabel\":\"Resolution\",\"TextToVideo\":{\"PromptPlaceholder\":\"Enter text to describe the scene you want to create, the way it moves, eg: a  little boy skateboarding in a park.\"},\"ThreeDToImage\":{\"ExampleDesc\":\"Presets are for inspiration. Modify or mix them as you like.\",\"ExampleEnvLabel\":\"Enviroment\",\"ExampleMaterialLabel\":\"Material\",\"ExamplePrompt\":{\"Beach\":\"At the beach\",\"CinematicRealism\":\"Cinematic Realism\",\"CityStreets\":\"On city streets\",\"Epic\":\"Epic\",\"Flame\":\"Flame Material\",\"Frozen\":\"Frozen Material\",\"Gold\":\"Gold Material\",\"Grassland\":\"On the grassland\",\"Horror\":\"Horror\",\"Lava\":\"In lava\",\"MoviePoster\":\"Movie Poster\",\"Night\":\"At night\",\"RichVisual\":\"Rich Visuals\",\"Romantic\":\"Romantic\",\"Sand\":\"Sand Material\",\"Smoke\":\"Smoke Material\",\"Snowy\":\"In snowy weather\",\"Stone\":\"Stone Material\"},\"ExampleStyleLabel\":\"Style\",\"ExampleTitle\":{\"Beach\":\"Beach\",\"CinematicRealism\":\"Cinematic Realism\",\"CityStreets\":\"City Streets\",\"Epic\":\"Epic\",\"Flame\":\"Flame\",\"Frozen\":\"Frozen\",\"Gold\":\"Gold\",\"Grassland\":\"Grassland\",\"Horror\":\"Horror\",\"Lava\":\"Lava\",\"MoviePoster\":\"Movie Poster\",\"Night\":\"Night\",\"Original\":\"Original\",\"RichVisual\":\"Rich Visual\",\"Romantic\":\"Romantic\",\"Sand\":\"Sand\",\"Smoke\":\"Smoke\",\"Snowy\":\"Snowy\",\"Stone\":\"Stone\"},\"InputFidelityTip\":\"\u003cb\u003eExpressive:\u003c/b\u003e Produces more detailed and visually expressive images, but may deviate from the scene reference.\\n\\n\u003cb\u003eConsistent:\u003c/b\u003e Follows the scene reference more strictly, ensuring higher consistency.\",\"ModelTip\":\"\u003cb\u003eNano Banana:\u003c/b\u003e Fast and cost-efficient, delivering stable and consistent results. Especially strong at style transfer, enriching environments, and replacing textures or materials.\\n\\n\u003cb\u003eGPT-Image:\u003c/b\u003e Comprehensive functionality with higher visual expressiveness, suitable for refined and artistic creations. \",\"PromptPlaceholder\":\"Describe how the scene should look like. \",\"ReferencesTip\":\"Use multiple reference images and call them by number in your prompt. The first image (#1) is the default 3D reference; other images can be specified (e.g., “#2 as background”).\\n\\nFor the Nano-Banana model, please ensure all reference images have consistent aspect ratios.\"}},\"Info\":{\"AIModelLabel\":\"AI Model\",\"ClosedTitle\":\"Generation Info\",\"CreatedAtLabel\":\"Created At\",\"GenerateAudioOff\":\"Off\",\"GenerateAudioOn\":\"On\",\"Reuse\":\"Reuse\",\"ReusePrompt\":\"Reuse prompt\"},\"LicenseTip\":\"\u003cb\u003eCC BY 4.0:\u003c/b\u003e Use, share, and remix the model for any purpose, including commercial use, with attribution to the original creator and Meshy.\\n\\n\u003cb\u003ePrivate:\u003c/b\u003e The model is private, preventing any unauthorized use or sharing.\",\"LicenseTipCCBY4\":\"\u003cb\u003eCC BY 4.0:\u003c/b\u003e Use, share, and remix the model for any purpose, including commercial use, with attribution to the original creator and Meshy.\",\"LicenseTipPrivate\":\"\u003cb\u003ePrivate:\u003c/b\u003e The model is private, preventing any unauthorized use or sharing.\",\"MultiSelectText\":\"Batch Selection\",\"MultiViewFailed\":\"Failed to generate multi-view images. Please try again.\",\"MultiViewNoImage\":\"Upload an image above to generate multi-view images.\",\"NameEmptyError\":\"Please enter a name\",\"NameMaxLengthError\":\"Name exceeds the limit.\",\"NumImagesLabel\":\"Number of images\",\"PromptEmptyError\":\"Please enter a prompt to generate\",\"PromptMaxLengthError\":\"Object prompt exceeds character limit\",\"Rating\":{\"Tips\":\"How is the model quality?\"},\"ReferencesMaxCountError\":\"You have reached 5 images limit, please delete one to continue\",\"RenameTask\":{\"ConfirmText\":\"Save\",\"ConfirmTitle\":\"Rename model\",\"ErrorText\":\"Failed to rename model\",\"InputPlaceholder\":\"Enter a new name\",\"SuccessText\":\"Model renamed\"},\"SendTo\":\"Send to {name}\",\"TaskFilter\":{\"ThreeDToImageLabel\":\"Rendered Image\",\"VideoLabel\":\"Video\"},\"TaskSearch\":{\"Placeholder\":\"Search my generation\"}},\"Team\":{\"ForbiddenPublish\":{\"Mask\":\"Your team admin has disabled publishing.\"},\"Pricing\":{\"PurchaseButton\":{\"Tooltip\":{\"StudioMember\":\"Please contact admin/owner for subscription management.\",\"Title\":\"Please contact sales for subscription management.\"}}}},\"Title\":\"Panel\",\"Toast\":{\"Message\":{\"Success\":{\"CopyToClipboard\":\"Copied to clipboard\",\"ReportModelError\":\"The error message has been successfully reported\"}}},\"Tool\":{\"Interaction\":{\"Mouse\":{\"Gesture\":{\"Pan\":\"Pan\",\"Rotate\":\"Rotate\",\"Zoom\":\"Zoom\"}}}},\"ToolBar\":{\"FormNow\":{\"ConfirmClose\":{\"Cancel\":\"Cancel\",\"Close\":\"Close\",\"Description\":\"Your model is still being uploaded to Form Now. If you leave now, the upload will be canceled.\",\"Title\":\"Confirm to close the pop-up?\"},\"Info\":{\"Intro\":\"We've teamed up with Form Now, an industry-leading provider of professional 3D printing and finishing services in the United States, to streamline the printing and shipping of your Meshy assets.\",\"SingleColor\":\"Form Now currently supports \u003cbold\u003esingle-color printing\u003c/bold\u003e. Textured models will be sent without textures and can be printed in single color.\",\"Title\":\"Print Your Model\",\"USOnly\":\"Form Now only ships within the \u003clink\u003eUnited States\u003c/link\u003e at this time.\"},\"Open\":\"Open in Form Now\",\"PermissionWithLink\":\"By proceeding, you agree to \u003clink\u003eForm Now's Terms \u0026 Conditions\u003c/link\u003e.\",\"Send\":\"Send to Form Now\",\"Title\":\"Form Now 3D Print \u0026 Ship\",\"Toast\":{\"FailAndRetry\":\"Upload failed. Please try again\",\"FileTooLarge\":\"Exceeds 300MB limit. Try remeshing with fewer faces.\",\"Success\":\"Uploaded successfully\"},\"Upload\":\"Upload to Form Now\"},\"Marketiger\":{\"Button\":{\"Text\":\"Print\"},\"Cancel\":\"Cancel\",\"Info\":{\"Height\":\"Height\",\"Intro\":\"We’ve teamed up with Marketiger, an industry-leading full-color 3D printing service powered by Mimaki UV-cure technology and expert post-processing, to streamline the printing and shipping of your Meshy assets.\",\"PermissionWithLink\":\"By proceeding, you agree to \u003clink\u003eMarketiger’s Terms \u0026 Conditions\u003c/link\u003e.\",\"Tip\":\"Please note that the valid height range is 30–300 mm, and changing may affect printing costs\",\"Title\":\"Print Your Model\",\"Tooltip\":\"How to print\"},\"Send\":\"Send to Marketiger\",\"Title\":\"Full-Color 3D Print \u0026 Ship\",\"Toast\":{\"FailAndRetray\":\"Upload failed. Please try again\",\"Success\":\"Uploaded successfully\",\"Warning\":\"Please ensure your model has less than 1 million polygons to proceed\"}},\"MultiColorPrinting\":{\"Dialog\":{\"Apply\":\"Apply\",\"Cancel\":\"Cancel\",\"ClickToEdit\":\"Click to Edit\",\"Close\":\"Close\",\"ColorCount\":\"Color Count\",\"Confirm\":\"Start Processing\",\"ConfirmCloseDescription\":\"Once you close, all operations will be revoked. If you haven't downloaded your work, it will be lost.\",\"ConfirmCloseTitle\":\"Confirm to close the pop-up?\",\"ConfirmSmoothDescription\":\"Once you apply smoothing, this operation cannot be undone.\",\"ConfirmSmoothTitle\":\"Confirm to apply?\",\"CustomColors\":\"Custom Color\",\"Detailed\":\"Detailed\",\"Download\":\"Download\",\"EditSlot\":\"EDIT SLOT\",\"Estimations\":\"ESTIMATIONS\",\"Export\":\"Export .3MF\",\"FilamentSlots\":\"Filament Slots Management\",\"LevelOfDetail\":\"Level of Detail\",\"Reset\":\"Reset\",\"Slot\":\"SLOT\",\"Smooth\":\"Smooth (Low Swaps)\",\"SmoothColors\":\"Smooth Colors\",\"SmoothColorsButton\":\"Apply Smoothing\",\"SmoothColorsEnd\":\"You have already applied\",\"Tip\":\"Tip: Best results with models more than 100k faces.\",\"Title\":\"Multi-Color Printing\",\"TriggerCloseHint\":\"Click to trigger close confirmation dialog\",\"ViewMode\":{\"Original\":\"Original\",\"Processed\":\"Processed\",\"SideBySide\":\"Side By Side\"}},\"Title\":\"Multi-Color Printing\"},\"Print\":{\"Bambu\":{\"Name\":\"Bambu Studio\",\"Title\":\"Send to Bambu Studio\"},\"CrealityPrint\":{\"Name\":\"Creality Print\",\"Title\":\"Send to Creality Print\"},\"Cura\":{\"Name\":\"Ultimaker Cura\",\"Title\":\"Send to Ultimaker Cura\"},\"ElegooSlicer\":{\"Name\":\"Elegoo Slicer\",\"Title\":\"Send to ElegooSlicer\"},\"FlashStudio\":{\"Name\":\"Flash Studio\",\"Title\":\"Send to Flash Studio\"},\"Guide\":\"Guide\",\"LycheeSlicer\":{\"Name\":\"LycheeSlicer\",\"Title\":\"Send to LycheeSlicer\"},\"OrcaSlicer\":{\"Name\":\"OrcaSlicer\",\"Title\":\"Send to OrcaSlicer\"},\"Snapmaker\":{\"Name\":\"Snapmaker\",\"Title\":\"Send to Snapmaker\"}}},\"Unsubscribe\":{\"OneClick\":{\"ErrorDescription\":\"We encountered an error while trying to unsubscribe your email. Please try again later or contact support.\",\"ErrorTitle\":\"Unsubscribe Failed\",\"Processing\":\"Processing your unsubscribe request...\",\"SuccessDescription\":\"You have been successfully unsubscribed from marketing emails for:\",\"SuccessTitle\":\"Unsubscribed Successfully\"},\"Unsubscribe\":{\"Button\":\"Unsubscribe\",\"Description\":\"You’ll stop receiving email messages about Meshy’s discount promotion and release notifications. Click on \\\"Unsubscribe\\\" to stop receiving emails on this email address:\",\"Login\":\"Log In\",\"NoLoginDescription\":\"Please log in first to proceed with unsubscribing.\",\"Title\":\"Unsubscribe Email Notifications\"}},\"Video\":{\"LinkCopied\":\"Video link copied.\",\"TaskPanel\":{\"ImageToVideoLabel\":\"Image to Video\",\"TextToVideoLabel\":\"Text to Video\",\"Title\":\"Create Video\"},\"Viewer\":{\"Placeholder\":\"Please select an image or video\"}},\"Viewer\":{\"BoolTool\":{\"Actions\":{\"Download\":\"Download\"},\"Common\":{\"Apply\":\"Apply\",\"Cancel\":\"Cancel\",\"Save\":\"Save\",\"UnknownError\":\"Unknown error\"},\"Computing\":{\"Boolean\":\"Computing boolean…\",\"Generic\":\"Computing…\",\"LineCut\":\"Computing line cut…\",\"PlaneCut\":\"Computing plane cut…\"},\"Download\":{\"ExportFailed\":\"GLB export failed: {message}\"},\"Explosion\":{\"Distance\":\"Explosion distance\",\"Title\":\"Explosion\"},\"Help\":{\"Label\":\"Help\"},\"HelpPanel\":{\"Focus\":{\"BoolMode\":\"Bool mode combines the source model with a cutter mesh. Pick the main cutter first, then choose Union, Intersect, or Subtract.\",\"BoolTransform\":\"Move, Rotate, and Scale matter most here because placement defines the final boolean result.\",\"BrowseActions\":\"Download GLB, Revert Last Apply, and Start Over stay in the bottom overlay because those actions belong to the committed result.\",\"BrowseReview\":\"Browse only shows committed content. Use it to review the latest result before starting the next edit.\",\"InfinitePlane\":\"Infinite Plane is best when you want to place the cut with Move and Rotate before you inspect the sealed result.\",\"KeepOne\":\"Keep One keeps a single side of the cut. Flip Keep Side A or Keep Side B until the kept half matches your intent.\",\"LineCutInput\":\"Line Cut uses the screen-drawn segment as the main input. Draw both endpoints outside the silhouette for the cleanest result.\",\"LineCutShortcuts\":\"Hold Shift to disable angle snap temporarily, and press Esc to clear the current line without closing the dialog.\",\"SplitBoth\":\"Split Both is the full split workflow. Inspect Draft is where you review Explosion Distance before committing.\",\"Title\":\"Current Focus\"},\"Guide\":{\"Beam\":\"Beam\",\"BeamToggleLabel\":\"Toggle tutorial button beam effect\",\"DisabledIntroPrimary\":\"Turn the guide on when you want the mainline checklist for Cutter, Basic Controls, Boolean, and Browse.\",\"DisabledIntroSecondary\":\"Guide progress and the Beam preference are both stored in your browser, so the panel comes back in the same state next time.\",\"EnabledIntroPrimary\":\"This guide focuses on the main Mesh Tool paths only. You do not need to clear every branch before the tool becomes useful.\",\"EnabledIntroSecondary\":\"Click any checklist row to expand the practical explanation for that step.\",\"Hide\":\"Hide Guide\",\"Items\":{\"BoolModeEntered\":{\"Detail\":\"Switch to Bool from the Tool Mode rail when you want mesh combinations such as Union, Intersect, or Subtract instead of plane cutting.\",\"Label\":\"Open Bool mode\"},\"BoolOperationPicked\":{\"Detail\":\"Pick a primary cutter on the bottom row first, then use the long secondary buttons above it to change the boolean operation.\",\"Label\":\"Change Union / Intersect / Subtract\"},\"BrowseModeEntered\":{\"Detail\":\"Browse is the review space for committed content. It is the safest place to inspect the result without starting a new draft.\",\"Label\":\"Open Browse mode\"},\"BrowseResultReviewed\":{\"Detail\":\"After Apply Final, use Browse to check the result and the bottom overlay actions such as Download GLB, Revert Last Apply, or Start Over.\",\"Label\":\"Review a committed result in Browse\"},\"CameraProjectionExplored\":{\"Detail\":\"Orthographic makes screen-drawn cuts easier to align. Perspective is better when you need depth cues while reviewing a result.\",\"Label\":\"Try orthographic / perspective\"},\"CutterKeepFlowCompleted\":{\"Detail\":\"Choose Keep One, flip Keep Side A or Keep Side B until the correct half remains, then Apply Final to commit it.\",\"Label\":\"Finish one Keep One flow\"},\"CutterModeEntered\":{\"Detail\":\"Use the left Tool Mode rail to enter Cutter. This is the starting point for both Split Both and Keep One workflows.\",\"Label\":\"Open Cutter mode\"},\"CutterSplitFlowCompleted\":{\"Detail\":\"Choose Split Both, inspect the split, adjust Explosion Distance, then Apply Final once the separation looks correct.\",\"Label\":\"Finish one Split Both flow\"},\"CutterToolPicked\":{\"Detail\":\"Line Cut follows a segment you draw on screen. Infinite Plane uses the viewport gizmos when you want to place the cutter more precisely in 3D.\",\"Label\":\"Try Line Cut or Infinite Plane\"},\"TransformModeExplored\":{\"Detail\":\"These controls are most important when placing Infinite Plane or Bool cutters. Use them to position the cutter before you inspect.\",\"Label\":\"Try Move / Rotate / Scale\"},\"ViewStyleExplored\":{\"Detail\":\"Use the top-right View Style control to compare how the current draft or committed result reads in each supported mode.\",\"Label\":\"Switch View Style\"}},\"ProgressComplete\":\"{completed} complete\",\"RecommendedNow\":\"Recommended now\",\"Reset\":\"Reset\",\"Sections\":{\"Bool\":{\"Summary\":\"Bool is the mesh-combination workflow. It uses the same viewer but a different decision pattern.\",\"Title\":\"Boolean\"},\"Browse\":{\"Summary\":\"Browse is the review stage for committed work, exports, and last-step recovery.\",\"Title\":\"Browse\"},\"Controls\":{\"Summary\":\"These controls help you read the draft correctly before you commit anything.\",\"Title\":\"Basic Controls\"},\"Cutter\":{\"Summary\":\"Start here to learn the two main cutter flows: Split Both and Keep One.\",\"Title\":\"Cutter\"}},\"Show\":\"Show Guide\",\"Title\":\"Tutorial Guide\"}},\"InstantMenu\":{\"Apply\":\"Apply?\",\"ApplyCut\":\"Apply cut?\",\"AriaLabel\":\"Mesh Tool instant menu\",\"CutWithLine\":\"Cut with Line?\",\"CutWithPlane\":\"Cut with Plane?\",\"IntersectWithCube\":\"Intersect with Cube?\",\"IntersectWithCylinder\":\"Intersect with Cylinder?\",\"IntersectWithMortiseTenon\":\"Intersect with Mortise-Tenon?\",\"IntersectWithShape\":\"Intersect with shape?\",\"IntersectWithSphere\":\"Intersect with Sphere?\",\"SubtractCube\":\"Subtract Cube?\",\"SubtractCylinder\":\"Subtract Cylinder?\",\"SubtractMortiseTenon\":\"Subtract Mortise-Tenon?\",\"SubtractShape\":\"Subtract shape?\",\"SubtractSphere\":\"Subtract Sphere?\",\"Title\":\"Instant Menu\",\"UnionWithCube\":\"Union with Cube?\",\"UnionWithCylinder\":\"Union with Cylinder?\",\"UnionWithMortiseTenon\":\"Union with Mortise-Tenon?\",\"UnionWithShape\":\"Union with shape?\",\"UnionWithSphere\":\"Union with Sphere?\"},\"LeftRail\":{\"Actions\":{\"StartOver\":\"Start Over\",\"UndoLastApply\":\"Undo Last Apply\"},\"AriaLabel\":\"Mesh Tool left rail\",\"Camera\":{\"Orthographic\":\"Orthographic\",\"Perspective\":\"Perspective\"},\"RenderOptions\":\"Render Options\",\"StartOverDialog\":{\"Description\":\"This discards the current draft and reverts the model to its original state. Recent applies cannot be recovered.\",\"Title\":\"Start over?\"},\"Transform\":{\"Move\":\"Move\",\"Rotate\":\"Rotate\",\"Scale\":\"Scale\"}},\"ShapePicker\":{\"AriaLabel\":\"Bool Tool shape picker\"},\"Shapes\":{\"Cube\":\"Cube\",\"Cylinder\":\"Cylinder\",\"MortiseTenon\":\"Mortise-Tenon\",\"Sphere\":\"Sphere\"},\"SubOptions\":{\"BoolOperations\":{\"Intersect\":\"Intersect\",\"Subtract\":\"Subtract\",\"Union\":\"Union\"},\"CutModes\":{\"KeepOne\":\"Keep One\",\"SplitBoth\":\"Split Both\"},\"PlaneSides\":{\"KeepSideA\":\"Keep Side A\",\"KeepSideB\":\"Keep Side B\"}},\"Tools\":{\"BoolTool\":\"Bool Tool\",\"InfinitePlane\":\"Infinite Plane\",\"LineCut\":\"Line Cut\"},\"ViewCube\":{\"Back\":\"Back\",\"Bottom\":\"Bottom\",\"Front\":\"Front\",\"Left\":\"Left\",\"Right\":\"Right\",\"Top\":\"Top\"},\"ViewStyle\":{\"Basic\":\"Basic\",\"BasicDescription\":\"Accurate · takes a moment\",\"Cinematic\":\"Cinematic\",\"CinematicDescription\":\"Instant · animated · high GPU\",\"Colorful\":\"Colorful\",\"ColorfulDescription\":\"Instant preview\",\"Title\":\"View Style\"}},\"Shared\":{\"ViewerToolbar\":{\"ViewTexture\":\"View UV texture\"}},\"UvCanvas\":{\"FailedToLoad\":\"Failed to load UV data.\",\"NoPrimaryUv\":\"This model does not contain a primary UV set.\"},\"UvDebug\":{\"Reset\":\"Reset\",\"UploadGlb\":\"Upload GLB\"},\"UvInspector\":{\"DebugOverride\":\"Debug Override\",\"Title\":\"UV Inspector\"},\"UvLayoutPanel\":{\"Checker\":\"UV Checker\",\"Collapse\":\"Collapse\",\"Expand\":\"Expand\",\"Fill\":\"Island Fill\",\"HighFaceCountNotice\":\"This model exceeds the 400K-face browser UV limit. Download it and inspect UVs in a local DCC tool such as Blender.\",\"Seams3D\":\"3D Seams\",\"Title\":\"UV Layout\",\"ViewUvButton\":\"View UV\"},\"UvMaterialSelect\":{\"Placeholder\":\"Material\"},\"UvRenderToggle\":{\"BaseColor\":\"Base Color\",\"PickMapDebug\":\"Pick Map Debug\",\"Seam\":\"Seam\",\"Wireframe\":\"Wireframe\"},\"UvToolbar\":{\"DisableXRay\":\"Disable X-Ray\",\"EnableXRay\":\"Enable X-Ray\",\"Hide3DSeams\":\"Hide 3D Seams\",\"Hide3DWireframe\":\"Hide 3D Wireframe\",\"Show3DSeams\":\"Show 3D Seams\",\"Show3DWireframe\":\"Show 3D Wireframe\",\"Tools\":\"UV Tools\"}},\"Workspace\":{\"3DToImage\":{\"RenderPanel\":{\"InputFidelityHighLabel\":\"Consistent\",\"InputFidelityLowLabel\":\"Expressive\"},\"RightSider\":{\"CameraPanel\":{\"FOVLabel\":\"Field of View\",\"FrameAll\":\"Frame All\",\"FrameLabel\":\"Frame\",\"PositionLabel\":\"Position\",\"RotationLabel\":\"Rotation\",\"Title\":\"Camera\"},\"EnvironmentPanel\":{\"RotationLabel\":\"Rotation\",\"StrengthLabel\":\"Strength\"},\"GroundPanel\":{\"ColorLabel\":\"Color\",\"GridLabel\":\"Grid\"},\"ModelPanel\":{\"PositionLabel\":\"Position\",\"RotationLabel\":\"Rotation\",\"ScaleLabel\":\"Scale\",\"Title\":\"Object\",\"Tooltip\":\"Select an object to enable\"},\"ScenePanel\":{\"Environment\":\"Environment\",\"Ground\":\"Ground\",\"Title\":\"Scene\"}}},\"AIModelPicker\":{\"AIModelLabelOnlyTexture\":\"{textureAiModel} (Texture)\",\"AIModelLabelWithTexture\":\"{aiModel} (Geometry) + {textureAiModel} (Texture)\",\"Tooltip\":{\"Meshy4\":\"Our most stable model—consistently generates high-quality geometry and textures.\",\"Meshy5_1\":\"Great input-to-output alignment, solid PBR material quality, and our best version in terms of watertightness.\",\"Meshy5_3\":\"Our latest model, offering the most accurate geometry, highest level of detail, and artist-friendly stylization.\"}},\"AITexturing\":{\"ErrorMessage\":{\"Retexture\":\"Operation failed, please try again later.\"},\"Sidebar\":{\"CoachMark\":{\"Meshy6PreviewTexture\":\"Experience our latest AI texturing model - Meshy 6.\"},\"Image\":{\"Creating\":\"Creating...\",\"Remove\":\"Delete image\",\"Uploading\":\"Uploading...\"},\"Text\":{\"Style\":{\"Placeholder\":\"Describe your desired style of the object, e.g., ancient style, HDR, highest quality, ultra detailed.\"}},\"UseOriginalUV\":{\"Default\":\"Use Original UV\",\"Tooltip\":\"Uses the original UV map of the model for texturing. Please make sure that the model only contains 1 material and 1 UV map.\"}}},\"ATPoseSwitch\":{\"Tooltip\":\"Guide the AI to generate characters in standard A-Pose or T-Pose. Best for humanoid models.\"},\"Accessibility\":{\"Maximize\":\"Maximize\",\"Minimize\":\"Minimize\",\"SelectAssets\":\"Select assets\"},\"AddPlatform\":{\"AlignmentLoadingTooltip\":\"Preparing base alignment. Please try again in a moment.\",\"Close\":{\"Close\":\"Close\",\"Description\":\"Once you close, all operations will be revoked. If you haven’t downloaded your work, it will be lost.\",\"Title\":\"Confirm to close the pop-up?\"},\"CoachMark\":{\"AddStableBase\":\"Add a Stable Base to Get Better 3D Prints.\",\"Cancel\":\"Cancel\",\"GotIt\":\"Got it!\",\"SelectModel\":\"Select a \u003cspan\u003emodel\u003c/span\u003e or a \u003cspan\u003etextured model\u003c/span\u003e on the right.\"},\"CustomBase\":{\"BambuDisabledTooltip\":\"Send to Bambu is unavailable for custom bases.\",\"ConverterLoadingTooltip\":\"The selected export format is not ready yet. Please try again in a moment.\",\"DccDisabledTooltip\":\"Send To is unavailable for custom bases. Please download the files and import them manually.\",\"FormatError\":\"Please upload an FBX, OBJ, STL, GLB, or self-contained GLTF file.\",\"Upload\":\"Upload custom base\",\"UploadFailed\":\"Failed to upload custom base.\",\"Uploaded\":\"Custom base uploaded\",\"Uploading\":\"Uploading custom base...\"},\"PlatformLibrary\":{\"Name\":{\"Altar\":\"Altar\",\"Arena\":\"Arena\",\"Beveled\":\"Beveled\",\"Braided\":\"Braided\",\"Cake\":\"Cake\",\"Carved\":\"Carved\",\"Cloud\":\"Cloud\",\"Coffer\":\"Coffer\",\"Column\":\"Column\",\"Concrete\":\"Concrete\",\"Coronation\":\"Coronation\",\"Cracked\":\"Cracked\",\"Elegant\":\"Elegant\",\"Forest\":\"Forest\",\"Gear\":\"Gear\",\"Golden\":\"Golden\",\"Grassy\":\"Grassy\",\"Gridstone\":\"Gridstone\",\"Hall\":\"Hall\",\"Heart\":\"Heart\",\"Ionic\":\"Ionic\",\"Lotus\":\"Lotus\",\"Magic\":\"Magic\",\"Merit\":\"Merit\",\"Ornate\":\"Ornate\",\"Patterned\":\"Patterned\",\"Paved\":\"Paved\",\"Pebble\":\"Pebble\",\"Pine\":\"Pine\",\"Round\":\"Round\",\"Ruined\":\"Ruined\",\"Rune\":\"Rune\",\"Simple\":\"Simple\",\"SolidWood\":\"Solid Wood\",\"Spiked\":\"Spiked\",\"Square\":\"Square\",\"Star\":\"Star\