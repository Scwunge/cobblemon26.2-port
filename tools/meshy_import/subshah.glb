ct\":{\"Dialog\":{\"ModelUpload\":\"Model Upload\"}},\"ErrorMessage\":{\"EmptyFile\":\"File is empty. Please check your file or try a different one.\",\"ModelUploadError\":\"Sorry, something went wrong during processing. We'll investigate the cause. Don't get discouraged, give another try!\",\"ModelUploadInvalidFormatError\":\"The input model is invalid. Please check your model or try a different one.\",\"ModelUploadNotSupportedError\":\"Sorry, we do not support this type of model at the moment. Please try a different one.\"},\"InfoMessage\":{\"ModelUploadCancel\":\"Model upload canceled\"},\"SuccessMessage\":{\"ModelUploaded\":\"Model uploaded successfully\"}},\"Community\":{\"Collect\":\"Collect\",\"Collections\":\"Collections\",\"Comment\":\"Comment\",\"Downloads\":\"Downloads\",\"FilterBy\":{\"Featured\":\"Featured\"},\"HowToPublish\":{\"Default\":\"How to Publish\",\"Tooltip\":{\"Description2\":\"After finishing a generation task, simply click the Share button in the 3D viewer, and you're ready to share your work with the community.\",\"Title1\":\"Get Featured, Earn {credits} Credits!\",\"Title2\":\"How to publish?\"}},\"Profile\":{\"Action\":{\"Follow\":\"Follow\"},\"Awards\":\"Awards\",\"Collections\":\"Collections\",\"CopyLink\":{\"Title\":\"Copy Link\",\"Toast\":\"Link to user profile copied\",\"Twitter\":\"X\"},\"Downloaded\":\"Downloaded\",\"Edit\":\"Edit Profile\",\"Featured\":\"Featured\",\"Follower\":\"Follower\",\"Followers\":\"Followers\",\"Following\":\"Following\",\"Followings\":\"Followings\",\"Joined\":\"Joined\",\"LearnMore\":\"Learn more\",\"MoreByUser\":\"More by @{user}\",\"NotDownloaded\":\"Not Downloaded\",\"NotPublished\":\"Not Published\",\"Published\":\"Published\",\"RecommendUser\":\"Recommend\",\"Remixes\":\"Remixes\",\"Status\":{\"Following\":\"Following\"},\"Unfollow\":{\"Description\":\"Clicking \\\"Confirm\\\" will unfollow {name}.\",\"Title\":\"Unfollow {name} ?\"},\"ViewMore\":\"View More\",\"Views\":\"Views\"},\"Publish\":\"Publish to Community\",\"RecommendedTags\":{\"GenerationChallenges\":\"Generation Challenges\",\"RecommendKeywords\":\"Recommend Keywords\",\"TrendingTags\":\"Trending Tags\"},\"Remixed\":\"Remixes\",\"SortBy\":{\"Collected\":\"Most Collected\",\"Collections\":\"Collections\",\"Creators\":\"Creators\",\"Downloaded\":\"Most Downloaded\",\"Featured\":\"Featured\",\"Following\":\"Following\",\"Models\":\"Models\",\"My\":\"My collections\",\"New\":\"Newest\",\"Popular\":\"Trending\",\"PopularCreators\":\"Popular Creators\",\"Printable\":\"3D Printable\",\"Reaction\":\"Top\",\"RecentlyAdded\":\"Recently Added\",\"Recommended\":\"Recommended\",\"RecommendedTooltip\":\"Interact with models you love, we'll find more like them.\",\"Subscribed\":\"Subscribed\"},\"Views\":\"Views\"},\"Discover\":{\"CommunityShowcase\":{\"Close\":\"Close\",\"Filter\":{\"Accessory\":\"Accessory\",\"All\":\"All\",\"Animal\":\"Animal\",\"Architecture\":\"Architecture\",\"Character\":\"Character\",\"Clothing\":\"Clothing\",\"Container\":\"Container\",\"Decoration\":\"Decoration\",\"Food\":\"Food\",\"Furniture\":\"Furniture\",\"MusicalInstrument\":\"Musical Instrument\",\"Nature\":\"Nature\",\"Toy\":\"Toy\",\"Transportation\":\"Transportation\",\"Unlabeled\":\"Unlabeled\",\"Weapon\":\"Weapon\"},\"MaterialMode\":\"Material\",\"Meshy3Workspace\":\"Legacy Workspace\",\"Report\":{\"Error\":\"Submission failed\",\"Placeholder\":\"What is the reason for your report?\",\"Submit\":\"Report\",\"Success\":\"Submission successful\",\"Title\":\"What is the reason for your report?\",\"Tooltip\":\"Report\"},\"Section\":{\"AITexturing\":\"AI Texturing\",\"Animate3DModel\":\"Animate\",\"Generate3dModels\":\"Generate\",\"ImageTo3d\":\"Image to 3D\",\"Meshy3AssetLibrary\":\"Legacy Assets\",\"TextTo3d\":\"Text to 3D\",\"TextToVoxel\":\"Text to Voxel\",\"Texturing3DModel\":\"Texture\"},\"ShowcaseCard\":{\"3DPrintable\":\"3D Printable\",\"Animate\":\"Animate\",\"CopyLink\":{\"Copied\":\"Copied!\",\"Default\":\"Copy Link\",\"SuccessMessage\":{\"LinkCopied\":\"Link to 3D viewer copied\"}},\"Like\":\"Like\",\"Liked\":\"Liked\",\"Likes\":{\"Plural\":\"likes\",\"Single\":\"like\"},\"Print\":\"Print\",\"Prompt\":{\"InputImage\":\"Image\",\"NegativePrompt\":{\"Placeholder\":\"No negative prompt\",\"Title\":\"Negative Prompt\"},\"Object\":{\"Placeholder\":\"No object prompt\",\"Title\":\"Prompt\"},\"Style\":{\"Placeholder\":\"No style prompt\",\"Title\":\"Style\"}},\"Remix\":\"Remix\",\"RemixDisabled\":\"User uploaded models cannot be remixed\",\"Retexture\":\"Retexture\",\"Rig\":\"Rig\",\"Try\":\"Try this\",\"Views\":{\"Plural\":\"views\",\"Single\":\"view\"}},\"SolidMode\":\"Solid\",\"Sort\":{\"Popular\":\"Popular\",\"Recent\":\"Recent\",\"Top\":\"Top\"},\"Title\":\"Community Showcase\"},\"ExampleFiles\":{\"ErrorMessage\":\"Failed to load example files\"},\"Following\":{\"Empty\":{\"Tips\":\"There aren't any showcases here yet. Start following our best artists for some inspiration!\"}}},\"EventCollections\":{\"Title\":\"Event Collections\"},\"Events\":{\"GoToEventPage\":\"Go to Event Page\"},\"OnBoardingChecklist\":{\"Congratulations\":\"Congrats! You’ve completed onboarding and earned the Pro Plan Explorer badge!\",\"Description\":\"Complete these onboarding tasks to earn \u003cbase\u003e300 free credits\u003c/base\u003e. And earn the \u003cbase\u003ePro Plan Explorer badge\u003c/base\u003e by completing all tasks!\",\"EarnFreeCredits\":\"Earn free credits\",\"EarnMoreFreeCredits\":\"Earn More Free Credits\",\"EarnMoreFreeCreditsDescription\":\"Explore more ways to earn free credits.\",\"ForFree\":{\"Congratulations\":{\"Line1\":\"Congratulations! You've successfully completed all onboarding tasks—you're off to a great start with Meshy AI!\",\"Line2\":\"Ready to unlock advanced features and elevate your workflow? Upgrade today and claim your exclusive discount!\"},\"Description\":\"Complete these onboarding tasks to earn \u003cbase\u003e100 free credits\u003c/base\u003e. And earn the \u003cbase\u003eOnboarding Conqueror\u003c/base\u003e badge by completing all tasks!\",\"Tasks\":{\"AnimateModel\":{\"Description\":\"\u003cbase\u003eRig\u003c/base\u003e and \u003cbase\u003eanimate\u003c/base\u003e your A-pose or T-pose humanoid model.\",\"Title\":\"Animate Model\"},\"ClickImageTo3DGenerate\":{\"Description\":\"Bring sketches or photos to life with \u003cbase\u003eImage to 3D\u003c/base\u003e.\",\"Title\":\"Image to 3D Magic\"},\"ClickTextureEditButton\":{\"Description\":\"Click \u003cbase\u003eTexture Edit\u003c/base\u003e to refine specific areas or heal noise.\",\"Title\":\"Try Texture Editing\"},\"ImprovePromptWithHelper\":{\"Description\":\"Use \u003cbase\u003eHelper\u003c/base\u003e in Text to 3D to improve your prompt.\",\"Title\":\"Craft a Better Prompt\"},\"SupportCommunity\":{\"Description\":\"\u003cbase\u003eLike, comment, collect,\u003c/base\u003e or \u003cbase\u003etip\u003c/base\u003e a published model.\",\"Title\":\"Support Community Creators\"}},\"Title\":\"Get Started on Your 3D Creation Journey\"},\"GetMoreRewards\":\"Get More Rewards\",\"GotIt\":\"Got it!\",\"Help\":\"Need help? Check out our \u003clink\u003eHelp Center\u003c/link\u003e for tips, tutorials, and everything you need to master Meshy.\",\"MoreFreeCredits\":\"More free credits\",\"SeeAll\":\"See All\",\"Tasks\":{\"Add3Animations\":{\"Description\":\"Click \u003cbase\u003eAnimation\u003c/base\u003e, rig your model, and add 3 animations.\",\"Title\":\"Add 3 animations\"},\"GenerateModelFromImage\":{\"Description\":\"Use \u003cbase\u003eText to Image\u003c/base\u003e, then turn the result into 3D.\",\"Title\":\"Generate 3D from an AI image\"},\"GenerateModelPrivateLicense\":{\"Description\":\"In \u003cbase\u003eText to 3D\u003c/base\u003e, select \u003cbase\u003ePrivate License\u003c/base\u003e — it's fully yours.\",\"Title\":\"Create a private-license model\"},\"RemeshModel\":{\"Description\":\"Click \u003cbase\u003eRemesh\u003c/base\u003e to adjust and optimize your model's polycount.\",\"Title\":\"Remesh your model\"},\"RetryTask\":{\"Description\":\"Not satisfied? Click \u003cbase\u003eFree Retry\u003c/base\u003e to regenerate — no extra credits.\",\"Title\":\"Try Free Retry\"},\"Submit3TasksInQueue\":{\"Description\":\"While one model generates, queue up two more.\",\"Title\":\"Queue 3 tasks at once\"}},\"Title\":\"Getting Started as a Pro Plan User\",\"UpgradePlans\":\"Upgrade Plans\",\"View\":\"View\"},\"Shared\":{\"AddTag\":\"Add Label\",\"Animation\":\"Animation\",\"ChangeLicense\":\"Change License\",\"Delete\":\"Delete\",\"Download\":\"Download\",\"Filter\":{\"Action\":{\"Reset\":\"Reset\"},\"AllSource\":\"All Source\",\"Alphabetical\":\"Alphabetical\",\"AnimationType\":{\"Title\":\"Animation Type\"},\"ArtStyleType\":{\"All\":\"All\",\"Title\":\"Art Style\"},\"ButtonLabel\":\"Filters\",\"DateCreated\":\"Date created\",\"ImageTo3D\":\"Image to 3D\",\"Label\":{\"Title\":\"My Labels\"},\"LastModified\":\"Last modified\",\"ModelSource\":{\"Title\":\"Model Source\",\"UploadModel\":\"Uploaded Model\"},\"Order\":{\"AToZ\":\"A - Z\",\"Ascending\":\"Ascending\",\"Default\":\"Order\",\"Descending\":\"Descending\",\"NewestFirst\":\"Newest First\",\"OldestFirst\":\"Oldest First\",\"ZToA\":\"Z - A\"},\"Others\":{\"Title\":\"Others\"},\"PBR\":{\"Title\":\"PBR Only\"},\"PolygonCount\":{\"Custom\":\"Custom\",\"Maximum\":\"Maximum:\",\"Minium\":\"Minium:\",\"Title\":\"Polygon Count\"},\"Popularity\":\"Popularity\",\"ShowcaseType\":{\"All\":\"All\",\"Animation\":\"Animation\",\"Static\":\"Static\",\"Title\":\"Animation\"},\"SortBy\":\"Sort by\",\"Status\":{\"Title\":\"Status\"},\"TextTo3D\":\"Text to 3D\",\"TextureSource\":{\"Title\":\"Texture Source\"},\"TimePeriod\":{\"AllTime\":\"All Time\",\"Day\":\"Day\",\"Month\":\"Month\",\"Title\":\"Time Period\",\"Week\":\"Week\",\"Year\":\"Year\"},\"Topology\":{\"Quad\":\"Quad\",\"Title\":\"Topology\",\"Triangle\":\"Triangle\"}}},\"Sidebar\":{\"AITexturing\":\"AI Texturing\",\"AITexturingDescription\":\"Generate textures from prompts or images\",\"API\":\"API\",\"Community\":\"Community\",\"ImageTo3d\":\"Image to 3D\",\"ImageTo3dDescription\":\"Generate 3D models from images\",\"ImageToVideo\":\"Image to Video\",\"ImageToVideoDescription\":\"Generate videos from images\",\"MyAssets\":\"My Assets\",\"Tag\":{\"New\":\"NEW\",\"NewModel\":\"NEW AI MODEL\"},\"TextTo3d\":\"Text to 3D\",\"TextTo3dDescription\":\"Generate 3D models from prompts\",\"TextToImage\":\"Text to Image\",\"TextToImageDescription\":\"Generate images from prompts\",\"ThreeDToImage\":\"3D to Image\",\"ThreeDToImageDescription\":\"Generate images from 3D scenes\",\"ThreeDToVideo\":\"Image to Video\",\"ThreeDToVideoDescription\":\"Generate videos from images\"},\"Tags\":{\"BulletCompatible\":\"Compatible with: Blender, Unity, Unreal Engine, Maya\",\"BulletFormats\":\"Formats: .STL, .OBJ, .FBX, .GLB…\",\"BulletLicense\":\"License: Free for Commercial Use\",\"BulletStyles\":\"Styles: Realistic, Low Poly, Stylized, Voxel\",\"CustomFooter\":\"Need something custom? Use Meshy's AI to create your own {tagName} 3D models from text or images — fast, free, and ready to use.\",\"Description\":\"Explore high-quality {tagName} 3D models with Meshy, including popular designs. Download free {tagName} 3D models in STL, 3MF, FBX, GLB, OBJ, and USDZ formats for 3D printing, game development, animation, AR/VR, and digital projects. Optimized for Blender, Unity, and Unreal Engine.\",\"DescriptionShort\":\"Explore high-quality {tagName} 3D models with Meshy. Download free in STL, 3MF, FBX, GLB, OBJ, and USDZ formats.\",\"FAQ\":{\"A1\":\"Yes, all {tag} 3D models generated on Meshy are available for free download. We provide high-quality AI-generated assets at no cost.\",\"A10\":\"This model comes as a static mesh in a standard T-pose or neutral pose, making it easy to auto-rig using tools like Mixamo, AccuRIG, or Blender's Rigify.\",\"A11\":\"Yes, the model features AI-generated automatic UV unwrapping, ensuring textures apply correctly without stretching.\",\"A12\":\"If this model isn't exactly what you need, you can use the Meshy AI Generator to create a custom {tag} from text or images in under a minute.\",\"A13\":\"Yes, the topology is clean enough for sculpting or editing in ZBrush or Blender if you need to modify details on the {tag}.\",\"A2\":\"Absolutely. The pre-made {tag} assets in our gallery are released under a CC0 (Creative Commons Zero) license — they are royalty-free and safe for commercial projects with no attribution required. Note: If you generate models yourself on a Free plan, those are licensed under CC BY 4.0, which allows commercial use but requires crediting Meshy.\",\"A3\":\"You can browse the gallery freely, and creating a free account gives you instant access to download .STL, .OBJ, and .FBX files for any {tag}.\",\"A4\":\"Downloads include standard industry formats: .STL (for 3D printing), .FBX (for Game Dev), .OBJ (universal), and .GLB/.USDZ (for AR/VR).\",\"A5\":\"Yes, the .FBX and .OBJ files are fully compatible with Blender, Unity, Unreal Engine, Maya, and Cinema 4D.\",\"A6\":\"Yes, the model includes PBR textures (Albedo, Normal, Roughness) embedded in the .GLB file or available as separate maps for the .OBJ version.\",\"A7\":\"Yes, select the .STL file option for a watertight mesh optimized for 3D printing on FDM or SLA printers (like Prusa or Anycubic).\",\"A8\":\"Depending on the pose, some {tag} models may require supports. We recommend using your slicer's (Cura/PrusaSlicer) auto-support feature for complex overhangs.\",\"A9\":\"Our AI generates optimized meshes. This {tag} is suitable for real-time rendering in games or mobile AR experiences due to its efficient topology.\",\"Q1\":\"Are these {tag} 3D models free to download?\",\"Q10\":\"Is this {tag} rigged for animation?\",\"Q11\":\"Are the UVs unwrapped for this {tag}?\",\"Q12\":\"Can I customize this {tag} 3D model?\",\"Q13\":\"Is the {tag} mesh editable?\",\"Q2\":\"Can I use these {tag} models commercially?\",\"Q3\":\"Do I need an account to download {tag} files?\",\"Q4\":\"What file formats are available for this {tag}?\",\"Q5\":\"Can I import this {tag} into Blender or Unity?\",\"Q6\":\"Does the {tag} model come with textures?\",\"Q7\":\"Is this {tag} model 3D printable?\",\"Q8\":\"Does this {tag} require support structures?\",\"Q9\":\"Is this {tag} 3D model low poly?\"},\"GenerateModels\":\"Download Now\",\"HotTags\":\"Hot Tags\",\"Share\":\"Share\",\"Title\":\"Free {tagName} 3D Models\"}},\"Discounts\":{\"EasterPromotion\":{\"Banner\":{\"AlreadyDrawn\":\"You've used all 3 draws. Check your rewards!\",\"Description\":\"Every draw wins — including a Free Yearly Plan, 50% OFF coupons, and bonus credits.\",\"DrawAvailable\":\"Draw available!\",\"DrawButton\":\"Draw My Lucky Egg\",\"DrawsLeft\":\"1 draw available today — 3 in total. Good luck!\",\"NoDraws\":\"You've used today's draw. Come back tomorrow for your next one!\",\"PrizeBronze\":\"100 Bonus Credits\",\"PrizeDiamond\":\"Free Pro Yearly Plan / Free Studio Yearly Plan\",\"PrizeGolden\":\"50% OFF Pro Yearly / Studio Yearly\",\"PrizePool\":\"PRIZE POOL\",\"PrizeSilver\":\"50% OFF Studio Monthly\",\"Redeemed\":\"You've already claimed your Easter reward!\",\"Title\":\"Lucky Egg Event: Win a Free Yearly Plan\"},\"Discount\":{\"BaseCoupon\":\"Easter Lucky Egg: Base Coupon\",\"Bronze\":\"Easter Lucky Egg: Bronze Egg\",\"Diamond\":\"Easter Lucky Egg: Diamond Egg\",\"Golden\":\"Easter Lucky Egg: Golden Egg\",\"Silver\":\"Easter Lucky Egg: Silver Egg\"},\"Header\":{\"DiamondProYearly\":\"🥚 Lucky Egg Event: FREE Yearly Plan!\",\"DiamondStudioYearly\":\"🥚 Lucky Egg Event: FREE Yearly Plan!\",\"GoldenStudioYearly\":\"🥚 Lucky Egg Event: 50% OFF Studio Yearly\",\"ProBimonthly\":\"🥚 Lucky Egg Event: 50% OFF First 2 Months\",\"ProQuarterly\":\"🥚 Lucky Egg Event: 50% OFF First 3 Months\",\"ProYearly\":\"🥚 Lucky Egg Event: 50% OFF Pro Yearly\",\"StudioMonthly\":\"🥚 Lucky Egg Event: 50% OFF First Month\",\"StudioYearly\":\"🥚 Lucky Egg Event: FREE Yearly Plan!\"},\"Reward\":{\"BaseCoupon\":\"50% OFF first billing period\",\"Bronze\":\"100 Bonus Credits\",\"DiamondPro\":\"FREE Pro Yearly Plan\",\"DiamondStudio\":\"FREE Studio Yearly Plan\",\"Golden\":\"50% OFF Pro Yearly\",\"Silver\":\"50% OFF Studio Monthly\"},\"Tooltip\":\"Available only for payments made via Stripe at this moment.\"},\"LotteryPromotion\":{\"Header\":{\"PremiumMonthly\":\"Premium Monthly {percent}% OFF\",\"PremiumQuarterly\":\"Premium Quarterly {percent}% OFF\",\"PremiumYearly\":\"⚡️ New User Offer: {percent}% OFF ⚡️\",\"ProMonthly\":\"Pro Monthly {percent}% OFF\",\"ProQuarterly\":\"Pro Quarterly {percent}% OFF\",\"ProYearly\":\"⚡️ New User Offer: {percent}% OFF ⚡️\",\"UltraMonthly\":\"Ultra Monthly {percent}% OFF\",\"UltraQuarterly\":\"Ultra Quarterly {percent}% OFF\",\"UltraYearly\":\"⚡️ New User Offer: {percent}% OFF ⚡️\"},\"Name\":{\"PremiumMonthly\":\"New User Offer: Premium Monthly {percent}% OFF Coupon\",\"PremiumQuarterly\":\"New User Offer: Premium Quarterly {percent}% OFF Coupon\",\"PremiumYearly\":\"New User Offer: Premium Yearly {percent}% OFF Coupon\",\"ProMonthly\":\"New User Offer: Pro Monthly {percent}% OFF Coupon\",\"ProQuarterly\":\"New User Offer: Pro Quarterly {percent}% OFF Coupon\",\"ProYearly\":\"New User Offer: Pro Yearly {percent}% OFF Coupon\",\"UltraMonthly\":\"New User Offer: Ultra Monthly {percent}% OFF Coupon\",\"UltraQuarterly\":\"New User Offer: Ultra Quarterly {percent}% OFF Coupon\",\"UltraYearly\":\"New User Offer: Ultra Yearly {percent}% OFF Coupon\"},\"Reward\":\"Welcome Gift · {percent}% OFF\",\"Tooltip\":\"Available only for payments made via Stripe at this moment.\"},\"SendToFriend\":{\"Add\":\"Add\",\"AddedEmails\":\"Added emails\",\"Cancel\":\"Cancel\",\"CopyLink\":\"Copy Link\",\"CopyLinkLabel\":\"Copy your invite link\",\"CopySuccess\":\"Link copied to clipboard\",\"DuplicateEmail\":\"This email has already been added\",\"EmailLabel\":\"Email\",\"EmailPlaceholder\":\"Email\",\"InvalidEmail\":\"Please enter a valid email address\",\"NoEmailsAdded\":\"Please add at least one email address\",\"SendFailed\":\"Failed to send invitations\",\"SendInvitation\":\"Send Invitation\",\"SendSuccess\":\"Invitations sent successfully\",\"Title\":\"Send to Friend\"},\"TexturingLaunchPromotion\":{\"Banner\":{\"ButtonText\":\"Explore Plans\",\"Description\":\"Experience the new texturing feature at half the price.\",\"EndsIn\":\"Ends in\",\"SeeDetails\":\"See details\",\"Title\":\"New Texturing Launch — 50% OFF Popular Plans\"},\"Header\":\"New Texturing Launch Special: 50% OFF\",\"Tooltip\":\"Available only for payments made via Stripe at this moment.\"}},\"Easter\":{\"Draw\":{\"ClaimReward\":\"Claim Reward\",\"Close\":\"Close\",\"Congratulations\":\"Congratulations!\",\"CreditsAdded\":\"100 credits have been added to your account!\",\"Description\":\"Tap the egg to reveal your prize!\",\"DrawAgain\":\"Draw Again\",\"Error\":\"Something went wrong. Please try again.\",\"OpenEgg\":\"Draw My Lucky Egg\",\"Prize\":{\"Description\":{\"bonus_credits_100\":\"100 Bonus Credits\",\"diamond\":\"Free Pro/Studio Yearly Plan!\",\"golden\":\"50% OFF Pro Yearly\",\"silver\":\"50% OFF Studio Monthly\"},\"bonus_credits_100\":\"Bronze Egg\",\"diamond\":\"Diamond Egg\",\"golden\":\"Golden Egg\",\"silver\":\"Silver Egg\"},\"PrizeWon\":\"You won a special Easter prize!\",\"PrizeWonWithName\":\"You won a {prizeName}!\",\"TapToOpen\":\"Tap to open egg\",\"Title\":\"Lucky Egg Draw\"},\"Prizes\":{\"Bronze\":{\"Description\":\"Extra credits for your creations\",\"Name\":\"100 Bonus Credits\"},\"Diamond\":{\"Description\":\"Pro or Studio Yearly — 100% OFF\",\"Name\":\"Free Yearly Plan\"},\"ProBimonthly\":{\"Description\":\"Get 50% off the Pro plan bimonthly subscription.\",\"Name\":\"50% OFF Pro Bimonthly\"},\"ProQuarterly\":{\"Description\":\"Get 50% off the Pro plan quarterly subscription.\",\"Name\":\"50% OFF Pro Quarterly\"},\"ProYearly\":{\"Description\":\"Get 50% off the Pro plan yearly subscription.\",\"Name\":\"50% OFF Pro Yearly\"},\"StudioMonthly\":{\"Description\":\"Get 50% off the first month of Studio plan.\",\"Name\":\"50% OFF Studio Monthly\"}},\"Rarity\":{\"common\":\"Common\",\"legendary\":\"Legendary\",\"rare\":\"Rare\"}},\"Error\":{\"ChatsLimitExceeded\":\"You’ve reached the 100 chat limit. Please delete one to start a new chat.\",\"ContentModerationFailed\":\"Content review did not pass.\",\"Forbidden\":\"Oops! It seems you’re not authorized to perform this operation.\",\"InternalError\":\"Server error. Please try again later.\",\"InvalidParameters\":\"Invalid request. Check your input and try again.\",\"InvalidSSODomain\":\"The domain provided doesn't look to be suitable for SSO.\",\"InvalidSSOURL\":\"Invalid SSO url.\",\"InvalidSSOXML\":\"Invalid SSO XML.\",\"LimitExceeded\":\"You are submitting too frequently. Please try again later.\",\"MalformedRequest\":\"Invalid comment format. Please check your input and try again.\",\"SSODomainDNSNotFound\":\"DNS verification failed. Please check your configuration and try again.\",\"SubscriptionScheduleNotSupportChange\":\"This action isn’t available for your current plan. Please contact support@meshy.ai if you need assistance.\"},\"EventBanner\":{\"Landing\":{\"Meshy4\":{\"Message\":\"We are live on Product Hunt now! Support us and get an exclusive 40% discount code. 🎉\"}}},\"Events\":{\"AroundTheWorld2025\":{\"Examples\":{\"Custom\":{\"Title\":\"Or, invent your own completely made-up culture!\"},\"Custom1\":{\"Description\":\"The Crystal Shrine of the deep-sea nomads \u003caccent\u003e\u003cb\u003e#AroundTheWorld#\u003c/b\u003e\u003c/accent\u003e\"},\"Custom2\":{\"Description\":\"The medicinal fruit of the celestial space monks \u003caccent\u003e\u003cb\u003e#AroundTheWorld#\u003c/b\u003e\u003c/accent\u003e\"},\"Custom3\":{\"Description\":\"The magical lost key to the fairy kings forest kingdom \u003caccent\u003e\u003cb\u003e#AroundTheWorld#\u003c/b\u003e\u003c/accent\u003e\"},\"Item1\":{\"Title\":\"Landmarks with a twist\"},\"Item2\":{\"Title\":\"Cultural fusion\"},\"Item3\":{\"Title\":\"Food meets architecture\"},\"Title\":\"Example Ideas\",\"View\":\"View Model\",\"item1\":{\"description\":\"\u003caccent\u003e\u003cb\u003e[Sydney]\u003c/b\u003e\u003c/accent\u003e The Sydney Opera House, with a swans head, in Japanese origami style, with Sakura Blossom texture \u003caccent\u003e\u003cb\u003e#AroundTheWorld#\u003c/b\u003e\u003c/accent\u003e\"},\"item2\":{\"description\":\"\u003caccent\u003e\u003cb\u003e[Mexico]\u003c/b\u003e\u003c/accent\u003e A cyberpunk robot head bust, with golden Aztec motifs that fuse with futuristic glowing circuit board details. Wearing a feathered headdress \u003caccent\u003e\u003cb\u003e#AroundTheWorld#\u003c/b\u003e\u003c/accent\u003e\"},\"item3\":{\"description\":\"\u003caccent\u003e\u003cb\u003e[Paris]\u003c/b\u003e\u003c/accent\u003e The Eifel tower made of ice cream, with a cherry on top \u003caccent\u003e\u003cb\u003e#AroundTheWorld#\u003c/b\u003e\u003c/accent\u003e\"}},\"HowTo\":{\"Step1\":\"Create a famous cultural landmark, building, food, or object — with your own unique or surreal twist. \u003caccent\u003e\u003cb\u003eInclude the tag #AroundTheWorld#\u003c/b\u003e\u003c/accent\u003e in your text prompt.\",\"Step2\":\"If you would like your creation pinned somewhere specific on the map, you can \u003caccent\u003e\u003cb\u003einclude a [location] tag\u003c/b\u003e\u003c/accent\u003e at the start of the prompt — for example: [Australia], [New York], [New Delhi]. This is optional.  If you don't use a location tag, we will select a map location for you.\",\"Step3\":\"\u003caccent\u003e\u003cb\u003ePublish your model\u003c/b\u003e\u003c/accent\u003e to the \u003caccent\u003e\u003cb\u003e\u003ca\u003eMeshy community\u003c/a\u003e\u003c/b\u003e\u003c/accent\u003e. We’ll carefully select our favorite community models to manually add to the map — and later, to a 3D Meshy Two-Year Anniversary Scene!\",\"Time\":\"The competition runs until \u003caccent\u003e\u003cb\u003eMay 5, 2025 at 23:59 UTC\u003c/b\u003e\u003c/accent\u003e.\",\"Time1_5\":\"Entries are now closed. Stay tuned for the winners announcement!\",\"Title\":\"How to Participate\"},\"Main\":{\"CelebrateButton\":\"📺  Celebrate with Video\",\"Description1\":\"\u003caccent\u003e\u003cb\u003eMeshy’s two-year anniversary\u003c/b\u003e\u003c/accent\u003e is coming up on \u003caccent\u003e\u003cb\u003eMay 4, 2025\u003c/b\u003e\u003c/accent\u003e — but we’re starting the celebrations early!\",\"Description1_2\":\"💖 This May, we celebrate \u003caccent\u003e\u003cb\u003etwo amazing years\u003c/b\u003e\u003c/accent\u003e of Meshy — and more importantly, \u003caccent\u003e\u003cb\u003eyou\u003c/b\u003e\u003c/accent\u003e.\",\"Description2\":\"Join us for a collaborative event celebrating the global creativity of the \u003caccent\u003e\u003cb\u003eMeshy community\u003c/b\u003e\u003c/accent\u003e.\",\"Description2_2\":\"💖 Thank you for your unique and imaginative submissions for the Meshy Around the World map.\",\"Description3\":\"\u003caccent\u003e\u003cb\u003eSubmit your creations\u003c/b\u003e\u003c/accent\u003e for the Meshy Around the World map and 3D collaborative scene, for a chance to \u003caccent\u003e\u003cb\u003ewin amazing prizes\u003c/b\u003e\u003c/accent\u003e!\",\"Description3_2\":\"💖 Together we created a globe-spanning collaborative showcase of surreal landmarks, fantastical foods, and cultural fusions!\",\"ExploreButton\":\"🏆  Explore Winning Entries\",\"MapButton\":\"View more creations\",\"MapDescription\":\"— and go on a Treasure Hunt Around the World!\",\"MapDescription1_5\":\"— there's still one last chance to lock in Max Unlimited!\",\"MapTitle\":\"Help fill the map with community creations\",\"MapTitle1_5\":\"The challenge has ended, but some treasure remains\",\"ShareButton\":\"Share\",\"ShareButton2\":\"Share the Map\",\"SubmitButton\":\"Submit Now\",\"Subtitle\":\"Two-Year Anniversary Challenge \",\"Subtitle2\":\"2-Year Anniversary Celebration\",\"Tag\":\"💰 Over $4000 in Prizes up for grabs!\",\"Title\":\"Meshy \u003cgradient\u003e#AroundTheWorld#\u003c/gradient\u003e\"},\"Rewards\":{\"Title\":\"Rewards\",\"item1\":{\"description\":\"Everyone who \u003caccent\u003e\u003cb\u003eparticipates\u003c/b\u003e\u003c/accent\u003e using the \u003caccent\u003e\u003cb\u003e#AroundTheWorld#\u003c/b\u003e\u003c/accent\u003e tag will automatically be awarded 100 credits.\",\"title\":\"100 credits\"},\"item2\":{\"description\":\"Free Meshy credit codes will be hidden across the map over time — including a \u003caccent\u003e\u003cb\u003e200-credit coupon\u003c/b\u003e\u003c/accent\u003e (one use per account) and 5x major prizes of 2,000 credits!\",\"title\":\"200,000+ Credit Treasure Hunt\"},\"item3\":{\"description\":\"Our top 3 favorite model creations will be awarded a grand prize of \u003caccent\u003e\u003cb\u003e1 year of the Meshy Max Unlimited\u003c/b\u003e\u003c/accent\u003e plan, valued at \u003caccent\u003e\u003cb\u003e$1,152 USD\u003c/b\u003e\u003c/accent\u003e per year.\",\"title\":\"Max Unlimited Plan\"},\"item4\":{\"description\":\"The next 3 favorite \u003caccent\u003e\u003cb\u003e#AroundTheWorld#\u003c/b\u003e\u003c/accent\u003e submissions will receive a \u003caccent\u003e\u003cb\u003e6-month Treats subscription\u003c/b\u003e\u003c/accent\u003e — a monthly delivery to your door of unique and delicious snacks from all over the world! Valued at approximately \u003caccent\u003e\u003cb\u003e$200 USD\u003c/b\u003e\u003c/accent\u003e.\",\"title\":\"6-month Treats\"}},\"Rules\":{\"Rule1\":{\"Item1\":\"Submit as many creations as you like from a wide variety of diverse cultures,  countries and time periods. Let’s fill the whole map together!\",\"Item2\":\"Avoid religious, sacred or controversial subjects.\",\"Item3\":\"Avoid mockery, negative stereotypes and insensitive humor.\",\"Item4\":\"Reimagine cultural elements with respect and thoughtfulness.\",\"Item5\":\"Don’t just recreate famous objects — remix and fuse them with your wildest ideas.\",\"Item6\":\"If you're unsure about anything, feel free to ask — we’re happy to help guide your creative choices.\",\"Title\":\"Challenge Guidelines\"},\"Rule2\":{\"Item1\":\"The competition runs until May 5, 2025 at 23:59 UTC, with the winners being announced in mid-May.\",\"Item2\":\"All submissions must follow the challenge guidelines and \u003ca\u003eMeshy Acceptable Use Policy\u003c/a\u003e.\",\"Item3\":\"Prizes are non-transferable and cannot be exchanged for cash, unless otherwise determined by Meshy due to shipping or availability limitations.\",\"Item4\":\"Manual credit and prize distribution will occur in mid to late May. For prizes that require shipping details, if a winner does not respond within 30 business days, their prize may be forfeited.\",\"Item5\":\"The competition is open to all registered Meshy users. Employees of Meshy and their immediate family members are not eligible for prizes.\",\"Item6\":\"Meshy reserves the right to amend these Terms \u0026 Conditions at any time.\",\"Title\":\"Event Terms \u0026 Conditions\"}},\"Thanks\":{\"Description1\":\"Whether you submitted \u003caccent\u003eone model or twenty\u003c/accent\u003e, whether you \u003caccent\u003efused landmarks\u003c/accent\u003e or \u003caccent\u003einvented entire cultures from scratch\u003c/accent\u003e — thank you for being part of our 2-year celebration.\",\"Description2\":\"💖 Meshy wouldn’t be Meshy without you 💖\",\"Description3\":\"🥂 Here’s to many more years of creativity, collaboration, and imagination! 🥂\",\"Title\":\"A Huge Thank You from the Meshy Team!\"},\"Unlimited\":{\"Description1\":\"To celebrate Meshy’s 2nd birthday, we’re giving you one last chance to lock in the \u003caccent2\u003e\u003cb\u003eMax Unlimited\u003c/b\u003e\u003c/accent2\u003e plan before it’s officially retired on \u003caccent2\u003e\u003cb\u003eMay 15 at 11:59 PM UTC\u003c/b\u003e\u003c/accent2\u003e.\",\"Description2\":\"Choose your plan and get a special discount — no code needed:\",\"Description3\":\"💗 \u003caccent2\u003e\u003cb\u003eMonthly Plan\u003c/b\u003e\u003c/accent2\u003e — Get \u003caccent2\u003e\u003cb\u003e$50 off\u003c/b\u003e\u003c/accent2\u003e your first month\\n💖 \u003caccent2\u003e\u003cb\u003eYearly Plan\u003c/b\u003e\u003c/accent2\u003e — Get \u003caccent2\u003e\u003cb\u003e$100 off\u003c/b\u003e\u003c/accent2\u003e in addition to the standard 20% yearly discount\",\"Description4\":\"The discount will be applied automatically at checkout.\",\"Description5\":\"After May 15, \u003caccent2\u003e\u003cb\u003eMax Unlimited will only be available to existing subscribers\u003c/b\u003e\u003c/accent2\u003e. Don’t miss your chance to grab our most powerful plan — before it’s gone for good.\",\"Title\":\"Meshy 2-Year Anniversary — Final Chance for Max Unlimited\"},\"Video\":{\"Description\":\"We’re also proud to unveil the \u003caccent\u003eMeshy Around the World 3D Anniversary Scene\u003c/accent\u003e — constructed with your community submitted #AroundTheWorld# Meshy Models.\",\"Thanks\":\"💗 Thank you to everyone who contributed! 💗\",\"Title\":\"Created Together from Every Corner of the World!\",\"VideoTitle\":\"📺 Watch the video below to see your creations come to life!\"},\"Winners\":{\"CreatedBy\":\"created by\",\"Description\":\"Your submissions blew us away. It wasn't easy narrowing it down, but we’re excited to announce the winners of the Meshy Around the World: 2-Year Anniversary Challenge!\",\"GrandPrize\":{\"Description\":\"\u003caccent\u003e1-Year\u003c/accent\u003e Meshy Max Unlimited\",\"Title\":\"Grand Prize Winners\"},\"RunnerUp\":{\"Description\":\"\u003caccent\u003e6-Month\u003c/accent\u003e Treats Box Subscription\",\"Title\":\"Runner-Up Winners\"},\"Title\":\"And the Winners Are...\"}}},\"Inbox\":{\"Empty\":\"You’re up to date 🎉\",\"ReadAllMessage\":\"Mark all messages as read\",\"ReadAllNotification\":\"Mark all notifications as read\"},\"Landing\":{\"3DModels\":{\"Description\":{\"Animation\":\"Download free 3d animation as glb, fbx, obj, usdz, stl, blend formats for games development, 3D printing, VR/AR and more.\",\"Default\":\"Download free 3D models as fbx, obj, glb, usdz, stl, blend formats for games, 3D printing, manufacturing, VR/AR and more. - Best AI 3D model\",\"Static\":\"Download free 3D models as fbx, obj, glb, usdz, stl, blend formats for games, 3D printing, manufacturing, VR/AR and more. - Generated by {author} with Meshy AI - Best AI 3D model generator\"},\"NotFound\":{\"Button\":\"Return Home\",\"Description\":\"This model may have been removed by the creator and is no longer available.\",\"Title\":\"Oops, this model is not found!\"},\"Title\":{\"Animation\":\"\\\"{prompt}\\\" - Download free 3D animation generated with Meshy AI by @{author}\",\"Default\":\"Download free 3D models generated with Meshy AI - Best AI 3D model generator\",\"Static\":\"\\\"{prompt}\\\" - Download free 3D models generated with Meshy AI by @{author}\"}},\"3dTools\":{\"Breadcrumb\":{\"Home\":\"Home\",\"Tool\":\"3D Tools\"},\"BrickPartsGenerator\":{\"Breadcrumb\":{\"BrickPartsGenerator\":\"AI Brick Parts Generator\"},\"Comparison\":{\"Cells\":{\"PhotoOnly\":\"Photo only\"},\"Columns\":{\"CreativeGen\":{\"Title\":\"Creative generators\"},\"DesignTool\":{\"Title\":\"Design-only software\"},\"Marketplace\":{\"Title\":\"Buying second-hand\"},\"Meshy\":{\"Title\":\"Meshy\"}},\"Description\":\"Marketplaces run out of the parts you need, design tools can't hand you a finished model, and creative generators chase fun over fit. Meshy is built for functional, print-ready, brick-compatible parts.\",\"Footnote\":\"Tools shown are typical of each category; exact capabilities vary by product.\",\"Heading\":\"Why Choose Meshy's AI Brick Part Generator\",\"Rows\":{\"CustomParts\":\"Custom or non-existent parts\",\"Fast\":\"Ready in minutes\",\"Free\":\"Free to start\",\"FromInput\":\"Generate from a prompt or photo\",\"MeshExport\":\"Print-ready mesh export\",\"NoSkill\":\"No modeling skill required\"}},\"Cta\":{\"Button\":\"Generate a Brick Part\",\"Description\":\"Describe the part you need and download a print-ready, stud-compatible model in minutes. The first few generations are free.\",\"Title\":\"Can't Find the Part? Generate It.\"},\"Description\":\"Generate custom, brick-compatible parts with AI. Design functional pieces like hinges, Technic beams and gears, then download a print-ready STL.\",\"Faq\":{\"Heading\":\"Frequently Asked Questions\",\"Q1\":{\"Answer\":\"Yes. Every part is generated to brick-compatible dimensions, so the studs and anti-stud tubes line up with the standard building-block spacing used by mainstream brick systems. Because the geometry follows the common stud pitch, plates, tiles, and connectors snap onto bricks already in your collection. You can \u003cgen\u003egenerate a part\u003c/gen\u003e and fine-tune its tolerances before exporting to match how your printer lays down plastic.\",\"Question\":\"Are the generated parts compatible with standard bricks?\"},\"Q2\":{\"Answer\":\"Parts are designed around the common brick stud pitch and clutch tolerances, so clips, pins, and Technic-style holes are sized to grip like injection-molded pieces. Real-world fit still depends on your printer, filament, and slicer settings, since every machine extrudes a little differently. We recommend printing a small test piece first and adjusting the tolerance up or down until the connection feels right. Once you find that offset, it carries over to every part you generate.\",\"Question\":\"How accurate is the fit for clips and Technic connections?\"},\"Q3\":{\"Answer\":\"PLA and PETG both work well for functional brick-compatible parts. PETG is the better choice for hinges, clips, and connectors that flex or bear load, because it is tougher and more fatigue-resistant. PLA prints easily and holds crisp detail, which makes it ideal for static plates, tiles, and decorative pieces. For parts that snap on and off repeatedly, a higher infill and three to four perimeters will noticeably improve durability.\",\"Question\":\"Which materials should I print with?\"},\"Q4\":{\"Answer\":\"Meshy generates original, custom parts from your own description or reference image, not copies of any brand's catalog. It is meant for designing your own functional, enhanced, or replacement pieces that work alongside bricks you already own. We avoid brand names and trademarked designs, which is why everything here is described as brick-compatible rather than tied to any company. As with any 3D model, you are responsible for how you choose to use the parts you generate.\",\"Question\":\"Is this allowed — what about trademarks?\"},\"Q5\":{\"Answer\":\"You can export every part as a print-ready STL or 3MF and drop it straight into any slicer, such as Cura, PrusaSlicer, or Bambu Studio. STL is the universal option and works almost everywhere, while 3MF preserves extra metadata like units and color. OBJ and GLB are available too if you want to keep editing the mesh in other 3D software first. See our \u003cprintGuide\u003e3D print file type guide\u003c/printGuide\u003e for help choosing the right format.\",\"Question\":\"What file formats can I download?\"},\"Q6\":{\"Answer\":\"Yes. You can start generating brick-compatible parts for free, with no software to install and nothing to configure. The free tier is enough to design and print your first parts, and you keep every file you export. When you need more generations, higher resolution, or a commercial license, see our \u003cpricing\u003epricing plans\u003c/pricing\u003e.\",\"Question\":\"Is it free to use?\"}},\"Gallery\":{\"Categories\":{\"All\":\"All\",\"Custom\":\"Custom\",\"Gears\":\"Gears\",\"Hinges\":\"Hinges\",\"Plates\":\"Plates\",\"Technic\":\"Technic\"},\"Description\":\"Functional, brick-compatible parts generated and printed by the community. Filter by part type.\",\"Heading\":\"Printed Brick-Compatible Parts\",\"Items\":{\"Bracket\":{\"Description\":\"An angled Technic bracket for sturdy frame connections.\",\"Title\":\"Technic angle bracket\"},\"Connector\":{\"Description\":\"A custom connector bridging two incompatible part systems.\",\"Title\":\"Custom connector\"},\"Custom\":{\"Description\":\"A bespoke enhanced part designed for a specific MOC build.\",\"Title\":\"Custom enhanced part\"},\"Gear\":{\"Description\":\"A printable gear sized to mesh with standard Technic gearing.\",\"Title\":\"Compatible gear\"},\"Hinge\":{\"Description\":\"A 2x4 hinge plate with a smooth, durable pivot.\",\"Title\":\"Hinge plate\"},\"Plate\":{\"Description\":\"A flat building plate with precise stud spacing.\",\"Title\":\"Building plate\"},\"TechnicBeam\":{\"Description\":\"A Technic beam with evenly spaced pin holes.\",\"Title\":\"Technic beam\"},\"Wheel\":{\"Description\":\"A custom wheel hub built to fit standard axles.\",\"Title\":\"Wheel hub\"}}},\"Hero\":{\"Eyebrow\":\"AI Brick Parts Generator\",\"PrimaryCta\":\"Generate a Brick Part\",\"SecondaryCta\":\"Generate a Brick Figure\",\"Subtitle\":\"Can't find the part? Generate it. Describe or upload an image of a brick-compatible piece like hinges, technic beams, or gears, then download a print-ready STL. Free to start.\",\"TitleAccent\":\"Brick-Compatible Parts\",\"TitleLead\":\"Generate Custom\"},\"HowItWorks\":{\"Cta\":\"Start Generating\",\"Heading\":\"How to Generate Brick Parts with AI\",\"Step1\":{\"Description\":\"Describe the brick-compatible part you need in plain language, including size, studs and holes, or upload a photo or sketch to generate from.\",\"ImageAlt\":\"Typing a text prompt describing a brick-compatible hinge part\",\"Title\":\"Describe or upload your part\"},\"Step2\":{\"Description\":\"Meshy turns it into a textured, stud-compatible 3D model in about a minute. Re-texture, remesh, and fine-tune tolerances and dimensions until the fit is right.\",\"ImageAlt\":\"AI-generated 3D model of a brick-compatible part with adjustable tolerances\",\"Title\":\"Generate \u0026 refine\"},\"Step3\":{\"Description\":\"Export a print-ready STL or 3MF, drop it into your slicer, and print the part on any FDM or resin 3D printer.\",\"ImageAlt\":\"Print-ready STL of a brick-compatible part being prepared for 3D printing\",\"Title\":\"Download STL \u0026 print\"}},\"LastUpdatedLabel\":\"Last updated\",\"Meta\":{\"Description\":\"Free AI brick parts generator. Describe and create custom, brick-compatible parts — hinges, Technic beams, gears — then download a print-ready STL for 3D printing.\",\"Title\":\"AI Brick Parts Generator — Custom Brick-Compatible Parts | Meshy\"},\"Parts\":{\"Custom\":{\"Cta\":\"Generate Custom\",\"Description\":\"Bespoke enhanced parts and adapters that don't exist off the shelf.\",\"Example\":\"e.g. A custom adapter that bridges brick studs on one end and a Technic-style pin-and-axle fitting on the other.\",\"Title\":\"Custom parts\"},\"Description\":\"Generate the functional, brick-compatible parts that are hardest to find and most expensive to buy.\",\"Gears\":{\"Cta\":\"Generate Gear\",\"Description\":\"Printable gears and wheels sized to mesh with standard gearing.\",\"Example\":\"e.g. A brick-compatible spur gear with evenly spaced teeth around the rim and a cross-shaped axle hole in the center.\",\"Title\":\"Gears \u0026 wheels\"},\"Heading\":\"Generate Any Brick-Compatible Part\",\"Hinges\":{\"Cta\":\"Generate Hinge\",\"Description\":\"Hinges and pivots — the parts most likely to be missing or overpriced.\",\"Example\":\"e.g. A brick-compatible 2x4 hinge plate: two flat stud plates joined by a smooth folding pivot, round studs on top.\",\"Title\":\"Hinges \u0026 joints\"},\"Plates\":{\"Cta\":\"Generate Plate\",\"Description\":\"Plates and brackets with precise stud spacing for clean builds.\",\"Example\":\"e.g. A flat brick-compatible building plate, 6x8, with a precise grid of round studs on top and hollow anti-stud tubes underneath.\",\"Title\":\"Plates\"},\"Technic\":{\"Cta\":\"Generate Beam\",\"Description\":\"Technic beams, pins and connectors with accurate hole spacing.\",\"Example\":\"e.g. A Technic-style studless beam, 1x7, with a row of evenly spaced round pin holes through the side and rounded ends.\",\"Title\":\"Technic parts\"}},\"RelatedTools\":{\"Cta\":\"Convert Now\",\"Heading\":\"Related Tools\"},\"SocialProof\":{\"Title\":\"Trusted by\"},\"Title\":\"AI Brick Parts Generator\"},\"CharacterGenerator\":{\"AIComparison\":{\"AiImageHeader\":\"Typical AI 3D image tools\",\"CapabilityHeader\":\"Capability\",\"Description\":\"See how a real Meshy 3D character stacks up against a flat, AI-generated image.\",\"Footnote\":\"Comparison is against AI tools that output 2D images styled to look 3D. Other AI 3D mesh generators may match some rows.\",\"MeshyHeader\":\"Meshy 3D Character Generator\",\"Row1\":\"Rotate 360° / true geometry\",\"Row1Ai\":\"Flat render\",\"Row1Meshy\":\"Real mesh\",\"Row2\":\"Auto-rigging\",\"Row2Ai\":\"Not supported\",\"Row2Meshy\":\"Humanoid \u0026 quadruped\",\"Row3\":\"Animate\",\"Row3Ai\":\"Not supported\",\"Row3Meshy\":\"Built-in animation library\",\"Row4\":\"Export FBX / GLB / OBJ\",\"Row4Ai\":\"Not supported\",\"Row4Meshy\":\"Yes\",\"Row5\":\"Drop into Unity / Unreal / Blender\",\"Row5Ai\":\"Not supported\",\"Row5Meshy\":\"Yes\",\"Row6\":\"Commercial use\",\"Row6Ai\":\"Varies\",\"Row6Meshy\":\"Yes, see license\",\"Row7\":\"Split into printable parts\",\"Row7Meshy\":\"Auto Split in 40s\",\"Rows\":{\"Animation\":{\"Ai\":\"No skeletal animation\",\"Label\":\"Animation\",\"Meshy\":\"Built-in animation library\"},\"Commercial\":{\"Ai\":\"Varies\",\"Label\":\"Commercial use\",\"Meshy\":\"Yes, see license\"},\"Consistency\":{\"Ai\":\"Varies each generation\",\"Label\":\"Consistency across angles\",\"Meshy\":\"Same character from every angle\"},\"Export\":{\"Ai\":\"PNG / JPG only\",\"Label\":\"Export FBX / GLB / OBJ\",\"Meshy\":\"Drops into Unity, Unreal, Blender\"},\"Geometry\":{\"Ai\":\"Flat render, one view\",\"Label\":\"Rotate 360° / true geometry\",\"Meshy\":\"Real mesh, viewable from any angle\"},\"Pbr\":{\"Ai\":\"Lighting baked in\",\"Label\":\"PBR textures\",\"Meshy\":\"Separate PBR maps, relightable\"},\"Repose\":{\"Ai\":\"Regenerate from scratch\",\"Label\":\"Re-pose and edit\",\"Meshy\":\"Edit mesh, retexture, re-pose\"},\"Rigging\":{\"Ai\":\"No skeleton\",\"Label\":\"Auto-rigging\",\"Meshy\":\"Humanoid and quadruped\"},\"Split\":{\"Ai\":\"Not available\",\"Label\":\"Split into printable parts\",\"Meshy\":\"Auto Split in 40s\"}},\"Title\":\"Why choose Meshy 3D character generator\"},\"AIShowcase\":{\"Badge\":\"AI\",\"Categories\":{\"All\":\"All\",\"Creatures\":\"Creatures\",\"Humanoid\":\"Humanoid\"},\"Description\":\"Turn a text prompt or reference image into a fully textured, rigged 3D character. As a 3D character creator, Meshy exports straight to Unity, Unreal, and Blender.\",\"Eyebrow\":\"AI in Workspace\",\"PrimaryCta\":\"Create My 3D Character\",\"TileAriaLabel\":\"{name} by @{author}: open in the Meshy 3D viewer\",\"Title\":\"Real 3D character models\"},\"AdobeComparison\":{\"Description\":\"Adobe's 3D tools are powerful but require a paid Creative Cloud subscription and a desktop install, and their 3D output is a rendered image or video, not a mesh file. Meshy runs free in your browser and exports a real 3D mesh.\",\"Features\":{\"animation\":\"Animation built in\",\"fastResult\":\"Result in seconds\",\"free\":\"Free to use\",\"meshExport\":\"Real 3D mesh export\",\"noInstall\":\"Browser-only, no install\"},\"Footnote\":\"Adobe, Photoshop, Illustrator and After Effects are trademarks of Adobe Inc. Comparison reflects each app's documented 3D output capability: Illustrator's 3D and Materials effect renders to the 2D artboard, and After Effects 3D layers render to video frames. Neither path exports a GLB, OBJ or STL mesh file.\",\"Title\":\"Meshy 3D character at a glance vs Adobe Creative Cloud tools\"},\"AiEnhance\":{\"Label\":\"Create My 3D Character\"},\"AnimationLibrary\":{\"Description\":\"Auto-rig any anime or stylized character, then apply ready-made motions like walk, run, combat and idle. No external animation software needed.\",\"Title\":\"Animate your anime 3D characters\"},\"Breadcrumb\":{\"CharacterGenerator\":\"3D Character Generator\"},\"CameraPresets\":{\"Front\":\"Front\",\"Label\":\"Camera\",\"ThreeQuarter\":\"3/4\",\"Top\":\"Top\"},\"Cta\":{\"Description\":\"Free to start, no credit card, no software to install.\",\"Title\":\"Create your 3D character now\"},\"Environment\":{\"IntensityLabel\":\"Intensity\",\"LightingLabel\":\"Lighting\",\"Preset\":{\"Cozy\":\"Cozy\",\"Daylight\":\"Daylight\",\"Outdoor\":\"Outdoor\",\"Studio\":\"Studio\",\"Sunset\":\"Sunset\"},\"ShowBackground\":\"Show background\"},\"Export\":{\"ChooseFormat\":\"Choose format\",\"Download\":\"Download\",\"GlbCaption\":\"Unity, Unreal, Roblox Studio\",\"ImageGroup\":\"Image\",\"MeshExportNote\":\"What you see uses bloom and HDRI lighting that won't be saved in the file.\",\"ModelGroup\":\"3D Model\",\"ObjCaption\":\"Blender, Cinema 4D, all 3D apps\",\"PngCaption\":\"Thumbnails \u0026 social\",\"PngPillTemplate\":\"PNG · {size}\",\"PrintGroup\":\"3D Print\",\"Size\":{\"HdShort\":\"HD\",\"SquareHdShort\":\"2K\",\"X1Short\":\"1×\",\"X2Short\":\"2×\"},\"SizeLabel\":\"Export size\",\"SizeOption\":{\"Hd\":\"HD (1920×1080)\",\"SquareHd\":\"Square HD (2048×2048)\",\"X1\":\"1× (480×480)\",\"X2\":\"2× (960×960)\"},\"StlCaption\":\"3D printers (no color)\",\"Working\":\"Rendering…\"},\"FAQs\":{\"Answer1\":\"Describe your character in a text prompt covering species, outfit, art style and pose, or upload a reference photo, concept art or sketch. Meshy's text-to-3D and image-to-3D engine turns it into a real 3D mesh with a free auto-rotating browser preview, then Meshy Workspace generates the fully rigged, textured, production-ready model you can export.\",\"Answer10\":\"Yes. Upload a concept sketch, photo or reference render and Meshy's image-to-3D AI reads its shapes and materials to build a true 3D character mesh with matching textures, with no manual modeling. Clean, well-lit references with a clear single subject convert best. Once generated, you can auto-rig, animate and export the character.\",\"Answer11\":\"Yes. Characters you create with Meshy are free to use for commercial and personal projects, including games, films, apps, 3D prints and client work, and exports carry no watermark. Commercial rights depend on the plan you generate on, so always review the current license terms for your plan before shipping assets in a paid product.\",\"Answer12\":\"Hiring an artist gives bespoke results but costs more and takes longer. An AI 3D character generator like Meshy produces a rigged, textured character in minutes, free to start, ideal for prototyping, iteration and concept validation. Many teams explore directions with Meshy first, then bring in an artist only for fully custom work.\",\"Answer13\":\"Yes. Meshy characters export as rigged, textured meshes that drop straight into Unity and Unreal, so you can prototype NPCs, enemies and player characters fast. For a shipping title you may still retopologize or optimize the mesh for your poly budget, but the generated character gives you a complete, animated starting point instead of a blank scene.\",\"Answer14\":\"No. Meshy is built for creators with no 3D modeling, rigging or sculpting experience. You describe a character or upload an image and the AI handles the mesh, textures and skeleton. Game developers, animators, students and hobbyists all use it to skip the manual pipeline and get an editable 3D character to build on.\",\"Answer15\":\"Yes. If the first result is not right, refine your text prompt or swap the reference image and regenerate. Because Meshy exports a standard FBX, GLB or OBJ mesh, you can also open the character in Blender, Maya or your DCC of choice to tweak geometry, retopologize, repaint textures or adjust the rig before using it.\",\"Answer16\":\"An AI 3D character generator is a tool that turns a text prompt or reference image into a real 3D character model, a true mesh you can rotate, rig and animate, not a flat picture. Meshy builds the geometry and PBR textures, adds a skeleton automatically, and exports FBX, GLB, OBJ or STL for game engines and 3D printing.\",\"Answer2\":\"Yes. Previewing your character in 3D is free in your browser with no login. To generate and export the full rigged model (FBX, GLB, OBJ or STL with no watermark), continue in Meshy Workspace, which comes with free trial credits and no credit card required. Paid plans add more credits and higher limits for heavier use.\",\"Answer3\":\"The in-browser 3D preview appears in seconds the moment you upload or describe a character. Generating the full rigged, textured character in Meshy Workspace usually takes a minute or two, with no render queue and no manual modeling. Auto-rigging and applying an animation add only a few more minutes, so most characters are export-ready within minutes.\",\"Answer4\":\"Yes. Meshy is tuned for anime and stylized characters, with sharp silhouettes, expressive proportions and big eyes. Describe the style in your prompt (for example, “anime swordsman with big eyes”) or upload stylized reference art, and you get a real 3D character mesh you can rig, animate and export for games, animation and indie projects.\",\"Answer5\":\"Yes. Describe the style in your prompt, such as cartoon, low-poly, chibi, realistic and more, and Meshy generates a matching 3D character. Each result is a true mesh you can auto-rig, animate and export, so it works for game prototypes, stylized assets and collectibles. The clearer your style cue, the closer the generated character.\",\"Answer6\":\"Yes. Meshy auto-rigs humanoid and quadruped characters with a skeleton, with no manual bone placement or weight painting. The rigged character is animation-ready, so you can apply built-in motion presets like walk, run, idle and attack, or animate it yourself in Blender, Unity or Unreal. Auto-rigging turns a static AI mesh into a posable, game-ready character in minutes.\",\"Answer7\":\"Export your character from Meshy Workspace as animated FBX or GLB for real-time engines, OBJ for any 3D app, or STL for 3D printing. FBX and GLB carry the rig and animations, OBJ is geometry plus textures, and STL is print-ready geometry only. Choose GLB for web and real-time engines, FBX for animation pipelines.\",\"Answer8\":\"Yes. Export as FBX or GLB and your rigged, animated character drops straight into Unity, Unreal Engine, Blender, Godot and Roblox Studio, with the skeleton and animations intact and no conversion step. The mesh arrives game-engine ready, so you can drop it into a scene and start building right away.\",\"Answer9\":\"Yes. Export STL or OBJ from Meshy Workspace and print your character as a figurine, collectible or mini on most consumer 3D printers and slicers. STL carries geometry only, so for full-color prints choose a format your printer supports. For dynamic poses, pose the character before exporting it for print.\",\"Question1\":\"How do I make a 3D character with AI?\",\"Question10\":\"Can I turn a 2D image or concept art into a 3D character?\",\"Question11\":\"Can I use the 3D characters commercially?\",\"Question12\":\"AI 3D character generator vs hiring a 3D artist: which should I choose?\",\"Question13\":\"Are AI-generated 3D characters game-ready?\",\"Question14\":\"Do I need 3D modeling experience to use Meshy?\",\"Question15\":\"Can I edit or refine the character after generating it?\",\"Question16\":\"What is an AI 3D character generator?\",\"Question2\":\"Can I create a 3D character for free?\",\"Question3\":\"How long does it take to generate a 3D character with AI?\",\"Question4\":\"Can I make an anime 3D character?\",\"Question5\":\"Can I make a cartoon, low-poly or chibi 3D character?\",\"Question6\":\"Are the 3D characters rigged and animation-ready?\",\"Question7\":\"What file formats can I export my 3D character in?\",\"Question8\":\"Can I use my 3D character in Unity, Unreal, Blender or Godot?\",\"Question9\":\"Can I 3D print my character?\"},\"Features\":{\"Feature1\":{\"Description\":\"Export your character from Meshy Workspace as animated FBX or GLB for Unity, Unreal, Blender and Godot, OBJ for any 3D app, or STL for 3D printing. The mesh arrives game-engine ready, with no conversion step.\",\"Title\":\"Export your 3D character to FBX, GLB, OBJ or STL\"},\"Feature2\":{\"Description\":\"Describe your character in plain language or upload a concept sketch, photo or reference render. Meshy's AI turns either one into a real 3D character, with no manual modeling or sculpting required.\",\"Title\":\"Text to 3D and image to 3D in one generator\"},\"Feature3\":{\"Description\":\"A professional character generator for students, indie developers and studios alike. Start free with no login, then generate the full rigged, textured model in Meshy Workspace with free trial credits and no watermark.\",\"Title\":\"Free AI 3D character generator for every creator\"},\"Feature4\":{\"Description\":\"Every character is rigged with a humanoid or quadruped skeleton and works with the built-in animation library, including walk, run, idle and more, so it is ready to pose and export in minutes, not days.\",\"Title\":\"Auto-rigged and animation-ready\"},\"Feature5\":{\"Description\":\"Trusted by millions of creators, Meshy's text-to-3D and image-to-3D AI turns your prompt or image into a fully textured, game-engine-ready 3D character.\",\"Title\":\"Powered by Meshy's AI 3D pipeline\"}},\"Header\":{\"Description\":\"Meshy's AI 3D character generator turns a text prompt or reference image into a rigged, animation-ready 3D model. Create 3D characters you can export to Unity, Unreal, and Blender.\",\"Title\":\"AI 3D Character Generator\"},\"Hero\":{\"CtaImage\":\"Create from image\",\"CtaText\":\"Create from text\",\"Eyebrow\":\"AI 3D Character Generator\",\"TitleAccent\":\"Generator\",\"TitleLead\":\"AI 3D Character\"},\"HowTo\":{\"Step1\":{\"Description\":\"Type a text prompt covering pose, costume, props and style, or upload a concept sketch, photo or reference image.\",\"Title\":\"Describe or upload your character\"},\"Step2\":{\"Description\":\"See an auto-rotating 3D preview spin in your browser, instantly, with no render queue.\",\"Title\":\"Preview your character in 3D\"},\"Step3\":{\"Description\":\"Open your character in Meshy Workspace and let the AI generate a rigged, fully textured 3D model, then export FBX, GLB, OBJ or STL for Unity, Unreal, Blender and Godot. Free trial credits, no card required.\",\"Title\":\"Generate and export with AI in Workspace\"},\"Title\":\"How to Make a 3D Character with AI in 3 Steps\"},\"Material\":{\"Category\":{\"Fabric\":\"Fabric\",\"Natural\":\"Natural\",\"Reflective\":\"Reflective\"},\"ColorLabel\":\"Color\",\"Customize\":{\"Label\":\"Customize PBR\"},\"GlowIntensityLabel\":\"Intensity\",\"GlowLabel\":\"Glow\",\"Preset\":{\"Balloon\":\"Balloon\",\"Cactus\":\"Cactus\",\"DiscoGlitter\":\"Disco Glitter\",\"Floral\":\"Floral\",\"Gem\":\"Gem\",\"LiquidGlass\":\"Liquid Glass\",\"Marble\":\"Marble\",\"Moss\":\"Moss\",\"PinkVelvet\":\"Pink Velvet\",\"Rainbow\":\"Rainbow\",\"WetGlass\":\"Wet Glass\",\"Wood\":\"Wood\"},\"Type\":{\"Clay\":\"Clay\",\"Custom\":\"Custom\",\"Glass\":\"Glass\",\"Metallic\":\"Metallic\",\"Plastic\":\"Plastic\",\"RoughGlass\":\"Rough Glass\"}},\"MetaDescription\":\"Generate a real, riggable 3D character from text or an image with Meshy's AI. Export FBX, GLB \u0026 OBJ to Unity, Unreal \u0026 Blender. Try it free.\",\"MetaTitle\":\"AI 3D Character Generator — Text or Image to 3D Model | Meshy\",\"Pipeline\":{\"Card1Description\":\"Auto-rig humanoid and quadruped characters and apply built-in motion presets, with no manual bone setup.\",\"Card1Title\":\"Auto-rigging \u0026 animation\",\"Card2Description\":\"Ge